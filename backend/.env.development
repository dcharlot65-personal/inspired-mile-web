# Development environment variables for running outside Docker
# Copy to .env: cp .env.development .env

DATABASE_URL=postgres://inspired_mile:devpassword@localhost:5432/inspired_mile
PORT=3849
CORS_ORIGIN=http://localhost:4321

# Passkeys on the local dev server.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:4321

# Sessions are signed with JWT_SECRET. The server refuses to start without one of at least
# 32 bytes. For local development either set your own:
#   JWT_SECRET=<output of: openssl rand -base64 48>
# or leave it unset and keep the flag below: a random secret is then made at every start
# (you are signed out whenever the API restarts). The flag is refused on an https origin,
# so it cannot be carried into production by accident. There is no default secret.
DEV_INSECURE_JWT_SECRET=1

# Email sign-in is off until RESEND_API_KEY is set. For local testing only, this writes
# the codes to the API's stderr instead of sending them:
# DEV_EMAIL_LOG=1

# AI battle judging (optional)
LLM_API_KEY=
LLM_API_URL=https://api.anthropic.com/v1/messages
