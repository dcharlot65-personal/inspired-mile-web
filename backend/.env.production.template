# Inspired Mile API: production environment
# Copy to .env beside the binary (~/sites/inspired-mile-api/.env on prod).
# Never commit the actual .env file: it contains secrets.

# sqlx needs an explicit user.
DATABASE_URL=postgres://<user>@localhost/inspired_mile

# REQUIRED. Signs every session. The server will not start if this is missing, shorter than
# 32 bytes, this placeholder, or the old development constant. Generate it once and keep it:
# changing it signs everyone out.
JWT_SECRET=<run: openssl rand -base64 48>

PORT=3849
CORS_ORIGIN=https://sonnetman.inspiredmile.com

# Reverse proxies whose CF-Connecting-IP / X-Forwarded-For are believed, as the API sees
# them on the socket (addresses or CIDR networks, comma-separated). From any other peer the
# headers are ignored and the socket address is the client. The default is
#   127.0.0.1,::1,10.10.10.1,100.64.224.0,100.98.101.113
# 100.98.101.113 is the Tailscale address of the MacBook Pro M4 (10.10.10.1) whose Caddy
# fronts the site and reaches this API over the tailnet: the peer production sees. Leave this
# unset to use the default. Whatever RUST_LOG says, the API writes at start-up which peers it
# trusts ("TRUSTED_PROXIES: ... believed only from ...") and, at most once every ten minutes
# per peer, "ignored CF-Connecting-IP / X-Forwarded-For from <peer>". If that peer is your
# proxy, add it here, or every visitor is counted as the proxy and shares one allowance.
# TRUSTED_PROXIES=127.0.0.1,::1,10.10.10.1,100.64.224.0,100.98.101.113

# Log level. Unset, only errors are logged (the operator notices above are written anyway).
RUST_LOG=info

# Passkey sign-ups allowed per hour over all visitors (default 300). Hitting it is logged
# loudly as "SIGN-UP CEILING HIT".
# SIGNUP_GLOBAL_PER_HOUR=300

# Passkey sign-ups that may be BEGUN per hour over all visitors (default 1500). Hitting it is
# logged loudly as "SIGN-UP BEGIN CEILING HIT".
# SIGNUP_BEGINS_GLOBAL_PER_HOUR=1500

# Rows the sign-in challenge table may hold, live or expired (default 20000; one network may
# hold 100 live at once). At the ceiling expired rows are deleted on the spot; if it is still
# full, new passkey ceremonies get 503 and "SIGN-IN CHALLENGE CEILING HIT" is logged.
# AUTH_CHALLENGES_MAX=20000

# Never set TEST_ONLY_LIMIT_RACE_DELAY_MS here: it is for the tests, and the API refuses to
# start with it when WEBAUTHN_ORIGIN is https.

# Days after which a passkey-only account that never played is deleted (default 30, 0 = never).
# UNUSED_ACCOUNT_PURGE_DAYS=30

# Email sign-in stays off (503) until this is set.
# RESEND_API_KEY=
# EMAIL_FROM=Sonnet Man <signin@inspiredmile.com>
