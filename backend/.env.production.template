# Inspired Mile API: production environment
# Copy to .env beside the binary (~/sites/inspired-mile-api/.env on prod).
# Never commit the actual .env file: it contains secrets.

# sqlx needs an explicit user.
DATABASE_URL=postgres://<user>@localhost/inspired_mile

# REQUIRED. Signs every session. The server will not start if this is missing, shorter than
# 32 bytes, this placeholder, or the old development constant. Generate it once and keep it:
# changing it signs everyone out.
JWT_SECRET=<run: openssl rand -base64 48>

PORT=3849
CORS_ORIGIN=https://sonnetman.inspiredmile.com

# Reverse proxies whose CF-Connecting-IP / X-Forwarded-For are believed, as the API sees
# them on the socket (addresses or CIDR networks, comma-separated). From any other peer the
# headers are ignored and the socket address is the client. The default is
#   127.0.0.1,::1,10.10.10.1,100.64.224.0
# If Caddy reaches this API over the tailnet, its address here is its Tailscale address
# (100.x.y.z), which must then be listed. The API logs a warning naming the peer whenever it
# ignores a forwarding header: if that peer is your proxy, add it here, or every visitor is
# counted as the proxy and shares one request allowance.
# TRUSTED_PROXIES=127.0.0.1,::1,10.10.10.1,100.64.224.0

# Passkey sign-ups allowed per hour over all visitors (default 300). Hitting it is logged
# loudly as "SIGN-UP CEILING HIT".
# SIGNUP_GLOBAL_PER_HOUR=300

# Days after which a passkey-only account that never played is deleted (default 30, 0 = never).
# UNUSED_ACCOUNT_PURGE_DAYS=30

# Email sign-in stays off (503) until this is set.
# RESEND_API_KEY=
# EMAIL_FROM=Sonnet Man <signin@inspiredmile.com>
