 "yes": [
  [
   "宮花寂寞紅",
   "閑坐說玄宗"
  ],
  [
   "黃河入海流",
   "更上一層樓"
  ],
  [
   "洗手作羹湯",
   "先遣小姑嘗"
  ],
  [
   "春來發幾枝",
   "此物最相思"
  ],
  [
   "應知故鄉事",
   "寒梅着花未"
  ],
  [
   "但聞人語響",
   "復照青苔上"
  ],
  [
   "日暮掩柴扉",
   "王孫歸不歸"
  ],
  [
   "紅泥小火爐",
   "能飲一杯無"
  ],
  [
   "哥舒夜帶刀",
   "不敢過臨洮"
  ],
  [
   "疑是地上霜",
   "低頭思故鄉"
  ],
  [
   "深坐顰蛾眉",
   "不知心恨誰"
  ],
  [
   "素手玉房前",
   "時時誤拂弦"
  ],
  [
   "經冬復歷春",
   "不敢問來人"
  ],
  [
   "名成八陣圖",
   "遺恨失吞吳"
  ],
  [
   "日暮客愁新",
   "江清月近人"
  ],
  [
   "處處聞啼鳥",
   "花落知多少"
  ],
  [
   "莫教枝上啼",
   "不得到遼西"
  ],
  [
   "萬徑人蹤滅",
   "獨釣寒江雪"
  ],
  [
   "散步詠涼天",
   "幽人應未眠"
  ],
  [
   "積雪浮雲端",
   "城中增暮寒"
  ],
  [
   "深宮二十年",
   "雙淚落君前"
  ],
  [
   "言師採藥去",
   "雲深不知處"
  ],
  [
   "須盡丘壑美",
   "暫遊桃源裡"
  ],
  [
   "豈向人間住",
   "時人已知處"
  ],
  [
   "今朝蟢子飛",
   "莫是藁砧歸"
  ],
  [
   "春日凝妝上翠樓",
   "悔教夫婿覓封侯"
  ],
  [
   "未央前殿月輪高",
   "簾外春寒賜錦袍"
  ],
  [
   "欲飲琵琶馬上催",
   "古來征戰幾人回"
  ],
  [
   "夜深前殿按歌聲",
   "斜倚薰籠坐到明"
  ],
  [
   "美人相並立瓊軒",
   "鸚鵡前頭不敢言"
  ],
  [
   "待曉堂前拜舅姑",
   "畫眉深淺入時無"
  ],
  [
   "雙袖龍鍾淚不乾",
   "憑君傳語報平安"
  ],
  [
   "賈生才調更無倫",
   "不問蒼生問鬼神"
  ],
  [
   "九重誰省諫書函",
   "半作障泥半作帆"
  ],
  [
   "黃竹歌聲動地哀",
   "穆王何事不重來"
  ],
  [
   "巴山夜雨漲秋池",
   "卻話巴山夜雨時"
  ],
  [
   "雙鯉迢迢一紙書",
   "茂陵秋雨病相如"
  ],
  [
   "鳳城寒盡怕春宵",
   "辜負香衾事早朝"
  ],
  [
   "崔九堂前㡬度聞",
   "落花時節又逢君"
  ],
  [
   "荳蔻梢頭二月初",
   "卷上珠簾總不如"
  ],
  [
   "唯覺尊前笑不成",
   "替人垂淚到天明"
  ],
  [
   "流水無情草自春",
   "落花猶似墜樓人"
  ],
  [
   "秋盡江南草未凋",
   "玉人何處教吹簫"
  ],
  [
   "輕羅小扇撲流螢",
   "臥看牽牛織女星"
  ],
  [
   "閑愛孤云靜愛僧",
   "樂游原上望昭陵"
  ],
  [
   "自將磨洗認前朝",
   "銅雀春深鎖二喬"
  ],
  [
   "夜泊秦淮近酒家",
   "隔江猶唱後庭花"
  ],
  [
   "朝朝馬策與刀環",
   "萬里黃河繞黑山"
  ],
  [
   "畫人心逐世人情",
   "老木寒雲滿故城"
  ]
 ],
 "no": [
  [
   "白頭宮女在",
   "閑坐說玄宗"
  ],
  [
   "欲窮千里目",
   "更上一層樓"
  ],
  [
   "未諳姑食性",
   "先遣小姑嘗"
  ],
  [
   "願君多采擷",
   "此物最相思"
  ],
  [
   "來日綺窗前",
   "寒梅着花未"
  ],
  [
   "返景入深林",
   "復照青苔上"
  ],
  [
   "春草明年綠",
   "王孫歸不歸"
  ],
  [
   "晚來天欲雪",
   "能飲一杯無"
  ],
  [
   "至今窺牧馬",
   "不敢過臨洮"
  ],
  [
   "舉頭望山月",
   "低頭思故鄉"
  ],
  [
   "但見淚痕濕",
   "不知心恨誰"
  ],
  [
   "欲得周郎顧",
   "時時誤拂弦"
  ],
  [
   "近鄉情更怯",
   "不敢問來人"
  ],
  [
   "江流石不轉",
   "遺恨失吞吳"
  ],
  [
   "野曠天低樹",
   "江清月近人"
  ],
  [
   "夜來風雨聲",
   "花落知多少"
  ],
  [
   "啼時驚妾夢",
   "不得到遼西"
  ],
  [
   "孤舟簑笠翁",
   "獨釣寒江雪"
  ],
  [
   "空山松子落",
   "幽人應未眠"
  ],
  [
   "林表明霽色",
   "城中增暮寒"
  ],
  [
   "一聲何滿子",
   "雙淚落君前"
  ],
  [
   "只在此山中",
   "雲深不知處"
  ],
  [
   "莫學武陵人",
   "暫遊桃源裡"
  ],
  [
   "莫買沃洲山",
   "時人已知處"
  ],
  [
   "鉛華不可棄",
   "莫是藁砧歸"
  ],
  [
   "忽見陌頭楊柳色",
   "悔教夫婿覓封侯"
  ],
  [
   "平陽歌舞新承寵",
   "簾外春寒賜錦袍"
  ],
  [
   "醉臥沙場君莫笑",
   "古來征戰幾人回"
  ],
  [
   "紅顏未老恩先斷",
   "斜倚薰籠坐到明"
  ],
  [
   "含情欲說宮中事",
   "鸚鵡前頭不敢言"
  ],
  [
   "妝罷低聲問夫婿",
   "畫眉深淺入時無"
  ],
  [
   "馬上相逢無紙筆",
   "憑君傳語報平安"
  ],
  [
   "可憐夜半虛前席",
   "不問蒼生問鬼神"
  ],
  [
   "春風舉國裁宮錦",
   "半作障泥半作帆"
  ],
  [
   "八駿日行三萬里",
   "穆王何事不重來"
  ],
  [
   "何當共剪西窗燭",
   "卻話巴山夜雨時"
