---
// The one place the stylesheet is loaded, so every page gets it (Tailwind 4 has no
// integration that injects it; pages that forgot the import rendered unstyled).
import '../styles/global.css';

interface Props {
  /** The page's name in English: what the built HTML carries, and what shows until the language loads. */
  title: string;
  description?: string;
  ogImage?: string;
  /**
   * Message keys for the same two things. With them the document title and the description follow the
   * interface language (the i18n script below). A page that gives no titleKey gets the key of its
   * navigation entry, where it has one.
   */
  titleKey?: string;
  descriptionKey?: string;
  /** The page areas (src/i18n/pages/<area>) those keys live in, if they are not core keys. */
  i18nAreas?: string[];
}

const { title, description = 'Inspired Mile — Digital Collectible Cards Powered by AI and AR', ogImage = '/images/cards/sm-001.webp', titleKey, descriptionKey, i18nAreas = [] } = Astro.props;
const currentPath = Astro.url.pathname;
// Pages named in the navigation or the footer already have a translated name in the core locale files.
const NAV_TITLE_KEYS: Record<string, string> = {
  '/': 'nav.home',
  '/collection': 'nav.collection',
  '/playground': 'nav.playground',
  '/battle': 'nav.battle',
  '/multiplayer': 'nav.multiplayer',
  '/tournaments': 'nav.tournaments',
  '/world-map': 'nav.worldMap',
  '/marketplace': 'nav.marketplace',
  '/vr': 'nav.vr',
  '/viewer': 'nav.viewer',
  '/about': 'nav.about',
  '/profile': 'nav.profile',
  '/privacy': 'footer.privacy',
  '/terms': 'footer.terms',
  '/credits': 'footer.credits',
};
const pageTitleKey = titleKey ?? NAV_TITLE_KEYS[currentPath.replace(/(.)\/$/, '$1')] ?? '';
const canonicalUrl = `https://sonnetman.inspiredmile.com${currentPath}`;
---

<!DOCTYPE html>
<html lang="en" data-title-key={pageTitleKey || undefined} data-description-key={descriptionKey} data-i18n-areas={i18nAreas.length ? i18nAreas.join(',') : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0d0b09" />
    <meta name="apple-mobile-web-app-title" content="Sonnet Man" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/icons/20261120100034/favicon.svg" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/x-icon" href="/icons/20261120100034/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/icons/20261120100034/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={`${title} | Inspired Mile`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Inspired Mile`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title} | Inspired Mile</title>
    <script is:inline>
      // Analytics (Plausible) loads only for a visitor who has passed the age gate: never
      // for one the gate has blocked, and not before it is answered. The gate script at the
      // end of this page calls __loadAnalytics() again when the visitor passes it. The
      // privacy policy describes this behaviour; change both together.
      (function () {
        var loaded = false;
        window.__loadAnalytics = function () {
          if (loaded) return;
          var state = null;
          try { state = localStorage.getItem('inspired-mile-age-verified'); } catch (e) { return; }
          if (state !== 'adult' && state !== 'teen-consented') return;
          loaded = true;
          var s = document.createElement('script');
          s.defer = true;
          s.setAttribute('data-domain', 'inspiredmile.com');
          s.src = 'https://plausible.io/js/script.js';
          document.head.appendChild(s);
        };
        window.__loadAnalytics();
      })();
    </script>
    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Inspired Mile",
      "alternateName": "Sonnet Man",
      "url": "https://sonnetman.inspiredmile.com",
      "description": "Shakespeare-themed collectible card game with AI-judged poetry battles, classroom mode, and multiplayer arena.",
      "applicationCategory": "GameApplication",
      "operatingSystem": "Any",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "author": {
        "@type": "Organization",
        "name": "Inspired Mile"
      },
      "genre": ["Educational", "Card Game", "Literature"],
      "audience": {
        "@type": "EducationalAudience",
        "educationalRole": "student",
        "suggestedMinAge": 13
      }
    }
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Age Gate Modal -->
    <div id="age-gate" class="fixed inset-0 z-200 bg-obsidian-950 flex items-center justify-center p-4 hidden">
      <div class="card-glass max-w-md w-full p-8 text-center bg-obsidian-900/95 backdrop-blur-xl border border-obsidian-700 rounded-2xl shadow-2xl">
        <div class="w-16 h-16 rounded-2xl bg-linear-to-br from-gold-400 to-gold-600 flex items-center justify-center mx-auto mb-6">
          <span class="text-obsidian-950 font-display font-bold text-2xl">IM</span>
        </div>
        <h2 class="font-display text-2xl font-bold text-white mb-2" data-i18n="age.title">Welcome to Inspired Mile</h2>
        <p class="text-obsidian-400 text-sm mb-6" data-i18n="age.intro">Please confirm your age to continue.</p>

        <div id="age-gate-form">
          <label class="block text-start text-xs text-obsidian-400 mb-2" data-i18n="age.dob">Date of Birth</label>
          <div class="flex gap-2 mb-4">
            <select id="age-month" class="flex-1 bg-obsidian-800 border border-obsidian-700 rounded-lg px-3 py-2.5 text-sm text-obsidian-200 focus:border-gold-500/50 focus:outline-hidden">
              <option value="" data-i18n="age.month">Month</option>
              <option value="1">January</option>
              <option value="2">February</option>
              <option value="3">March</option>
              <option value="4">April</option>
              <option value="5">May</option>
              <option value="6">June</option>
              <option value="7">July</option>
              <option value="8">August</option>
              <option value="9">September</option>
              <option value="10">October</option>
              <option value="11">November</option>
              <option value="12">December</option>
            </select>
            <select id="age-day" class="w-20 bg-obsidian-800 border border-obsidian-700 rounded-lg px-3 py-2.5 text-sm text-obsidian-200 focus:border-gold-500/50 focus:outline-hidden">
              <option value="" data-i18n="age.day">Day</option>
            </select>
            <select id="age-year" class="w-24 bg-obsidian-800 border border-obsidian-700 rounded-lg px-3 py-2.5 text-sm text-obsidian-200 focus:border-gold-500/50 focus:outline-hidden">
              <option value="" data-i18n="age.year">Year</option>
            </select>
          </div>
          <button id="age-gate-submit" class="btn-primary w-full py-3 font-display font-bold" data-i18n="age.continue">Continue</button>
          <p id="age-gate-error" class="text-crimson-400 text-xs mt-3 hidden" data-i18n="age.errorDob">Please select your full date of birth.</p>
        </div>

        <div id="age-gate-minor" class="hidden">
          <div class="w-12 h-12 rounded-full bg-crimson-500/20 border border-crimson-500/30 flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-crimson-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          </div>
          <h3 class="font-display text-lg font-bold text-crimson-400 mb-2" data-i18n="age.minorTitle">Age Requirement Not Met</h3>
          <p class="text-obsidian-400 text-sm" data-i18n="age.minorBody">
            You must be at least 13 years old to use Inspired Mile. Please come back when you meet the age requirement.
          </p>
        </div>

        <div id="age-gate-teen" class="hidden">
          <div class="w-12 h-12 rounded-full bg-gold-500/20 border border-gold-500/30 flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h3 class="font-display text-lg font-bold text-gold-400 mb-2" data-i18n="age.teenTitle">Parental Consent Required</h3>
          <p class="text-obsidian-400 text-sm mb-4" data-i18n="age.teenBody">
            Since you are under 18, you need parental or guardian consent to use Inspired Mile.
          </p>
          <label class="flex items-start gap-3 text-start mb-4 cursor-pointer">
            <input type="checkbox" id="parental-consent" class="mt-1 w-4 h-4 rounded-sm border-obsidian-600 bg-obsidian-800 text-gold-500 focus:ring-gold-500/50" />
            <!-- One sentence per language, with the links in its slots (fillSlots, src/i18n): no white space
                 of the markup's own between the pieces. -->
            <span class="text-xs text-obsidian-300 leading-relaxed" data-i18n-slots="age.consent">I confirm that my parent or legal guardian has reviewed the <a href="/terms" class="text-gold-400 hover:text-gold-300" data-i18n="footer.terms" data-i18n-slot="terms">Terms of Service</a> and <a href="/privacy" class="text-gold-400 hover:text-gold-300" data-i18n="footer.privacy" data-i18n-slot="privacy">Privacy Policy</a> and consents to my use of Inspired Mile.</span>
          </label>
          <button id="teen-continue" class="btn-primary w-full py-3 font-display font-bold opacity-50 pointer-events-none" data-i18n="age.teenContinue">Continue with Consent</button>
        </div>

        <!-- Only when the question was opened from the account menu: leave without answering,
             or, on the under-13 screen right after that answer, go back to the question -->
        <button id="age-gate-cancel" type="button" class="hidden w-full text-xs text-obsidian-400 hover:text-gold-400 py-2 mt-3 transition-colors" data-i18n="auth.back">Back</button>

        <p class="text-[10px] text-obsidian-600 mt-6" data-i18n-slots="age.agree">By continuing, you agree to our <a href="/terms" class="text-obsidian-500 hover:text-gold-400" data-i18n="footer.terms" data-i18n-slot="terms">Terms of Service</a> and <a href="/privacy" class="text-obsidian-500 hover:text-gold-400" data-i18n="footer.privacy" data-i18n-slot="privacy">Privacy Policy</a>.</p>
      </div>
    </div>

    <!-- Navigation -->
    <nav class="fixed top-0 w-full z-50 bg-obsidian-950/80 backdrop-blur-lg border-b border-obsidian-800/50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between gap-2 h-16">
          <!-- Logo. On a narrow phone only the mark shows: with the wordmark, a language whose
               "Sign in" is long (German, Arabic) pushed the menu button off the screen. -->
          <a href="/" class="flex items-center gap-3 group shrink-0" aria-label="Inspired Mile">
            <div class="w-8 h-8 shrink-0 rounded-lg bg-linear-to-br from-gold-400 to-gold-600 flex items-center justify-center">
              <span class="text-obsidian-950 font-display font-bold text-sm">IM</span>
            </div>
            <span class="hidden min-[440px]:inline font-display text-lg font-semibold text-gold-400 group-hover:text-gold-300 transition-colors whitespace-nowrap">
              Inspired Mile
            </span>
          </a>

          <!-- Desktop Navigation -->
          <div class="hidden md:flex items-center gap-6">
            <a href="/" class:list={["text-sm font-medium transition-colors", currentPath === "/" ? "text-gold-400" : "text-obsidian-300 hover:text-gold-400"]} data-i18n="nav.home">Home</a>
            <a href="/collection" class:list={["text-sm font-medium transition-colors", currentPath === "/collection" ? "text-gold-400" : "text-obsidian-300 hover:text-gold-400"]} data-i18n="nav.collection">Collection</a>
            <!-- Play dropdown -->
            <div class="relative group">
              <button class:list={["text-sm font-medium transition-colors flex items-center gap-1", ["/playground","/battle","/multiplayer","/tournaments"].includes(currentPath) ? "text-gold-400" : "text-obsidian-300 hover:text-gold-400"]}>
                <span data-i18n="nav.play">Play</span>
                <svg class="w-3 h-3 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </button>
              <div class="absolute left-1/2 -translate-x-1/2 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150">
                <div class="w-44 bg-obsidian-900/95 backdrop-blur-lg border border-obsidian-700 rounded-xl shadow-2xl py-2">
                  <a href="/playground" class:list={["block px-4 py-2 text-sm transition-colors", currentPath === "/playground" ? "text-gold-400 bg-gold-500/5" : "text-obsidian-300 hover:text-gold-400 hover:bg-obsidian-800/50"]} data-i18n="nav.playground">Playground</a>
                  <a href="/battle" class:list={["block px-4 py-2 text-sm transition-colors", currentPath === "/battle" ? "text-gold-400 bg-gold-500/5" : "text-obsidian-300 hover:text-gold-400 hover:bg-obsidian-800/50"]} data-i18n="nav.battle">Battle Arena</a>
                  <a href="/multiplayer" class:list={["block px-4 py-2 text-sm transition-colors", currentPath === "/multiplayer" ? "text-gold-400 bg-gold-500/5" : "text-obsidian-300 hover:text-gold-400 hover:bg-obsidian-800/50"]} data-i18n="nav.multiplayer">Multiplayer</a>
                  <a href="/tournaments" class:list={["block px-4 py-2 text-sm transition-colors", currentPath === "/tournaments" ? "text-gold-400 bg-gold-500/5" : "text-obsidian-300 hover:text-gold-400 hover:bg-obsidian-800/50"]} data-i18n="nav.tournaments">Tournaments</a>
                </div>
              </div>
            </div>
            <!-- Explore dropdown -->
            <div class="relative group">
              <button class:list={["text-sm font-medium transition-colors flex items-center gap-1", ["/world-map","/marketplace","/vr","/viewer"].includes(currentPath) ? "text-gold-400" : "text-obsidian-300 hover:text-gold-400"]}>
                <span data-i18n="nav.explore">Explore</span>
                <svg class="w-3 h-3 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </button>
              <div class="absolute left-1/2 -translate-x-1/2 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150">
                <div class="w-44 bg-obsidian-900/95 backdrop-blur-lg border border-obsidian-700 rounded-xl shadow-2xl py-2">
                  <a href="/world-map" class:list={["block px-4 py-2 text-sm transition-colors", currentPath === "/world-map" ? "text-gold-400 bg-gold-500/5" : "text-obsidian-300 hover:text-gold-400 hover:bg-obsidian-800/50"]} data-i18n="nav.worldMap">World Map</a>
                  <a href="/marketplace" data-adults-only hidden class:list={["block px-4 py-2 text-sm transition-colors", currentPath === "/marketplace" ? "text-gold-400 bg-gold-500/5" : "text-obsidian-300 hover:text-gold-400 hover:bg-obsidian-800/50"]} data-i18n="nav.marketplace">Marketplace</a>
                  <a href="/vr" class:list={["block px-4 py-2 text-sm transition-colors", currentPath === "/vr" ? "text-gold-400 bg-gold-500/5" : "text-obsidian-300 hover:text-gold-400 hover:bg-obsidian-800/50"]} data-i18n="nav.vr">VR Gallery</a>
                  <a href="/viewer" class:list={["block px-4 py-2 text-sm transition-colors", currentPath === "/viewer" ? "text-gold-400 bg-gold-500/5" : "text-obsidian-300 hover:text-gold-400 hover:bg-obsidian-800/50"]} data-i18n="nav.viewer">3D Viewer</a>
                </div>
              </div>
            </div>
            <a href="/about" class:list={["text-sm font-medium transition-colors", currentPath === "/about" ? "text-gold-400" : "text-obsidian-300 hover:text-gold-400"]} data-i18n="nav.about">About</a>
            <a href="/profile" class:list={["text-sm font-medium transition-colors", currentPath === "/profile" ? "text-gold-400" : "text-obsidian-300 hover:text-gold-400"]} data-i18n="nav.profile">Profile</a>
          </div>

          <!-- Auth + Audio toggle + Mobile menu button -->
          <div class="flex items-center gap-2">
            <!-- Interface language. Filled by the i18n script below; each language under its own name. -->
            <select id="locale-switch" aria-label="Language" data-i18n-aria-label="nav.language" class="max-w-[7.5rem] bg-obsidian-900 border border-obsidian-700 rounded-lg px-2 py-1.5 text-xs text-obsidian-300 hover:border-gold-500/30 focus:border-gold-500/50 focus:outline-hidden">
              <option value="en">English</option>
            </select>
            <!-- Auth: Login/User button -->
            <div id="auth-container" class="relative">
              <button id="auth-btn" type="button" data-auth-text="signIn" class="text-xs font-medium text-obsidian-300 hover:text-gold-400 transition-colors border border-obsidian-700 rounded-lg px-3 py-1.5 hover:border-gold-500/30 whitespace-nowrap">
                Sign In
              </button>
              <div id="user-badge" class="hidden flex items-center gap-2 cursor-pointer">
                <div class="w-7 h-7 rounded-full bg-gold-500/20 border border-gold-500/30 flex items-center justify-center">
                  <span id="user-initial" class="text-xs font-bold text-gold-400">?</span>
                </div>
                <span id="user-name" class="hidden md:inline text-xs font-medium text-obsidian-300"></span>
              </div>
              <!-- Auth dropdown -->
              <!-- Every visible string below is filled from the locale files by the auth script (data-auth-text; keys auth.*). -->
              <!-- Narrow screens: pinned under the nav bar across the width (the nav is the containing block). -->
              <div id="auth-dropdown" role="dialog" class="hidden fixed inset-x-4 top-[4.5rem] sm:absolute sm:inset-x-auto sm:end-0 sm:top-full sm:mt-2 sm:w-80 bg-obsidian-900 border border-obsidian-700 rounded-xl shadow-2xl z-50 p-4 max-h-[calc(100vh-6rem)] overflow-y-auto">
                <!-- Signed out: choose a method, then (email only) address and code -->
                <div id="auth-sign-in-options">
                  <!-- Step 1: choose -->
                  <div id="auth-step-choose">
                    <h3 class="text-sm font-display font-bold text-obsidian-200 mb-1" data-auth-text="signInHeading"></h3>
                    <p class="text-xs text-obsidian-400 mb-3 leading-relaxed" data-auth-text="signInIntro"></p>
                    <button id="auth-passkey-btn" type="button" class="btn-primary w-full gap-2 px-3 py-2.5 text-xs">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
                      <span data-auth-text="passkeyButton"></span>
                    </button>
                    <button id="auth-create-btn" type="button" class="btn-secondary w-full gap-2 px-3 py-2 text-xs mt-2">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                      <span data-auth-text="createButton"></span>
                    </button>
                    <p id="auth-passkey-unsupported" class="hidden text-xs text-obsidian-400 leading-relaxed"></p>
                    <button id="auth-email-btn" type="button" class="hidden w-full flex items-center justify-center gap-2 text-xs text-obsidian-300 hover:text-gold-400 py-2 mt-2 transition-colors">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                      <span data-auth-text="emailButton"></span>
                    </button>
                    <p id="auth-email-hint" class="hidden text-[11px] text-obsidian-500 mt-2 text-center leading-relaxed" data-auth-text="emailHint"></p>
                    <p id="auth-legacy-note" class="hidden text-[11px] text-obsidian-500 mt-3 leading-relaxed" data-auth-text="legacyAccountNote"></p>
                  </div>

                  <!-- Create an account with a passkey: what it is, and the one catch -->
                  <div id="auth-step-create" class="hidden">
                    <h3 class="text-sm font-display font-bold text-obsidian-200 mb-1" data-auth-text="createHeading"></h3>
                    <p class="text-xs text-obsidian-400 mb-2 leading-relaxed" data-auth-text="createIntro"></p>
                    <p id="auth-create-warning" class="text-xs text-gold-300 bg-gold-500/10 border border-gold-500/20 rounded-lg px-3 py-2 mb-3 leading-relaxed"></p>
                    <button id="auth-create-confirm" type="button" class="btn-primary w-full px-3 py-2.5 text-xs" data-auth-text="createConfirm"></button>
                    <button id="auth-create-back" type="button" class="w-full text-xs text-obsidian-400 hover:text-gold-400 py-2 mt-1 text-center transition-colors" data-auth-text="back"></button>
                  </div>

                  <!-- Step 2: email address -->
                  <div id="auth-step-email" class="hidden">
                    <h3 class="text-sm font-display font-bold text-obsidian-200 mb-1" data-auth-text="emailHeading"></h3>
                    <p class="text-xs text-obsidian-400 mb-3 leading-relaxed" data-auth-text="emailIntro"></p>
                    <form id="auth-email-form" novalidate>
                      <label for="auth-email-input" class="block text-[11px] text-obsidian-400 mb-1" data-auth-text="emailLabel"></label>
                      <input id="auth-email-input" name="email" type="email" inputmode="email" autocomplete="username webauthn" autocapitalize="none" spellcheck="false" maxlength="255" class="w-full bg-obsidian-800 border border-obsidian-700 rounded-lg px-3 py-2.5 text-sm text-obsidian-100 placeholder:text-obsidian-600 focus:border-gold-500/50 focus:outline-hidden" data-auth-placeholder="emailPlaceholder" />
                      <button id="auth-email-send" type="submit" class="btn-primary w-full px-3 py-2.5 text-xs mt-3" data-auth-text="emailSend"></button>
                    </form>
                    <button id="auth-email-back" type="button" class="w-full text-xs text-obsidian-400 hover:text-gold-400 py-2 mt-1 text-center transition-colors" data-auth-text="back"></button>
                  </div>

                  <!-- Step 3: the code -->
                  <div id="auth-step-code" class="hidden">
                    <h3 class="text-sm font-display font-bold text-obsidian-200 mb-1" data-auth-text="codeHeading"></h3>
                    <p id="auth-code-intro" class="text-xs text-obsidian-400 mb-3 leading-relaxed break-words"></p>
                    <form id="auth-code-form" novalidate>
                      <label for="auth-code-input" class="block text-[11px] text-obsidian-400 mb-1" data-auth-text="codeLabel"></label>
