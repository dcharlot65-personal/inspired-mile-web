      // Interface language: detect it, fill the static markup (data-i18n), mark <html> with
      // lang and dir, and wire the switcher. See src/i18n.
      import { bindLocaleSwitch, has, initI18n, loadArea, locale, onLocaleChange, t } from '../i18n';

      // Month names come from the browser, in the interface language.
      function nameMonths() {
        const fmt = new Intl.DateTimeFormat(locale(), { month: 'long' });
        document.querySelectorAll<HTMLOptionElement>('#age-month option').forEach((o) => {
          const m = Number(o.value);
          if (m >= 1 && m <= 12) o.textContent = fmt.format(new Date(2020, m - 1, 15));
        });
      }

      // The document title and description, in the interface language. The keys are on <html>
      // (the layout's titleKey / descriptionKey props); a page's own keys are in the areas it names.
      async function nameDocument() {
        const d = document.documentElement.dataset;
        const l = locale();
        await Promise.all((d.i18nAreas ?? '').split(',').filter(Boolean).map((a) => loadArea(a, l)));
        if (locale() !== l) return;
        const set = (selector: string, content: string) => document.querySelector(selector)?.setAttribute('content', content);
        if (d.titleKey && has(d.titleKey)) {
          const title = `${t(d.titleKey)} | Inspired Mile`;
          document.title = title;
          set('meta[property="og:title"]', title);
          set('meta[name="twitter:title"]', title);
        }
        if (d.descriptionKey && has(d.descriptionKey)) {
          const description = t(d.descriptionKey);
          set('meta[name="description"]', description);
          set('meta[property="og:description"]', description);
          set('meta[name="twitter:description"]', description);
        }
        document.documentElement.dataset.titleLocale = l;
      }

      initI18n().then(() => {
        const select = document.getElementById('locale-switch') as HTMLSelectElement | null;
        if (select) bindLocaleSwitch(select);
        nameMonths();
        onLocaleChange(nameMonths);
        void nameDocument();
        onLocaleChange(() => void nameDocument());
      });
    </script>

    <script>
      import { initAudio, toggleMute, getPrefs, isInitialized, stopMusic } from '../lib/audio-manager';

      // Fade out music when navigating away for smoother transitions
      window.addEventListener('beforeunload', () => {
        stopMusic(200);
      });

      // Mobile menu toggle
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      btn?.addEventListener('click', () => {
        menu?.classList.toggle('hidden');
      });

      // Audio toggle
      const audioToggle = document.getElementById('audio-toggle');
      const iconOn = document.getElementById('audio-icon-on');
      const iconOff = document.getElementById('audio-icon-off');

      function updateAudioIcon() {
        const p = getPrefs();
        if (p.muted) {
          iconOn?.classList.add('hidden');
          iconOff?.classList.remove('hidden');
        } else {
          iconOn?.classList.remove('hidden');
          iconOff?.classList.add('hidden');
        }
      }
      updateAudioIcon();

      // Init AudioContext on first user interaction (autoplay policy)
      document.addEventListener('click', () => {
        if (!isInitialized()) initAudio();
      }, { once: true });

      // Fade music out on internal navigation for smoother transitions
      document.querySelectorAll('a[href^="/"]').forEach(link => {
        link.addEventListener('click', () => {
          if (isInitialized()) stopMusic(300);
        });
      });

      audioToggle?.addEventListener('click', (e) => {
        e.stopPropagation();
        if (!isInitialized()) initAudio();
        toggleMute();
        updateAudioIcon();
      });
    </script>

    <script>
      import { loadArea, locale as currentLocale, t as tr } from '../i18n';
      import { escapeHtml } from '../i18n/pages/runtime';

      // ---- Toast notification system ----
      type ToastType = 'success' | 'error' | 'info' | 'warning';

      const TOAST_STYLES: Record<ToastType, string> = {
        success: 'bg-emerald-500/15 border-emerald-500/40 text-emerald-300',
        error: 'bg-crimson-500/15 border-crimson-500/40 text-crimson-300',
        info: 'bg-purple-500/15 border-purple-500/40 text-purple-300',
        warning: 'bg-gold-500/15 border-gold-500/40 text-gold-300',
      };

      const TOAST_ICONS: Record<ToastType, string> = {
        success: '\u2713',
        error: '\u2717',
        info: '\u24D8',
        warning: '\u26A0',
      };

      function showToast(message: string, type: ToastType = 'info', duration = 4000) {
        const container = document.getElementById('achievement-toasts');
        if (!container) return;

        const toast = document.createElement('div');
        toast.className = `pointer-events-auto flex items-center gap-3 px-4 py-3 rounded-xl border backdrop-blur-lg shadow-2xl transform translate-x-full opacity-0 transition-all duration-500 max-w-sm ${TOAST_STYLES[type]}`;
        toast.innerHTML = `
          <span class="text-lg font-bold">${TOAST_ICONS[type]}</span>
          <p class="text-sm flex-1">${message}</p>
        `;
        container.appendChild(toast);

        requestAnimationFrame(() => {
          toast.classList.remove('translate-x-full', 'opacity-0');
          toast.classList.add('translate-x-0', 'opacity-100');
        });

        setTimeout(() => {
          toast.classList.add('translate-x-full', 'opacity-0');
          setTimeout(() => toast.remove(), 500);
        }, duration);
      }

      // Expose globally so page scripts can use it
      (window as any).showToast = showToast;

      // ---- Achievement toast notifications ----
      const TIER_COLORS: Record<string, string> = {
        bronze: 'from-amber-700 to-amber-900 border-amber-600',
        silver: 'from-gray-400 to-gray-600 border-gray-300',
        gold: 'from-gold-400 to-gold-600 border-gold-300',
      };

      window.addEventListener('achievement-unlocked', (async (e: CustomEvent) => {
        const a = e.detail;
        const container = document.getElementById('achievement-toasts');
        if (!container) return;
        // The achievement's name and description in the interface language (English if the area will not
        // load). Fetched when the first toast is due: the card and city data behind it is not for every page.
        await loadArea('achievements', currentLocale()).catch(() => {});
        const { achievementDescription, achievementName } = await import('../i18n/pages/terms');

        const toast = document.createElement('div');
        const colors = TIER_COLORS[a.tier] || TIER_COLORS.bronze;
        toast.className = `pointer-events-auto flex items-center gap-3 px-4 py-3 rounded-xl bg-linear-to-r ${colors} border shadow-2xl transform translate-x-full opacity-0 transition-all duration-500 max-w-sm`;
        toast.innerHTML = `
          <span class="text-2xl">${a.icon}</span>
          <div class="flex-1 min-w-0">
            <div class="text-xs font-semibold uppercase tracking-wider text-white/70">${tr('toast.achievement')}</div>
            <div class="font-display font-bold text-white truncate">${escapeHtml(achievementName(a))}</div>
            <div class="text-xs text-white/80">${escapeHtml(achievementDescription(a))}</div>
          </div>
        `;
        container.appendChild(toast);

        requestAnimationFrame(() => {
          toast.classList.remove('translate-x-full', 'opacity-0');
          toast.classList.add('translate-x-0', 'opacity-100');
        });

        setTimeout(() => {
          toast.classList.add('translate-x-full', 'opacity-0');
          setTimeout(() => toast.remove(), 500);
        }, 4000);
      }) as EventListener);
    </script>

    <script>
      // Auth UI logic — passkeys first, an emailed one-time code as the way in without one.
      import { ACCOUNT_CHANGED_EVENT, initStorageBackend, isLoggedIn, getCurrentUser, logoutUser, setCurrentUserAgeTier } from '../lib/storage-backend';
      import { adultsOnlyShown } from '../lib/adults-only';
      import { getMigrationStatus, importCards, type AuthResponse, type PasskeyInfo } from '../lib/api-client';
      import { getDeviceCards } from '../lib/inventory';
      import { importDone, importIds, importSkipped, offerImport } from '../lib/import-offer';
      import { refreshAccountCards } from '../lib/account-cards';
      import { claimDailyBonus } from '../lib/credits';
      import { fillSlots, has, initI18n, onLocaleChange, t } from '../i18n';
      import {
        AuthFlowError,
        addPasskey,
        cancelPasskeyCeremony,
        accountAgeTier,
        confirmRecoveryEmail,
        getAuthMethods,
        listPasskeys,
        passkeyAutofillSupported,
        passkeysSupported,
        removePasskey,
        requestRecoveryEmail,
        sendEmailCode,
        setAccountAgeTier,
        signInWithEmailCode,
        signInWithPasskey,
        signOutEverywhere,
        signUpWithPasskey,
      } from '../lib/passwordless';

      // Every user-facing string of the sign-in UI is a message in the locale files
      // (src/i18n/locales, keys auth.* and auth.error.*). Markup carries only keys
      // (data-auth-text, data-auth-placeholder). {email}, {date} and {name} are filled in
      // at run time.
      type StringKey = string;

      function text(key: StringKey, values: Record<string, string> = {}): string {
        return t(`auth.${key}`, values);
      }

      function errorText(e: unknown): string {
        let code = e instanceof AuthFlowError ? e.code : 'generic';
        // With email off there is no emailed code to point to.
        if (code === 'passkey_not_accepted' && !emailAvailable) code = 'passkey_not_accepted_no_email';
        return has(`auth.error.${code}`) ? t(`auth.error.${code}`) : t('auth.error.generic');
      }

      function applyStrings() {
        document.querySelectorAll<HTMLElement>('[data-auth-text]').forEach((el) => {
          el.textContent = text(el.dataset.authText as StringKey);
        });
        // A sentence with the links in it, one template per language (the legal line).
        document.querySelectorAll<HTMLElement>('[data-auth-slots]').forEach((el) => {
          fillSlots(el, text(el.dataset.authSlots as StringKey));
        });
        document.querySelectorAll<HTMLInputElement>('[data-auth-placeholder]').forEach((el) => {
          el.placeholder = text(el.dataset.authPlaceholder as StringKey);
        });
      }

      const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;

      const authContainer = $('auth-container');
      const authBtn = $('auth-btn');
      const userBadge = $('user-badge');
      const authDropdown = $('auth-dropdown');
      const signInOptions = $('auth-sign-in-options');
      const passkeyOffer = $('auth-passkey-offer');
      const userMenu = $('auth-user-menu');
      const authError = $('auth-error');
      const authNotice = $('auth-notice');
      const emailInput = $<HTMLInputElement>('auth-email-input');
      const codeInput = $<HTMLInputElement>('auth-code-input');
      const steps = {
        choose: $('auth-step-choose'),
        create: $('auth-step-create'),
        email: $('auth-step-email'),
        code: $('auth-step-code'),
      };
      type Step = keyof typeof steps;

      let currentStep: Step = 'choose';
      let pendingEmail = '';
      // True between an email sign-in and the visitor answering the passkey offer.
      let offeringPasskey = false;
      // True between a passkey sign-up and the visitor answering "add a second way in".
      let nudgingRecovery = false;
      // Whether the server can send mail. Until it says so, email is shown nowhere.
      let emailAvailable = false;
      let passkeyTotal = 0;
      let pendingRecoveryEmail = '';
      const recoveryNudge = $('auth-recovery-nudge');

      function show(el: HTMLElement, visible: boolean) {
        el.classList.toggle('hidden', !visible);
      }

      function showError(msg: string) {
        show(authNotice, false);
        authError.textContent = msg;
        show(authError, true);
      }
      function showNotice(msg: string) {
        show(authError, false);
        authNotice.textContent = msg;
        show(authNotice, true);
      }
      function clearMessages() {
        show(authError, false);
        show(authNotice, false);
        show($('auth-offer-error'), false);
        show($('auth-nudge-error'), false);
        show($('auth-email-message'), false);
        show($('auth-menu-message'), false);
      }

      function showMenuMessage(msg: string, kind: 'ok' | 'error') {
        const el = $('auth-menu-message');
        el.textContent = msg;
        el.classList.toggle('text-emerald-400', kind === 'ok');
        el.classList.toggle('text-crimson-400', kind === 'error');
        show(el, true);
      }

      /** Lock the panel while a request or a passkey prompt is in flight. */
      function setBusy(busy: boolean) {
        authDropdown.setAttribute('aria-busy', String(busy));
        authDropdown.querySelectorAll<HTMLButtonElement | HTMLInputElement>('button, input').forEach((el) => {
          el.disabled = busy;
        });
        authDropdown.classList.toggle('cursor-progress', busy);
      }

      function showStep(step: Step) {
        currentStep = step;
        (Object.keys(steps) as Step[]).forEach((name) => show(steps[name], name === step));
        if (step !== 'email') cancelPasskeyCeremony();
      }

      function isOpen() {
        return !authDropdown.classList.contains('hidden');
      }

      function closeDropdown() {
        show(authDropdown, false);
        authBtn.setAttribute('aria-expanded', 'false');
        cancelPasskeyCeremony();
        // An unanswered passkey offer, or recovery prompt, is a "not now".
        offeringPasskey = false;
        nudgingRecovery = false;
      }

      function openDropdown() {
        clearMessages();
        updateAuthUI();
        show(authDropdown, true);
        authBtn.setAttribute('aria-expanded', 'true');
        if (isLoggedIn()) {
          if (!offeringPasskey && !nudgingRecovery) refreshAccount();
        } else {
          showStep('choose');
          prepareSignIn();
        }
      }

      function toggleDropdown() {
        if (isOpen()) closeDropdown();
        else openDropdown();
      }

      function updateAuthUI() {
        const mobileAuthBtn = document.getElementById('mobile-auth-btn');
        if (isLoggedIn()) {
          const user = getCurrentUser()!;
          const shownName = user.display_name || user.username;
          const initial = (shownName[0] || '?').toUpperCase();
          show(authBtn, false);
          if (mobileAuthBtn) show(mobileAuthBtn, false);
          show(userBadge, true);
          userBadge.classList.add('flex');
          $('user-initial').textContent = initial;
          $('user-name').textContent = shownName;
          $('menu-user-initial').textContent = initial;
          $('menu-user-name').textContent = shownName;
          $('menu-user-provider').textContent = user.email || text('signedIn');
          show(signInOptions, false);
          show(passkeyOffer, offeringPasskey);
          show(recoveryNudge, nudgingRecovery);
          show(userMenu, !offeringPasskey && !nudgingRecovery);
          renderRecovery();
        } else {
          show(authBtn, true);
          if (mobileAuthBtn) show(mobileAuthBtn, true);
          show(userBadge, false);
          userBadge.classList.remove('flex');
          show(signInOptions, true);
          show(passkeyOffer, false);
          show(recoveryNudge, false);
          show(userMenu, false);
        }
      }

      /**
       * The recovery parts of the signed-in views: the warning while one passkey is the
       * only way in, and the recovery email (shown only when the server can send mail).
       */
      function renderRecovery() {
        const user = getCurrentUser();
        if (!user) return;
        const hasEmail = !!user.email;
        const warning = $('auth-recovery-warning');
        warning.textContent = text(emailAvailable ? 'recoveryWarning' : 'recoveryWarningNoEmail');
        show(warning, passkeyTotal === 1 && !hasEmail);
        $('auth-nudge-name').textContent = text('nudgeName', { name: user.display_name || user.username });
        $('auth-nudge-body').textContent = text(emailAvailable ? 'nudgeBody' : 'nudgeBodyNoEmail');
        show($('auth-nudge-email'), emailAvailable && !hasEmail);

        show($('auth-email-section'), emailAvailable);
        const shown = $('auth-recovery-email');
        shown.textContent = user.email || '';
        show(shown, hasEmail);
        const adding = !$('auth-add-email-form').classList.contains('hidden')
          || !$('auth-add-code-form').classList.contains('hidden');
        show($('auth-add-email-btn'), !hasEmail && !adding);
        if (hasEmail) {
          show($('auth-add-email-form'), false);
          show($('auth-add-code-form'), false);
        }
      }

      /** Decide which sign-in methods to show: what the browser can do, and what the server offers. */
      async function prepareSignIn() {
        const canPasskey = passkeysSupported();
        show($('auth-passkey-btn'), canPasskey);
        show($('auth-create-btn'), canPasskey);
        const methods = await getAuthMethods();
        emailAvailable = methods.email;
        const unsupported = $('auth-passkey-unsupported');
        unsupported.textContent = text(emailAvailable ? 'passkeyUnsupported' : 'passkeyUnsupportedNoEmail');
        show(unsupported, !canPasskey);
        $('auth-create-warning').textContent = text(emailAvailable ? 'createWarning' : 'createWarningNoEmail');
        // With no mail key the server cannot send anything: email is shown nowhere.
        show($('auth-email-btn'), emailAvailable);
        show($('auth-email-hint'), emailAvailable && canPasskey);
        // With email off, an account that was only ever reached by Google or email cannot
        // be opened at all. Say so, rather than let "create an account" look like the way in.
        show($('auth-legacy-note'), !emailAvailable);
      }

      authBtn.addEventListener('click', toggleDropdown);
      userBadge.addEventListener('click', toggleDropdown);
      document.getElementById('mobile-auth-btn')?.addEventListener('click', (e) => {
        // The button sits outside the auth container: keep the click from counting as an
        // outside click, which would close the panel as it opens.
        e.stopPropagation();
        document.getElementById('mobile-menu')?.classList.add('hidden');
        toggleDropdown();
      });

      // Close on outside click. composedPath, not contains(): a clicked row may already
      // have been re-rendered away by the time this runs.
      document.addEventListener('click', (e) => {
        if (!e.composedPath().includes(authContainer)) closeDropdown();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && isOpen()) closeDropdown();
      });

      // --- After any successful sign-in ---
      function onSignedIn(auth: AuthResponse, via: 'passkey' | 'email' | 'signup') {
        pendingEmail = '';
        emailInput.value = '';
        codeInput.value = '';
        clearMessages();
        // Signed in by email with no passkey on the account: offer one for next time.
        offeringPasskey = via === 'email' && auth.passkey_count === 0 && passkeysSupported();
        // A brand-new passkey-only account: one passkey is its only way in. Say so now.
        nudgingRecovery = via === 'signup';
        passkeyTotal = auth.passkey_count;
        updateAuthUI();
        if (!offeringPasskey && !nudgingRecovery) closeDropdown();
        offerMigrationIfNeeded();
      }

      // --- Passkey sign-in ---
      $('auth-passkey-btn').addEventListener('click', async () => {
        clearMessages();
        setBusy(true);
        try {
          onSignedIn(await signInWithPasskey(), 'passkey');
        } catch (e) {
          if (e instanceof AuthFlowError && e.code === 'passkey_cancelled') showNotice(errorText(e));
          else showError(errorText(e));
        } finally {
          setBusy(false);
        }
      });

      /**
       * Conditional mediation: while the email field is showing, let the browser offer a
       * saved passkey in that field's autofill. Resolves only if the visitor picks one.
       */
      async function offerPasskeyAutofill() {
        if (!(await passkeyAutofillSupported())) return;
        if (currentStep !== 'email' || !isOpen() || isLoggedIn()) return;
        try {
          onSignedIn(await signInWithPasskey({ autofill: true }), 'passkey');
        } catch (e) {
          // Cancelled is the normal end (the visitor typed an address instead).
          const quiet = e instanceof AuthFlowError && (e.code === 'passkey_cancelled' || e.code === 'network');
          if (!quiet && currentStep === 'email' && isOpen()) showError(errorText(e));
        }
      }

      // --- Create an account with a passkey (no email, no personal data) ---
      $('auth-create-btn').addEventListener('click', () => {
        clearMessages();
        // No account is started unless the age gate allows one.
        if (!accountAgeTier()) {
          showNotice(t('auth.error.age_required'));
          return;
        }
        showStep('create');
      });

      $('auth-create-back').addEventListener('click', () => {
        clearMessages();
        showStep('choose');
      });

      $('auth-create-confirm').addEventListener('click', async () => {
        clearMessages();
        setBusy(true);
        try {
          onSignedIn(await signUpWithPasskey(), 'signup');
        } catch (e) {
          if (e instanceof AuthFlowError && e.code === 'passkey_cancelled') showNotice(errorText(e));
          else showError(errorText(e));
        } finally {
          setBusy(false);
        }
      });

      // --- After a passkey sign-up: a second way in ---
      function leaveNudge() {
        nudgingRecovery = false;
        updateAuthUI();
      }

      $('auth-nudge-passkey').addEventListener('click', async () => {
        clearMessages();
        setBusy(true);
        try {
          await addPasskey();
          leaveNudge();
          await refreshAccount();
          showMenuMessage(text('passkeyAdded'), 'ok');
        } catch (e) {
          const el = $('auth-nudge-error');
          el.textContent = errorText(e);
          show(el, true);
        } finally {
          setBusy(false);
        }
      });

      $('auth-nudge-email').addEventListener('click', async () => {
        clearMessages();
        leaveNudge();
        await refreshAccount();
        openAddEmail();
      });

      $('auth-nudge-later').addEventListener('click', closeDropdown);

      // --- Recovery email for a signed-in account ---
      const addEmailInput = $<HTMLInputElement>('auth-add-email-input');
      const addCodeInput = $<HTMLInputElement>('auth-add-code-input');

      function showEmailMessage(msg: string, kind: 'ok' | 'error') {
        const el = $('auth-email-message');
        el.textContent = msg;
        el.classList.toggle('text-emerald-400', kind === 'ok');
        el.classList.toggle('text-crimson-400', kind === 'error');
        show(el, true);
      }

      function openAddEmail() {
        if (!emailAvailable) return;
        show($('auth-add-email-btn'), false);
        show($('auth-add-code-form'), false);
        show($('auth-add-email-form'), true);
        addEmailInput.focus();
      }

      function resetAddEmail() {
        pendingRecoveryEmail = '';
        addEmailInput.value = '';
        addCodeInput.value = '';
        show($('auth-add-email-form'), false);
        show($('auth-add-code-form'), false);
      }

      $('auth-add-email-btn').addEventListener('click', () => {
        clearMessages();
        // The same gate as every other place an address could be given.
        if (!accountAgeTier()) {
          showEmailMessage(t('auth.error.age_required'), 'error');
          return;
        }
        openAddEmail();
      });

      $('auth-add-email-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        clearMessages();
        const email = addEmailInput.value.trim();
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          showEmailMessage(t('auth.error.invalid_email'), 'error');
          return;
        }
        setBusy(true);
        try {
          await requestRecoveryEmail(email);
          pendingRecoveryEmail = email;
          $('auth-add-code-intro').textContent = text('addEmailCodeIntro', { email });
          addCodeInput.value = '';
          show($('auth-add-email-form'), false);
          show($('auth-add-code-form'), true);
        } catch (err) {
          showEmailMessage(errorText(err), 'error');
        } finally {
          setBusy(false);
          if (pendingRecoveryEmail) addCodeInput.focus();
        }
      });

      addCodeInput.addEventListener('input', () => {
        addCodeInput.value = addCodeInput.value.replace(/\D/g, '').slice(0, 6);
      });

      $('auth-add-code-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        clearMessages();
        const code = addCodeInput.value.replace(/\D/g, '');
        if (code.length !== 6) {
          showEmailMessage(t('auth.error.code_incomplete'), 'error');
          return;
        }
        setBusy(true);
        try {
          await confirmRecoveryEmail(pendingRecoveryEmail, code);
          resetAddEmail();
          updateAuthUI();
          showEmailMessage(text('addEmailDone'), 'ok');
        } catch (err) {
          showEmailMessage(errorText(err), 'error');
        } finally {
          setBusy(false);
        }
      });

      // --- Email: address ---
      $('auth-email-btn').addEventListener('click', () => {
        clearMessages();
        // No address is asked for, let alone sent, unless the age gate allows it.
        if (!accountAgeTier()) {
          showNotice(t('auth.error.age_required'));
          return;
        }
        showStep('email');
        emailInput.focus();
        offerPasskeyAutofill();
      });

      $('auth-email-back').addEventListener('click', () => {
        clearMessages();
        showStep('choose');
      });

      async function requestCode(email: string, resend: boolean) {
        clearMessages();
        setBusy(true);
        try {
          await sendEmailCode(email);
          pendingEmail = email;
          $('auth-code-intro').textContent = text('codeIntro', { email });
          codeInput.value = '';
          showStep('code');
          if (resend) showNotice(text('codeResent'));
        } catch (e) {
          showError(errorText(e));
        } finally {
          setBusy(false);
          if (currentStep === 'code') codeInput.focus();
        }
      }

      $('auth-email-form').addEventListener('submit', (e) => {
        e.preventDefault();
        const email = emailInput.value.trim();
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          showError(t('auth.error.invalid_email'));
          return;
        }
        requestCode(email, false);
      });

      // --- Email: code ---
      codeInput.addEventListener('input', () => {
        codeInput.value = codeInput.value.replace(/\D/g, '').slice(0, 6);
      });

      $('auth-code-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        clearMessages();
        const code = codeInput.value.replace(/\D/g, '');
        if (code.length !== 6) {
          showError(t('auth.error.code_incomplete'));
          return;
        }
        setBusy(true);
        try {
          onSignedIn(await signInWithEmailCode(pendingEmail, code), 'email');
        } catch (err) {
          showError(errorText(err));
        } finally {
          setBusy(false);
        }
      });

      $('auth-code-resend').addEventListener('click', () => {
        if (pendingEmail) requestCode(pendingEmail, true);
      });

      $('auth-code-back').addEventListener('click', () => {
        clearMessages();
        codeInput.value = '';
        showStep('email');
        emailInput.focus();
        offerPasskeyAutofill();
      });

      // --- Adding a passkey (the offer after email sign-in, and the menu button) ---
      async function addPasskeyFrom(source: 'offer' | 'menu') {
        clearMessages();
        setBusy(true);
        try {
          await addPasskey();
          offeringPasskey = false;
          updateAuthUI();
          await refreshAccount();
          showMenuMessage(text('passkeyAdded'), 'ok');
        } catch (e) {
          if (source === 'offer') {
            const el = $('auth-offer-error');
            el.textContent = errorText(e);
            show(el, true);
          } else {
            showMenuMessage(errorText(e), 'error');
          }
        } finally {
          setBusy(false);
        }
      }

      $('auth-passkey-add').addEventListener('click', () => addPasskeyFrom('offer'));
      $('auth-passkey-add-menu').addEventListener('click', () => addPasskeyFrom('menu'));
      $('auth-passkey-skip').addEventListener('click', closeDropdown);

      // --- Passkey management in the signed-in menu ---
      function renderPasskeys(passkeys: PasskeyInfo[]) {
        const list = $('auth-passkey-list');
        list.replaceChildren();
        for (const passkey of passkeys) {
          const added = new Date(passkey.created_at).toLocaleDateString(
            document.documentElement.lang || undefined,
            { year: 'numeric', month: 'short', day: 'numeric' },
          );
          const item = document.createElement('li');
          item.dataset.passkeyId = passkey.id;
          item.className = 'flex items-center justify-between gap-2 bg-obsidian-800/60 border border-obsidian-700/60 rounded-lg px-3 py-2';

          const label = document.createElement('div');
          label.className = 'min-w-0';
          const name = document.createElement('p');
          name.className = 'text-xs font-medium text-obsidian-200 truncate';
          name.textContent = passkey.name;
          const meta = document.createElement('p');
          meta.className = 'text-[10px] text-obsidian-500';
          meta.textContent = text('passkeyAddedOn', { date: added });
          label.append(name, meta);

          const remove = document.createElement('button');
          remove.type = 'button';
          remove.className = 'shrink-0 text-[11px] text-obsidian-400 hover:text-crimson-400 transition-colors';
          remove.textContent = text('passkeyRemove');
          remove.setAttribute('aria-label', text('passkeyRemoveLabel', { name: passkey.name }));
          remove.addEventListener('click', async () => {
            // First click asks, second click removes.
            if (remove.dataset.armed !== 'true') {
              remove.dataset.armed = 'true';
              remove.textContent = text('passkeyRemoveConfirm');
              remove.classList.remove('text-obsidian-400');
              remove.classList.add('text-crimson-400', 'font-semibold');
              return;
            }
            clearMessages();
            setBusy(true);
            try {
              await removePasskey(passkey.id);
              await refreshPasskeys();
              showMenuMessage(text('passkeyRemoved'), 'ok');
            } catch (e) {
              showMenuMessage(errorText(e), 'error');
            } finally {
              setBusy(false);
            }
          });

          item.append(label, remove);
          list.append(item);
        }
        show($('auth-passkey-empty'), passkeys.length === 0);
        show($('auth-passkey-add-menu'), passkeysSupported());
        passkeyTotal = passkeys.length;
        renderRecovery();
      }

      /** Everything the signed-in menu shows: whether email exists at all, then passkeys. */
      async function refreshAccount() {
        emailAvailable = (await getAuthMethods()).email;
        renderRecovery();
        await refreshPasskeys();
      }

      async function refreshPasskeys() {
        if (!isLoggedIn()) return;
        try {
          renderPasskeys(await listPasskeys());
        } catch (e) {
          showMenuMessage(errorText(e), 'error');
        }
      }

      // --- Logout ---
      $('auth-logout-all-btn').addEventListener('click', async () => {
        try {
          await signOutEverywhere();
        } catch {
          // Local state is cleared either way; a session that outlived this fails its next request.
        }
        $('auth-passkey-list').replaceChildren();
        passkeyTotal = 0;
        resetAddEmail();
        closeDropdown();
        updateAuthUI();
      });

      $('auth-logout-btn').addEventListener('click', async () => {
        await logoutUser();
        $('auth-passkey-list').replaceChildren();
        passkeyTotal = 0;
        resetAddEmail();
        closeDropdown();
        updateAuthUI();
      });

      // --- The one-time import of this device's cards ---
      // Signed in, the collection is the account's (src/lib/account-cards.ts). The cards this device
      // collected signed out can come over once per account, on its first sign-in (its first hours),
      // capped by the server: one of each, the rarest first (backend/src/migration/handlers.rs).
      // Stats and achievements stay on the device.
      let importLimit = 0;
      function drawImportLimit() {
        const el = document.getElementById('migration-limit');
        if (el) el.textContent = importLimit ? t('migrate.limit', { max: importLimit }) : '';
      }
      onLocaleChange(drawImportLimit);

      // A device offers its collection once (src/lib/import-offer.ts): after it has gone to an
      // account, no account that signs in here is offered it again, and an account that said "Skip"
      // is not asked again here. The server takes an import once per account whatever a page does.
      async function offerMigrationIfNeeded() {
        if (!isLoggedIn()) return;
        // The daily bonus, asked for once a day (the server pays it once a day per account).
        void claimDailyBonus();
        if (!offerImport(getCurrentUser()?.id, getDeviceCards().length)) return;

        try {
          const status = await getMigrationStatus();
          if (status.migrated || status.open === false) return;
          importLimit = status.max_cards;
        } catch {
          return; // Server unreachable
        }

        drawImportLimit();
        document.getElementById('migration-banner')?.classList.remove('hidden');
      }

      document.getElementById('migrate-yes')?.addEventListener('click', async () => {
        const btn = document.getElementById('migrate-yes') as HTMLButtonElement;
        btn.textContent = t('migrate.syncing');
        btn.disabled = true;

        try {
          const result = await importCards(importIds(getDeviceCards()));
          importDone(getCurrentUser()?.id);
          await refreshAccountCards();
          const resultEl = document.getElementById('migration-result')!;
          resultEl.classList.remove('hidden');
          resultEl.classList.add('text-emerald-400');
          resultEl.textContent = t('migrate.done', { cards: result.imported.length });
          setTimeout(() => {
            document.getElementById('migration-banner')?.classList.add('hidden');
          }, 3000);
        } catch (e: any) {
          const resultEl = document.getElementById('migration-result')!;
          resultEl.classList.remove('hidden');
          resultEl.classList.add('text-crimson-400');
          resultEl.textContent = t('migrate.failed');
          btn.textContent = t('migrate.yes');
          btn.disabled = false;
        }
      });

      document.getElementById('migrate-no')?.addEventListener('click', () => {
        document.getElementById('migration-banner')?.classList.add('hidden');
        importSkipped(getCurrentUser()?.id);
      });

      // --- The account's age ---
      // The page used to post the browser's stored age-gate answer to the account on every
      // load and sign-in. On a shared browser that answer may be someone else's (a teen's,
      // on a family computer), and it made the adult's account a teen one for good. Now only
      // the signed-in user's own answer is sent: the age question opened from this menu.
      $('auth-age-btn').addEventListener('click', () => {
        closeDropdown();
        (window as unknown as { __openAgeGate?: () => void }).__openAgeGate?.();
      });
      window.addEventListener('im-age-answered', async (event) => {
        const tier = (event as CustomEvent<{ tier?: string }>).detail?.tier;
        if (!isLoggedIn() || (tier !== 'adult' && tier !== 'teen')) return;
        try {
          const answer = await setAccountAgeTier(tier);
          // What the pages show an adult account follows (src/lib/adults-only.ts).
          setCurrentUserAgeTier(answer.age_tier);
        } catch (e) {
          // An account made for someone under 18 stays that way (backend src/auth/age.rs);
          // there is nothing to say that would help.
          if (e instanceof AuthFlowError && e.code === 'age_tier_locked') return;
          openDropdown();
          showMenuMessage(errorText(e), 'error');
        }
      });

      // --- The market and referrals: adult accounts only (owner, 2026-11-19) ---
      // The server refuses every other account; the links are hidden for them (src/lib/adults-only.ts).
      function drawAdultsOnly() {
        const shown = adultsOnlyShown();
        document.querySelectorAll<HTMLElement>('[data-adults-only]').forEach((el) => { el.hidden = !shown; });
      }
      drawAdultsOnly();
      window.addEventListener(ACCOUNT_CHANGED_EVENT, drawAdultsOnly);
      window.addEventListener('im-age-answered', drawAdultsOnly);
      window.addEventListener('storage', drawAdultsOnly);

      // --- Init ---
      // Said once now, and again whenever the interface language is known or changes.
      function relabel() {
        applyStrings();
        authDropdown.setAttribute('aria-label', text('signInHeading'));
        updateAuthUI();
      }
      applyStrings();
      authDropdown.setAttribute('aria-label', text('signInHeading'));
      initI18n().then(() => {
        relabel();
        onLocaleChange(relabel);
      });
      authBtn.setAttribute('aria-haspopup', 'dialog');
      authBtn.setAttribute('aria-expanded', 'false');
      initStorageBackend().then(() => {
        updateAuthUI();
        // Signed in on this visit: the daily bonus, asked for once a day (src/lib/credits.ts).
        if (isLoggedIn()) void claimDailyBonus();
      });
    </script>
    <!-- Service Worker Registration -->
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
    <!-- Installed-app behaviour: install guidance and storage protection (src/lib/pwa.ts) -->
    <script>
      import { initPwa } from '../lib/pwa';
      initPwa();
    </script>
    <!-- Tamper Guard -->
    <script>
      import { initTamperGuard } from '../scripts/tamper-guard';
      initTamperGuard();
    </script>
    <!-- Age Gate -->
    <script is:inline>
      (function() {
        var AGE_KEY = 'inspired-mile-age-verified';
        var gate = document.getElementById('age-gate');
        var form = document.getElementById('age-gate-form');
        var minor = document.getElementById('age-gate-minor');
        var teenStep = document.getElementById('age-gate-teen');
        var cancel = document.getElementById('age-gate-cancel');
        var errorEl = document.getElementById('age-gate-error');
        // True while the question was opened from the account menu. Only then is the answer
        // also the signed-in user's answer for the account: the auth script hears it through
        // the 'im-age-answered' event and sends it (backend src/auth/age.rs). The answer the
        // browser stored earlier is never sent on its own: on a shared browser it may be
        // someone else's.
        var forAccount = false;
        // True while the under-13 screen shows an answer just given from the account menu.
        // Its "Back" then returns to the question, so a wrong year can be put right at once
        // (answering again replaces this browser's stored answer; making the account adult
        // again asks for a passkey, backend src/auth/age.rs). Reached any other way (the
        // first visit, or a later page load), the screen keeps no way back, as before.
        var minorBack = false;
        var filled = false;

        // Populate day/year dropdowns (once)
        function fillSelects() {
          if (filled) return;
          filled = true;
          var daySelect = document.getElementById('age-day');
          for (var d = 1; d <= 31; d++) {
            var opt = document.createElement('option');
            opt.value = d;
            opt.textContent = d;
            daySelect.appendChild(opt);
          }
          var yearSelect = document.getElementById('age-year');
          var currentYear = new Date().getFullYear();
          for (var y = currentYear; y >= currentYear - 100; y--) {
            var opt = document.createElement('option');
            opt.value = y;
            opt.textContent = y;
            yearSelect.appendChild(opt);
          }
        }

        // `mustAnswer`: no "Back" on the question itself (it was reached from the under-13
        // screen, and leaving now would leave that answer standing without a second look).
        function openGate(account, mustAnswer) {
          forAccount = !!account;
          minorBack = false;
          fillSelects();
          form.classList.remove('hidden');
          minor.classList.add('hidden');
          teenStep.classList.add('hidden');
          errorEl.classList.add('hidden');
          cancel.classList.toggle('hidden', !forAccount || !!mustAnswer);
          gate.classList.remove('hidden');
        }

        // The menu's "Date of Birth": ask again, for the signed-in account.
        window.__openAgeGate = function() { openGate(true); };

        cancel.addEventListener('click', function() {
          if (minorBack) {
            openGate(true, true);
            return;
          }
          forAccount = false;
          cancel.classList.add('hidden');
          gate.classList.add('hidden');
        });

        function answered(stored) {
          if (!forAccount) return;
          forAccount = false;
          cancel.classList.add('hidden');
          if (stored === 'blocked') {
            minorBack = true;
            cancel.classList.remove('hidden');
          }
          // Under 13 has no tier of its own: the account gets the strictest one there is.
          var tier = stored === 'adult' ? 'adult' : 'teen';
          window.dispatchEvent(new CustomEvent('im-age-answered', { detail: { tier: tier } }));
        }

        // Submit handler
        document.getElementById('age-gate-submit').addEventListener('click', function() {
          var month = parseInt(document.getElementById('age-month').value);
          var day = parseInt(document.getElementById('age-day').value);
          var year = parseInt(document.getElementById('age-year').value);

          if (!month || !day || !year) {
            errorEl.classList.remove('hidden');
            return;
          }

          var dob = new Date(year, month - 1, day);
          var today = new Date();
          var age = today.getFullYear() - dob.getFullYear();
          var monthDiff = today.getMonth() - dob.getMonth();
          if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < dob.getDate())) {
            age--;
          }

          if (age < 13) {
            // Block access
            localStorage.setItem(AGE_KEY, 'blocked');
            form.classList.add('hidden');
            minor.classList.remove('hidden');
            answered('blocked');
          } else if (age < 18) {
            // Show parental consent
            form.classList.add('hidden');
            teenStep.classList.remove('hidden');
          } else {
            // Adult — proceed
            localStorage.setItem(AGE_KEY, 'adult');
            gate.classList.add('hidden');
            window.__loadAnalytics();
            answered('adult');
          }
        });

        // Parental consent checkbox
        var checkbox = document.getElementById('parental-consent');
        var teenBtn = document.getElementById('teen-continue');
        if (checkbox && teenBtn) {
          checkbox.addEventListener('change', function() {
            if (checkbox.checked) {
              teenBtn.classList.remove('opacity-50', 'pointer-events-none');
            } else {
              teenBtn.classList.add('opacity-50', 'pointer-events-none');
            }
          });

          teenBtn.addEventListener('click', function() {
            if (checkbox.checked) {
              localStorage.setItem(AGE_KEY, 'teen-consented');
              gate.classList.add('hidden');
              window.__loadAnalytics();
              answered('teen-consented');
            }
          });
        }

        // On load: the gate covers the page until this browser has an answer.
        var stored = localStorage.getItem(AGE_KEY);

        // Skip age gate on legal pages so users can read them
        var legalPages = ['/privacy', '/terms', '/about', '/credits'];
        if (legalPages.indexOf(window.location.pathname) >= 0) return;

        if (stored === 'adult' || stored === 'teen-consented') return;
        if (stored === 'blocked') {
          // User was under 13 — keep blocking
          gate.classList.remove('hidden');
          form.classList.add('hidden');
          minor.classList.remove('hidden');
          return;
        }

        // Show the age gate
        openGate(false);
      })();
    </script>

    <!-- Offline Indicator -->
    <div id="offline-banner" class="fixed top-0 left-0 right-0 z-180 bg-crimson-600 text-white text-center py-2 text-xs font-medium hidden" data-i18n="offline.banner">
      You're offline — Collection and Trivia still work. Multiplayer requires internet.
    </div>

    <script is:inline>
      // Offline detection
      (function() {
        var offlineBanner = document.getElementById('offline-banner');
        function updateOnlineStatus() {
          if (navigator.onLine) {
            offlineBanner.classList.add('hidden');
            document.body.style.paddingTop = '';
            document.body.classList.remove('is-offline');
          } else {
            offlineBanner.classList.remove('hidden');
            document.body.style.paddingTop = '32px';
            document.body.classList.add('is-offline');
          }
        }
        window.addEventListener('online', updateOnlineStatus);
        window.addEventListener('offline', updateOnlineStatus);
        updateOnlineStatus();
      })();
    </script>
  </body>
</html>
