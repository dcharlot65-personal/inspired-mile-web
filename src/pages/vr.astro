---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="VR Gallery" description="Walk through every Shakespeare card in the game in virtual reality.">

  <section class="section-padding">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/20 mb-6">
          <span class="w-2 h-2 rounded-full bg-purple-500 animate-pulse"></span>
          <span class="text-purple-400 text-xs font-medium tracking-wide uppercase" data-i18n="vr.badge">Virtual reality</span>
        </div>
        <!-- Two pieces so that one can carry the gradient; the first brings its own space where the language wants one. -->
        <h1 class="text-4xl sm:text-5xl font-display font-bold mb-4"><span data-i18n="vr.titleA">Card </span><span class="text-gradient" data-i18n="vr.titleB">Gallery</span></h1>
        <p class="text-obsidian-400 max-w-2xl mx-auto" data-i18n="vr.intro">
          Walk through every card in the game in 3D. It works on Quest 3 and Vision Pro through WebXR, and with a mouse on a computer.
        </p>
      </div>

      <!-- One sentence in three pieces around the link; each piece carries its own spaces. -->
      <p class="text-center text-sm text-obsidian-300 mb-6"><span data-i18n="vr.play.before">Want to play? </span><a href="/theatre" class="text-gold-400 underline hover:text-gold-300" data-i18n="vr.play.link">The Theatre</a><span data-i18n="vr.play.after"> stages the whole duel in your headset.</span></p>

      <!-- Controls -->
      <div class="flex flex-wrap items-center justify-center gap-3 mb-4">
        <button id="enter-vr-btn" class="btn-primary px-6 py-2 text-sm" data-i18n="vr.enter">Enter VR</button>
        <button id="reset-camera-btn" class="text-xs text-obsidian-400 hover:text-gold-400 border border-obsidian-700 rounded-lg px-4 py-2 transition-colors" data-i18n="viewer.reset">Reset the camera</button>
      </div>

      <!-- Status bar -->
      <div class="text-center mb-4">
        <span id="vr-status" role="status" class="text-xs text-obsidian-500" data-i18n="vr.status.loading">Loading the 3D engine…</span>
      </div>

      <!-- WebXR fallback message -->
      <div id="vr-fallback" class="hidden text-center mb-4">
        <div class="inline-flex items-start gap-2 px-4 py-2 rounded-lg bg-obsidian-800 border border-obsidian-700 text-xs text-obsidian-400 text-start">
          <span aria-hidden="true">&#9432;</span>
          <span data-i18n="vr.fallback">WebXR is not available on this device. The gallery is shown in 3D: drag to look around, scroll to zoom.</span>
        </div>
      </div>

      <!-- Canvas -->
      <div class="card-glass overflow-hidden rounded-xl">
        <canvas id="vr-canvas" class="w-full" style="height: 600px; display: block;"></canvas>
      </div>

      <!-- Instructions. "Quest 3" and "Vision Pro" are product names, the same in every language. -->
      <div class="mt-6 grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="card-glass p-4 text-center">
          <div class="text-2xl mb-2" aria-hidden="true">&#128433;</div>
          <h3 class="text-sm font-display font-bold text-obsidian-200 mb-1" data-i18n="vr.card.desktop.title">Computer</h3>
          <p class="text-xs text-obsidian-400" data-i18n="vr.card.desktop.body">Click and drag to look around. Scroll to zoom. Click a card to select it.</p>
        </div>
        <div class="card-glass p-4 text-center">
          <div class="text-2xl mb-2" aria-hidden="true">&#127759;</div>
          <h3 class="text-sm font-display font-bold text-obsidian-200 mb-1" lang="en" translate="no">Quest 3</h3>
          <p class="text-xs text-obsidian-400" data-i18n="vr.card.quest.body">Press “Enter VR” to step inside. Use the controllers to move and to pick cards.</p>
        </div>
        <div class="card-glass p-4 text-center">
          <div class="text-2xl mb-2" aria-hidden="true">&#128065;</div>
          <h3 class="text-sm font-display font-bold text-obsidian-200 mb-1" lang="en" translate="no">Vision Pro</h3>
          <p class="text-xs text-obsidian-400" data-i18n="vr.card.vision.body">Opens in WebXR. Look at a card and pinch to select it.</p>
        </div>
      </div>
    </div>
  </section>

  <script>
    import { VRCardEngine } from '../lib/vr-engine';
    import type { Msg } from '../lib/verse/msg';
    import { tm } from '../i18n';
    import { initPage, onPageLocaleChange } from '../i18n/page';

    const canvas = document.getElementById('vr-canvas') as HTMLCanvasElement;
    const statusEl = document.getElementById('vr-status')!;
    const enterVRBtn = document.getElementById('enter-vr-btn')!;
    const resetBtn = document.getElementById('reset-camera-btn')!;
    const fallbackEl = document.getElementById('vr-fallback')!;

    let vrEngine: VRCardEngine | null = null;

    // The status line is kept as a message key, so it can be said again in another language.
    // Until the engine reports something, the markup's own data-i18n key is what is shown.
    let status: Msg | null = null;
    let ready = false;

    function setStatus(m: Msg) {
      status = m;
      drawStatus();
    }

    function drawStatus() {
      if (!ready || !status) return; // the language is not in yet: keep what the markup says
      statusEl.removeAttribute('data-i18n');
      statusEl.textContent = tm(status);
    }

    async function init() {
      try {
        vrEngine = new VRCardEngine({
          canvas,
          onStatusChange: setStatus,
          onError: setStatus,
        });

        vrEngine.start();

        // Try enabling WebXR
        const vrAvailable = await vrEngine.enableVR();
        if (!vrAvailable) {
          fallbackEl.classList.remove('hidden');
          enterVRBtn.classList.add('hidden');
        }
      } catch (e) {
        console.error('[vr] the gallery could not start', e);
        setStatus({ key: 'vr.error.init' });
      }
    }

    enterVRBtn.addEventListener('click', () => {
      // WebXR enter is handled by Babylon's built-in UI button
      setStatus({ key: 'vr.status.useButton' });
    });

    resetBtn.addEventListener('click', () => {
      if (vrEngine) {
        vrEngine.dispose();
        init();
      }
    });

    // The gallery starts at once; its words wait for the language.
    init();
    initPage(['viewer'], { title: 'nav.vr', description: 'vr.meta.description' })
      .catch((e) => console.error('[vr] the language could not be loaded', e))
      .then(() => {
        ready = true;
        drawStatus();
        onPageLocaleChange(drawStatus);
      });
  </script>
</BaseLayout>
