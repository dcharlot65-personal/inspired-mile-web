---
import BaseLayout from '../layouts/BaseLayout.astro';
// Every sentence on this page is a key in src/i18n/pages/tournaments (and "shared"); the
// English written in the markup is what a reader sees before the script has run.
---

<BaseLayout title="Tournaments" description="Enter tournaments of verse duels and play for the title.">

  <section class="section-padding">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gold-500/10 border border-gold-500/20 mb-6">
          <span class="w-2 h-2 rounded-full bg-gold-500 animate-pulse"></span>
          <span class="text-gold-400 text-xs font-medium tracking-wide uppercase" data-i18n="nav.tournaments">Tournaments</span>
        </div>
        <!-- Two pieces so that one can carry the gradient; the first brings its own space where the language wants one. -->
        <h1 class="text-4xl sm:text-5xl font-display font-bold mb-4"><span data-i18n="tour.titleA">Tournament </span><span class="text-gradient" data-i18n="tour.titleB">Arena</span></h1>
        <p class="text-obsidian-400 max-w-2xl mx-auto" data-i18n="tour.intro">
          Enter organised competitions and show your command of verse. Single elimination, round robin and more.
        </p>
      </div>

      <!-- Tabs -->
      <div class="flex flex-wrap gap-2 mb-8 justify-center">
        <button id="tab-list" class="px-6 py-2 text-sm font-medium rounded-lg bg-gold-500/10 text-gold-400 border border-gold-500/20 transition-colors" data-i18n="nav.tournaments">Tournaments</button>
        <button id="tab-bracket" class="px-6 py-2 text-sm font-medium rounded-lg text-obsidian-400 border border-obsidian-700 hover:border-obsidian-600 transition-colors" data-i18n="tour.tab.bracket">Bracket</button>
      </div>

      <!-- Tournament List -->
      <div id="panel-list">
        <!-- Loading Skeleton -->
        <div id="loading-skeleton" class="space-y-4 animate-pulse">
          {Array(4).fill(null).map(() => (
            <div class="card-glass p-6">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div class="flex-1 space-y-3">
                  <div class="flex items-center gap-3">
                    <div class="bg-obsidian-800 rounded-sm h-6 w-48"></div>
                    <div class="bg-obsidian-800 rounded-full h-5 w-20"></div>
                  </div>
                  <div class="flex gap-4">
                    <div class="bg-obsidian-800 rounded-sm h-3 w-24"></div>
                    <div class="bg-obsidian-800 rounded-sm h-3 w-24"></div>
                    <div class="bg-obsidian-800 rounded-sm h-3 w-32"></div>
                  </div>
                </div>
                <div class="flex gap-2">
                  <div class="bg-obsidian-800 rounded-lg h-9 w-24"></div>
                  <div class="bg-obsidian-800 rounded-lg h-9 w-32"></div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <div id="tournament-list" class="space-y-4 hidden"></div>
      </div>

      <!-- Bracket View -->
      <div id="panel-bracket" class="hidden">
        <div class="mb-6">
          <select id="bracket-tournament-select" aria-label="Choose a tournament…" data-i18n-aria-label="tour.select" class="max-w-full bg-obsidian-800 border border-obsidian-700 rounded-lg px-4 py-2 text-sm text-obsidian-200 focus:outline-hidden focus:border-gold-500/50">
            <option value="" data-i18n="tour.select">Choose a tournament…</option>
          </select>
        </div>

        <div id="bracket-container" class="overflow-x-auto">
          <div class="text-center py-12">
            <p class="text-sm text-obsidian-500" data-i18n="tour.selectHint">Choose a tournament to see its bracket.</p>
          </div>
        </div>

        <!-- Leaderboard -->
        <div id="leaderboard-section" class="hidden mt-8">
          <h2 class="font-display text-xl font-bold text-obsidian-200 mb-4" data-i18n="tour.leaderboard">Standings</h2>
          <div id="leaderboard-table" class="card-glass overflow-x-auto">
            <!-- Populated by JS -->
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    import { listTournaments, registerForTournament, getBracket, getLeaderboard, openMatchRoom, type Tournament, type BracketMatch, type LeaderboardEntry } from '../lib/tournament-client';
    import { getCurrentUser, isLoggedIn } from '../lib/storage-backend';
    import { has, t } from '../i18n';
    import { dateTime, num } from '../i18n/fmt';
    import { errorText, esc, initPage, onPageLocaleChange } from '../i18n/page';

    const toast = (message: string, type: 'success' | 'error' | 'warning') => (window as any).showToast?.(message, type);

    // Tabs
    const tabPairs = [['list', 'panel-list'], ['bracket', 'panel-bracket']] as const;
    tabPairs.forEach(([tab, panel]) => {
      document.getElementById(`tab-${tab}`)!.addEventListener('click', () => {
        tabPairs.forEach(([tb, p]) => {
          document.getElementById(p)!.classList.toggle('hidden', tb !== tab);
          const btn = document.getElementById(`tab-${tb}`)!;
          if (tb === tab) {
            btn.className = 'px-6 py-2 text-sm font-medium rounded-lg bg-gold-500/10 text-gold-400 border border-gold-500/20 transition-colors';
          } else {
            btn.className = 'px-6 py-2 text-sm font-medium rounded-lg text-obsidian-400 border border-obsidian-700 hover:border-obsidian-600 transition-colors';
          }
        });
      });
    });

    // Status colors
    function statusColor(status: string): string {
      switch (status) {
        case 'registration': return 'text-emerald-400 bg-emerald-500/10';
        case 'in_progress': return 'text-purple-400 bg-purple-500/10';
        case 'completed': return 'text-obsidian-400 bg-obsidian-800';
        default: return 'text-obsidian-400 bg-obsidian-800';
      }
    }

    // The server's words for a state or a format have names here; one it adds later is shown as it wrote it.
    const statusName = (status: string) => (has(`tour.status.${status}`) ? t(`tour.status.${status}`) : status.replace(/_/g, ' '));
    const formatName = (format: string) => (has(`tour.format.${format}`) ? t(`tour.format.${format}`) : format.replace(/_/g, ' '));
    const note = (cls: string, text: string, alert = false) =>
      `<div class="text-center py-12"><p class="text-sm ${cls}"${alert ? ' role="alert"' : ''}>${esc(text)}</p></div>`;

    // Load tournament list
    const listContainer = document.getElementById('tournament-list')!;
    const bracketSelect = document.getElementById('bracket-tournament-select') as HTMLSelectElement;

    type ListState = { state: 'loading' } | { state: 'ready' } | { state: 'failed'; error: unknown };
    let tournaments: Tournament[] = [];
    let listState: ListState = { state: 'loading' };

    async function loadTournaments() {
      try {
        tournaments = await listTournaments();
        listState = { state: 'ready' };
      } catch (e) {
        listState = { state: 'failed', error: e };
      }
      renderTournaments();
      populateBracketSelect();
    }

    function renderTournaments() {
      if (listState.state === 'loading') return; // the skeleton stands in
      const skeleton = document.getElementById('loading-skeleton');
      if (skeleton) skeleton.style.display = 'none';
      listContainer.classList.remove('hidden');

      if (listState.state === 'failed') {
        listContainer.innerHTML = note('text-crimson-400', errorText(listState.error), true);
        return;
      }

      if (tournaments.length === 0) {
        listContainer.innerHTML = note('text-obsidian-500', t('tour.empty'));
        return;
      }

      listContainer.innerHTML = tournaments.map(tn => {
        const isOpen = tn.status === 'registration';
        const entryCount = tn.entry_count ?? 0;

        return `
          <div class="card-glass p-6 hover:border-gold-500/30 transition-colors">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="flex-1 min-w-0">
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mb-2">
                  <h3 class="font-display text-lg font-bold text-obsidian-200 break-words min-w-0"><bdi>${esc(tn.name)}</bdi></h3>
                  <span class="text-xs ${statusColor(tn.status)} px-2 py-0.5 rounded-full uppercase">
                    ${esc(statusName(tn.status))}
                  </span>
                </div>
                <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-obsidian-400">
                  <span>${esc(t('tour.label.format'))} <span class="text-obsidian-300">${esc(formatName(tn.format))}</span></span>
                  <span>${esc(t('tour.label.players'))} <span class="text-obsidian-300">${esc(t('tour.playersOf', { n: num(entryCount), max: num(tn.max_players) }))}</span></span>
                  <span>${esc(t('tour.label.starts'))} <span class="text-obsidian-300">${esc(dateTime(tn.starts_at))}</span></span>
                </div>
              </div>
              <div class="flex flex-wrap gap-2">
                ${isOpen ? `<button class="register-btn btn-primary text-xs px-4 py-2" data-id="${esc(tn.id)}">${esc(t('tour.register'))}</button>` : ''}
                <button class="view-bracket-btn text-xs text-obsidian-400 hover:text-gold-400 border border-obsidian-700 rounded-lg px-4 py-2 transition-colors" data-id="${esc(tn.id)}">
                  ${esc(t('tour.viewBracket'))}
                </button>
              </div>
            </div>
          </div>
        `;
      }).join('');

      // Register buttons
      listContainer.querySelectorAll('.register-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          if (!isLoggedIn()) { toast(t('tour.toast.signIn'), 'warning'); return; }
          const id = (btn as HTMLElement).dataset.id!;
          try {
            await registerForTournament(id);
            toast(t('tour.toast.registered'), 'success');
            loadTournaments();
          } catch (e) {
            toast(errorText(e), 'error');
          }
        });
      });

      // View bracket buttons
      listContainer.querySelectorAll('.view-bracket-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = (btn as HTMLElement).dataset.id!;
          bracketSelect.value = id;
          document.getElementById('tab-bracket')!.click();
          loadBracket(id);
        });
      });
    }

    function populateBracketSelect() {
      const chosen = bracketSelect.value;
      // Clear existing options except the placeholder
      while (bracketSelect.options.length > 1) bracketSelect.remove(1);
      tournaments.forEach(tn => {
        const opt = document.createElement('option');
        opt.value = tn.id;
        opt.textContent = t('tour.option', { name: tn.name, status: statusName(tn.status) });
        bracketSelect.appendChild(opt);
      });
      bracketSelect.value = chosen;
    }

    // Bracket view
    const bracketContainer = document.getElementById('bracket-container')!;
    const leaderboardSection = document.getElementById('leaderboard-section')!;
    const leaderboardTable = document.getElementById('leaderboard-table')!;

    type BracketState = { state: 'none' } | { state: 'loading' } | { state: 'ready'; matches: BracketMatch[] } | { state: 'missing' };
    let bracket: BracketState = { state: 'none' };
    let standings: LeaderboardEntry[] = [];

    bracketSelect.addEventListener('change', () => {
      if (bracketSelect.value) loadBracket(bracketSelect.value);
    });

    async function loadBracket(tournamentId: string) {
      bracket = { state: 'loading' };
      standings = [];
      renderBracket();
      renderLeaderboard();

      try {
        bracket = { state: 'ready', matches: await getBracket(tournamentId) };
      } catch {
        bracket = { state: 'missing' };
      }
      renderBracket();
      if (bracket.state === 'ready') loadLeaderboard(tournamentId);
    }

    function renderBracket() {
      if (bracket.state === 'none') {
        bracketContainer.innerHTML = note('text-obsidian-500', t('tour.selectHint'));
        return;
      }
      if (bracket.state === 'loading') {
        bracketContainer.innerHTML = `<div class="text-center py-12"><div class="w-6 h-6 border-2 border-gold-500 border-t-transparent rounded-full animate-spin mx-auto mb-3"></div><p class="text-sm text-obsidian-500">${esc(t('tour.bracket.loading'))}</p></div>`;
        return;
      }
      if (bracket.state === 'missing' || bracket.matches.length === 0) {
        bracketContainer.innerHTML = note('text-obsidian-500', t('tour.bracket.none'));
        return;
      }

      // Group by round
      const rounds = new Map<number, BracketMatch[]>();
      bracket.matches.forEach(m => {
        if (!rounds.has(m.round)) rounds.set(m.round, []);
        rounds.get(m.round)!.push(m);
      });

      const sortedRounds = [...rounds.entries()].sort((a, b) => a[0] - b[0]);
      const bye = t('tour.bye');

      // A row of rounds: it starts at the left in left-to-right languages and at the right in Arabic.
      bracketContainer.innerHTML = `
        <div class="flex gap-6 min-w-max py-4">
          ${sortedRounds.map(([roundNum, roundMatches]) => `
            <div class="flex flex-col gap-4 min-w-[220px]">
              <div class="text-center text-xs text-obsidian-500 uppercase tracking-wider mb-2">
                ${esc(t('tour.round', { n: num(roundNum) }))}
              </div>
              ${[...roundMatches].sort((a, b) => a.match_order - b.match_order).map(m => {
                const p1Won = m.winner_id && m.winner_id === m.player1_id;
                const p2Won = m.winner_id && m.winner_id === m.player2_id;
                // A bye is decided when the bracket is drawn: the player in it goes through.
                const done = m.status === 'completed' || m.status === 'bye';
                const state = m.status === 'in_progress' ? 'tour.match.live' : done ? 'tour.match.done' : 'tour.match.pending';
                // My match, with both players known and not decided: its room, judged by the server, decides it.
                const me = getCurrentUser()?.id;
                const mine = !!me && (m.player1_id === me || m.player2_id === me) && !!m.player1_id && !!m.player2_id && !done;
                const player = (name: string | null, won: unknown) => `
                    <div class="flex items-center justify-between gap-2 py-1 ${won ? 'text-gold-400 font-semibold' : 'text-obsidian-300'} text-sm">
                      <bdi>${esc(name || bye)}</bdi>
                      ${won ? '<span class="text-xs" aria-hidden="true">&#9733;</span>' : ''}
                    </div>`;

                return `
                  <div class="card-glass p-3 ${m.status === 'in_progress' ? 'border-purple-500/30' : ''}">
                    ${player(m.player1_name, p1Won)}
                    <div class="border-t border-obsidian-700/50 my-1"></div>
                    ${player(m.player2_name, p2Won)}
                    <div class="text-center mt-1">
                      <span class="text-[10px] uppercase ${m.status === 'in_progress' ? 'text-purple-400' : done ? 'text-obsidian-500' : 'text-obsidian-600'}">
                        ${esc(t(state))}
                      </span>
                    </div>
                    ${mine ? `<button class="play-match-btn btn-primary text-xs w-full mt-2 py-1.5" data-match="${esc(m.id)}">${esc(t('tour.play'))}</button>` : ''}
                  </div>
                `;
              }).join('')}
            </div>
          `).join('')}
        </div>
      `;
    }

    // Play my match: the server opens (or gives again) the match's room, and the duel is played there.
    bracketContainer.addEventListener('click', async (event) => {
      const btn = (event.target as HTMLElement).closest<HTMLButtonElement>('.play-match-btn');
      if (!btn || !bracketSelect.value) return;
      btn.disabled = true;
      try {
        const { room_id } = await openMatchRoom(bracketSelect.value, btn.dataset.match!);
        location.href = `/multiplayer?room=${encodeURIComponent(room_id)}`;
      } catch (e) {
        toast(errorText(e), 'error');
        btn.disabled = false;
      }
    });

    async function loadLeaderboard(tournamentId: string) {
      try {
        standings = await getLeaderboard(tournamentId);
      } catch {
        standings = [];
      }
      renderLeaderboard();
    }

    function renderLeaderboard() {
      if (standings.length === 0) {
        leaderboardSection.classList.add('hidden');
        return;
      }

      leaderboardSection.classList.remove('hidden');
      leaderboardTable.innerHTML = `
        <table class="w-full text-sm">
          <thead>
            <tr class="text-xs text-obsidian-500 uppercase tracking-wider border-b border-obsidian-700/50">
              <th scope="col" class="text-start px-4 py-3">${esc(t('tour.col.rank'))}</th>
              <th scope="col" class="text-start px-4 py-3">${esc(t('tour.col.player'))}</th>
              <th scope="col" class="text-center px-4 py-3">${esc(t('tour.col.wins'))}</th>
              <th scope="col" class="text-center px-4 py-3">${esc(t('tour.col.losses'))}</th>
              <th scope="col" class="text-center px-4 py-3">${esc(t('tour.col.status'))}</th>
            </tr>
          </thead>
          <tbody>
            ${[...standings].sort((a, b) => b.wins - a.wins || a.losses - b.losses).map((e, i) => `
              <tr class="border-b border-obsidian-800/50 ${e.eliminated ? 'opacity-50' : ''}">
                <td class="px-4 py-3 text-obsidian-500 font-mono">${esc(num(i + 1))}</td>
                <td class="px-4 py-3 text-obsidian-200 font-medium"><bdi>${esc(e.username)}</bdi></td>
                <td class="px-4 py-3 text-center text-emerald-400">${esc(num(e.wins))}</td>
                <td class="px-4 py-3 text-center text-crimson-400">${esc(num(e.losses))}</td>
                <td class="px-4 py-3 text-center">
                  <span class="text-xs ${e.eliminated ? 'text-crimson-400' : 'text-emerald-400'}">
                    ${esc(t(e.eliminated ? 'tour.entry.eliminated' : 'tour.entry.active'))}
                  </span>
                </td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      `;
    }

    /** Everything built with t(), drawn again. */
    function redraw() {
      renderTournaments();
      populateBracketSelect();
      renderBracket();
      renderLeaderboard();
    }

    // Nothing is drawn with t() before the language and this page's strings are in.
    initPage(['tournaments', 'shared'], { title: 'nav.tournaments', description: 'tour.meta.description' })
      .catch((e) => console.error('[tournaments] the language could not be loaded', e))
      .then(() => {
        redraw();
        onPageLocaleChange(redraw);
        loadTournaments();
      });
  </script>
</BaseLayout>
