---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CARD_CATALOG, RARITY_COLORS, type Card, type Rarity } from '../lib/cards';
---

<BaseLayout title="Playground" description="Earn digital cards through mini-games, trivia, challenges, and more. Build your Shakespeare collection.">

  <section class="section-padding">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gold-500/10 border border-gold-500/20 mb-6">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="text-gold-400 text-xs font-medium tracking-wide rtl:tracking-normal uppercase" data-i18n="pg.badge">Digital Playground</span>
        </div>
        <h1 class="text-4xl sm:text-5xl font-display font-bold mb-4">
          <span class="text-gradient" data-i18n="pg.title">The Playground</span>
        </h1>
        <p class="text-obsidian-400 max-w-2xl mx-auto" data-i18n="pg.intro">Earn digital cards through mini-games, trivia, and challenges. Every card you win is yours to keep, collect, and trade.</p>
      </div>

      <!-- Player Stats Bar -->
      <div class="card-glass p-4 mb-4 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-6 text-sm">
          <div>
            <span class="text-xs text-obsidian-500 block" data-i18n="pg.stat.cards">Cards Owned</span>
            <!-- A count out of a total reads left to right in every language: right to left, "0 / 71" was drawn 71 / 0. -->
            <span dir="ltr"><span id="stat-cards" class="text-lg font-display font-bold text-gold-400">0</span><span class="text-xs text-obsidian-500"> / {CARD_CATALOG.length}</span></span>
          </div>
          <div class="w-px h-8 bg-obsidian-700"></div>
          <div>
            <span class="text-xs text-obsidian-500 block" data-i18n="pg.stat.wins">Battle Wins</span>
            <span id="stat-wins" class="text-lg font-display font-bold text-crimson-400">0</span>
          </div>
          <div class="w-px h-8 bg-obsidian-700"></div>
          <div>
            <span class="text-xs text-obsidian-500 block" data-i18n="pg.stat.trivia">Trivia Score</span>
            <span id="stat-trivia" class="text-lg font-display font-bold text-emerald-400">0</span>
          </div>
        </div>
        <a href="/collection" class="btn-secondary text-xs" data-i18n="pg.viewCollection">View Collection</a>
      </div>

      <!-- Spending Limit Banner (teen users only) -->
      <div id="spending-limit-banner" class="hidden card-glass p-3 mb-6 border-gold-500/20 bg-gold-500/5 flex items-center justify-between gap-3">
        <div class="flex items-center gap-2 text-xs">
          <svg class="w-4 h-4 text-gold-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span class="text-obsidian-300"><span data-i18n="pg.spending">Daily spending:</span> <span dir="ltr"><strong id="spent-today" class="text-gold-400">0</strong> / <strong id="spend-limit" class="text-gold-400">200</strong></span> <span data-i18n="pg.credits">credits</span></span>
        </div>
        <div class="h-1.5 flex-1 max-w-[120px] rounded-full bg-obsidian-800 overflow-hidden">
          <div id="spending-bar" class="h-full rounded-full bg-gold-400 transition-all duration-300" style="width: 0%"></div>
        </div>
      </div>

      <!-- Acquisition Grid -->
      <div class="grid sm:grid-cols-2 gap-6 mb-12">

        <!-- Card Packs -->
        <div class="card-glass p-6 hover:border-gold-500/30 transition-all">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-lg bg-gold-500/10 border border-gold-500/20 flex items-center justify-center">
              <span class="text-xl">&#127183;</span>
            </div>
            <div>
              <h2 class="font-display text-lg font-bold text-obsidian-100" data-i18n="pg.packs.title">Card Packs</h2>
              <p class="text-xs text-obsidian-500" data-i18n="pg.packs.sub">Open packs to reveal cards</p>
            </div>
          </div>
          <div class="space-y-3">
            <button id="starter-pack-btn" class="w-full card-glass p-3 text-start hover:border-gold-500/30 transition-all flex items-center justify-between">
              <div>
                <span class="text-sm font-semibold text-gold-300" data-i18n="pg.starter.name">Starter Pack</span>
                <p class="text-xs text-obsidian-500" data-i18n="pg.starter.desc">3 cards to begin your collection</p>
              </div>
              <span id="starter-badge" class="text-xs px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30" data-i18n="pg.free">FREE</span>
            </button>
            <button id="daily-pack-btn" class="w-full card-glass p-3 text-start hover:border-gold-500/30 transition-all flex items-center justify-between">
              <div>
                <span class="text-sm font-semibold text-blue-300" data-i18n="pg.daily.name">Daily Pack</span>
                <p class="text-xs text-obsidian-500" data-i18n="pg.daily.desc">1 free card every 24 hours</p>
              </div>
              <span id="daily-badge" class="text-xs px-2 py-0.5 rounded-full bg-blue-500/20 text-blue-400 border border-blue-500/30" data-i18n="pg.free">FREE</span>
            </button>
          </div>
        </div>

        <!-- Pack Odds Disclosure -->
        <div class="col-span-full card-glass p-4 border-obsidian-700/50">
          <button id="odds-toggle" class="w-full flex items-center justify-between text-start">
            <span class="text-xs font-semibold text-obsidian-400 uppercase tracking-wide rtl:tracking-normal" data-i18n="pg.odds.title">Card Pack Drop Rates</span>
            <svg id="odds-chevron" class="w-4 h-4 text-obsidian-500 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </button>
          <div id="odds-content" class="hidden mt-4 space-y-4">
            <div>
              <h4 class="text-xs font-semibold text-obsidian-300 mb-2" data-i18n="pg.odds.rarity">Rarity Drop Rates</h4>
              <div class="space-y-1.5">
                <div class="flex items-center gap-3">
                  <span class="text-xs text-obsidian-400 w-24" data-i18n="rarity.common">Common</span>
                  <div class="flex-1 h-2 rounded-full bg-obsidian-800 overflow-hidden"><div class="h-full rounded-full bg-obsidian-500" style="width:50%"></div></div>
                  <span class="text-xs font-mono text-obsidian-400 w-10 text-end">50%</span>
                </div>
                <div class="flex items-center gap-3">
                  <span class="text-xs text-obsidian-400 w-24" data-i18n="rarity.uncommon">Uncommon</span>
                  <div class="flex-1 h-2 rounded-full bg-obsidian-800 overflow-hidden"><div class="h-full rounded-full bg-emerald-500/60" style="width:30%"></div></div>
                  <span class="text-xs font-mono text-obsidian-400 w-10 text-end">30%</span>
                </div>
                <div class="flex items-center gap-3">
                  <span class="text-xs text-obsidian-400 w-24" data-i18n="rarity.rare">Rare</span>
                  <div class="flex-1 h-2 rounded-full bg-obsidian-800 overflow-hidden"><div class="h-full rounded-full bg-blue-500/60" style="width:15%"></div></div>
                  <span class="text-xs font-mono text-obsidian-400 w-10 text-end">15%</span>
                </div>
                <div class="flex items-center gap-3">
                  <span class="text-xs text-obsidian-400 w-24" data-i18n="rarity.epic">Epic</span>
                  <div class="flex-1 h-2 rounded-full bg-obsidian-800 overflow-hidden"><div class="h-full rounded-full bg-purple-500/60" style="width:4%"></div></div>
                  <span class="text-xs font-mono text-obsidian-400 w-10 text-end">4%</span>
                </div>
                <div class="flex items-center gap-3">
                  <span class="text-xs text-obsidian-400 w-24" data-i18n="rarity.legendary">Legendary</span>
                  <div class="flex-1 h-2 rounded-full bg-obsidian-800 overflow-hidden"><div class="h-full rounded-full bg-gold-500/60" style="width:1%"></div></div>
                  <span class="text-xs font-mono text-obsidian-400 w-10 text-end">1%</span>
                </div>
              </div>
            </div>
            <div>
              <h4 class="text-xs font-semibold text-obsidian-300 mb-2" data-i18n="pg.odds.tiers">Pack Tiers (purchased with Credits)</h4>
              <div class="grid sm:grid-cols-3 gap-2">
                <div class="bg-obsidian-800/50 rounded-lg p-3">
                  <p class="text-xs font-semibold text-obsidian-200" data-i18n="pg.odds.standard">Standard Pack</p>
                  <p class="text-[10px] text-obsidian-500 mt-1" data-i18n="pg.odds.standardLine">3 cards &middot; 50 Credits</p>
                  <p class="text-[10px] text-obsidian-500" data-i18n="pg.odds.standardNote">Standard odds</p>
                </div>
                <div class="bg-obsidian-800/50 rounded-lg p-3 border border-blue-500/10">
                  <p class="text-xs font-semibold text-blue-300" data-i18n="pg.odds.rare">Rare Pack</p>
                  <p class="text-[10px] text-obsidian-500 mt-1" data-i18n="pg.odds.rareLine">5 cards &middot; 150 Credits</p>
                  <p class="text-[10px] text-blue-400" data-i18n="pg.odds.rareNote">1 Rare guaranteed</p>
                </div>
                <div class="bg-obsidian-800/50 rounded-lg p-3 border border-purple-500/10">
                  <p class="text-xs font-semibold text-purple-300" data-i18n="pg.odds.epic">Epic Pack</p>
                  <p class="text-[10px] text-obsidian-500 mt-1" data-i18n="pg.odds.epicLine">5 cards &middot; 400 Credits</p>
                  <p class="text-[10px] text-purple-400" data-i18n="pg.odds.epicNote">1 Epic guaranteed</p>
                </div>
              </div>
            </div>
            <p class="text-[10px] text-obsidian-600">
              <span data-i18n="pg.odds.note">All packs use Credits earned through gameplay. No real money purchases. Each card draw is independent.</span>
              <span data-i18n="pg.odds.moreBefore">For more details, see our</span> <a href="/terms" class="text-obsidian-500 hover:text-gold-400" data-i18n="footer.terms">Terms of Service</a><span data-i18n="pg.odds.moreAfter">.</span>
            </p>
          </div>
        </div>

        <!-- Battle Rewards -->
        <div class="card-glass p-6 hover:border-crimson-500/30 transition-all">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-lg bg-crimson-500/10 border border-crimson-500/20 flex items-center justify-center">
              <span class="text-xl">&#9876;</span>
            </div>
            <div>
              <h2 class="font-display text-lg font-bold text-obsidian-100" data-i18n="nav.battle">Battle Arena</h2>
              <p class="text-xs text-obsidian-500" data-i18n="pg.battle.sub">Win rap battles to earn cards</p>
            </div>
          </div>
          <p class="text-sm text-obsidian-400 mb-4" data-i18n="pg.battle.body">Challenge the Master Thespian in a Shakespeare rap battle. Win a round and earn a random card from the collection.</p>
          <a href="/battle" class="btn-danger text-sm w-full justify-center">
            <span data-i18n="pg.battle.cta">Enter the Arena</span>
            <svg class="w-4 h-4 ms-2 rtl:-scale-x-100" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
        </div>

        <!-- Trivia Mini-Game -->
        <div class="card-glass p-6 hover:border-emerald-500/30 transition-all">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center">
              <span class="text-xl">&#129504;</span>
            </div>
            <div>
              <h2 class="font-display text-lg font-bold text-obsidian-100" data-i18n="pg.trivia.title">Shakespeare Trivia</h2>
              <p class="text-xs text-obsidian-500" data-i18n="pg.trivia.sub">Test your knowledge, earn cards</p>
            </div>
          </div>
          <p class="text-sm text-obsidian-400 mb-4" data-i18n="pg.trivia.body">Answer 5 questions about Shakespeare. Score 3 or more to earn a card.</p>
          <button id="trivia-start-btn" class="btn-primary text-sm w-full justify-center" data-i18n="pg.trivia.start">Start Trivia</button>
        </div>

        <!-- Quote Challenge -->
        <div class="card-glass p-6 hover:border-purple-500/30 transition-all">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-lg bg-purple-500/10 border border-purple-500/20 flex items-center justify-center">
              <span class="text-xl">&#128220;</span>
            </div>
            <div>
              <h2 class="font-display text-lg font-bold text-obsidian-100" data-i18n="pg.challenge.title">Quote Challenge</h2>
              <p class="text-xs text-obsidian-500" data-i18n="pg.challenge.sub">Complete the famous quote</p>
            </div>
          </div>
          <p class="text-sm text-obsidian-400 mb-4" data-i18n="pg.challenge.body">Fill in the missing words from a Shakespeare quote. Get it right, earn a card.</p>
          <button id="challenge-start-btn" class="btn-secondary text-sm w-full justify-center border-purple-500/30 text-purple-300 hover:bg-purple-500/10" data-i18n="pg.challenge.start">Start Challenge</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Onboarding Overlay -->
  <div id="onboarding-overlay" class="fixed inset-0 bg-obsidian-950/80 z-90 hidden items-center justify-center">
    <div id="onboarding-tooltip" class="absolute bg-obsidian-900 border border-gold-500/40 rounded-xl p-5 max-w-xs shadow-2xl shadow-gold-500/10 transition-all duration-500">
      <div class="flex items-center gap-2 mb-2">
        <!-- A step out of the total reads left to right in every language: right to left, "1 / 3" would read 3 / 1. -->
        <span id="onboarding-step" dir="ltr" class="text-xs font-mono text-gold-500/60">1 / 3</span>
      </div>
      <h4 id="onboarding-title" class="font-display font-bold text-gold-300 mb-1"></h4>
      <p id="onboarding-desc" class="text-sm text-obsidian-300 mb-4"></p>
      <div class="flex items-center justify-between">
        <button id="onboarding-skip" class="text-xs text-obsidian-500 hover:text-obsidian-300 transition-colors" data-i18n="pg.onb.skip">Skip</button>
        <button id="onboarding-next" class="btn-primary text-xs px-4 py-2" data-i18n="pg.onb.next">Next</button>
      </div>
      <!-- Arrow pointer -->
      <div id="onboarding-arrow" class="absolute w-3 h-3 bg-obsidian-900 border-gold-500/40 transform rotate-45"></div>
    </div>
  </div>

  <!-- Trivia Modal -->
  <div id="trivia-modal" role="dialog" aria-modal="true" aria-label="Shakespeare Trivia" data-i18n-aria-label="pg.trivia.title" class="fixed inset-0 bg-obsidian-950/90 z-50 hidden flex items-center justify-center p-4">
    <div class="card-glass max-w-lg w-full p-6 max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between mb-6">
        <h3 class="font-display text-xl font-bold text-gold-300" data-i18n="pg.trivia.title">Shakespeare Trivia</h3>
        <button id="trivia-close" class="text-obsidian-500 hover:text-obsidian-200 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div class="mb-4 flex items-center gap-2">
        <span id="trivia-progress" class="text-xs font-mono rtl:font-sans text-obsidian-500"></span>
        <div class="flex-1 h-1 rounded-full bg-obsidian-800 overflow-hidden">
          <div id="trivia-bar" class="h-full bg-gold-400 rounded-full transition-all duration-300" style="width: 20%"></div>
        </div>
        <span id="trivia-score-display" class="text-xs font-mono rtl:font-sans text-emerald-400"></span>
      </div>
      <div id="trivia-content">
        <!-- Populated by JS -->
      </div>
    </div>
  </div>

  <!-- Challenge Modal -->
  <div id="challenge-modal" role="dialog" aria-modal="true" aria-label="Quote Challenge" data-i18n-aria-label="pg.challenge.title" class="fixed inset-0 bg-obsidian-950/90 z-50 hidden flex items-center justify-center p-4">
    <div class="card-glass max-w-lg w-full p-6">
      <div class="flex items-center justify-between mb-6">
        <h3 class="font-display text-xl font-bold text-purple-300" data-i18n="pg.challenge.title">Quote Challenge</h3>
        <button id="challenge-close" class="text-obsidian-500 hover:text-obsidian-200 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div id="challenge-content">
        <!-- Populated by JS -->
      </div>
    </div>
  </div>

  <!-- Card Reveal Modal -->
  <div id="reveal-modal" class="fixed inset-0 bg-obsidian-950/90 z-50 hidden flex items-center justify-center p-4">
    <div class="card-glass max-w-md w-full p-8 text-center">
      <h3 id="reveal-title" class="font-display text-2xl font-bold text-gold-300 mb-6" data-i18n="pg.reveal.title">Card Revealed!</h3>
      <div id="reveal-cards" class="space-y-4">
        <!-- Populated by JS -->
      </div>
      <button id="reveal-close" class="btn-primary mt-6" data-i18n="pg.collect">Collect</button>
    </div>
  </div>

  <script>
    import { CARD_CATALOG, RARITY_COLORS, drawRandomCard, drawPack, type Card, type Rarity } from '../lib/cards';
    import {
      addCard, getStats, isStarterClaimed, claimStarter,
      isDailyAvailable, claimDaily, recordTriviaCorrect, recordChallengeComplete,
    } from '../lib/inventory';
    import { type TriviaQuestion } from '../lib/trivia';
    import { answersMatch, localRandomChallenge, localRandomQuestions, type LocalChallenge } from '../lib/play-content';
    import { has, initI18n, isRtl, loadArea, locale, onLocaleChange, applyTranslations, t } from '../i18n';
    import { initAudio, isInitialized, playSfx, playRarityFanfare, preloadSfx, type Rarity as AudioRarity } from '../lib/audio-manager';
    import { isContentGenAvailable, generateTriviaSet, generateChallenge } from '../lib/content-gen';
    import { brainInfo } from '../lib/brain';
    import { aiAttributes, type MarkedModel } from '../lib/ai-marking';
    import { incrementStat, syncCardStats, getPlayerStats } from '../lib/achievements';
    import { getUniqueOwnedCount, getOwnedCards, getOwnedCardIds } from '../lib/inventory';
    import { awardRandomVariant, CITY_CATALOG } from '../lib/variants';

    // --- Language ---
    // The page's strings are a page area (src/i18n/pages/playground). Everything below
    // waits for it (`ready`), and what was drawn with t() is drawn again when the language changes.
    const esc = (v: unknown) => String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
    const rarityName = (r: string) => (has(`rarity.${r.toLowerCase()}`) ? t(`rarity.${r.toLowerCase()}`) : r);
    const redraw: Array<() => void> = [];
    async function useLanguage() {
      await loadArea('playground');
      applyTranslations();
      document.title = `${t('pg.meta.title')} | Inspired Mile`;
      document.querySelector('meta[name="description"]')?.setAttribute('content', t('pg.meta.description'));
      for (const fn of redraw) fn();
      // Says which language the page's own strings are now in (until then the markup's English shows).
      document.documentElement.dataset.pageArea = locale();
    }
    const ready = initI18n().then(useLanguage);
    onLocaleChange(() => void useLanguage());

    // --- Spending limit check (teen users) ---
    async function checkSpendingLimits() {
      try {
        const res = await fetch('/api/v1/credits/limits', { credentials: 'include' });
        if (!res.ok) return;
        const data = await res.json();
        if (data.daily_limit !== null) {
          const banner = document.getElementById('spending-limit-banner');
          const spentEl = document.getElementById('spent-today');
          const bar = document.getElementById('spending-bar');
          if (banner && spentEl && bar) {
            banner.classList.remove('hidden');
            spentEl.textContent = String(data.spent_today);
            const limitEl = document.getElementById('spend-limit');
            if (limitEl) limitEl.textContent = String(data.daily_limit);
            const pct = Math.min(100, (data.spent_today / data.daily_limit) * 100);
            bar.style.width = `${pct}%`;
            if (pct >= 100) {
              bar.classList.remove('bg-gold-400');
              bar.classList.add('bg-crimson-400');
            } else if (pct >= 75) {
              bar.classList.remove('bg-gold-400');
              bar.classList.add('bg-orange-400');
            }
          }
        }
      } catch { /* not logged in or server unreachable */ }
    }
    checkSpendingLimits();

    // Sound starts on the first interaction. Effects only: the playground's music had no traced
    // source and was removed (D-08).
    document.addEventListener('click', () => {
      if (!isInitialized()) initAudio();
      preloadSfx(['pack-open', 'fanfare-common', 'fanfare-rare', 'fanfare-legendary', 'trivia-correct', 'trivia-wrong', 'challenge-win', 'challenge-lose', 'ui-click']);
    }, { once: true });

    // --- Pack Odds Toggle ---
    document.getElementById('odds-toggle')?.addEventListener('click', () => {
      const content = document.getElementById('odds-content')!;
      const chevron = document.getElementById('odds-chevron')!;
      content.classList.toggle('hidden');
      chevron.classList.toggle('rotate-180');
    });

    // --- Stats ---
    function updateStats() {
      const stats = getStats();
      document.getElementById('stat-cards')!.textContent = String(stats.uniqueCards);
      document.getElementById('stat-wins')!.textContent = String(stats.battleWins);
      document.getElementById('stat-trivia')!.textContent = String(stats.triviaCorrect);
    }
    updateStats();

    // --- Card Packs ---
    const starterBtn = document.getElementById('starter-pack-btn')!;
    const starterBadge = document.getElementById('starter-badge')!;
    const dailyBtn = document.getElementById('daily-pack-btn')!;
    const dailyBadge = document.getElementById('daily-badge')!;

    function markClaimed(badge: HTMLElement, btn: HTMLElement) {
      badge.dataset.i18n = 'pg.claimed';
      badge.textContent = has('pg.claimed') ? t('pg.claimed') : 'CLAIMED'; // before the area has loaded
      badge.className = 'text-xs px-2 py-0.5 rounded-full bg-obsidian-700/50 text-obsidian-500 border border-obsidian-700';
      btn.classList.add('opacity-50', 'pointer-events-none');
    }

    if (isStarterClaimed()) markClaimed(starterBadge, starterBtn);
    if (!isDailyAvailable()) markClaimed(dailyBadge, dailyBtn);

    starterBtn.addEventListener('click', () => {
      if (isStarterClaimed()) return;
      const cards = drawPack(3);
      cards.forEach(c => addCard(c.id, 'starter'));
      claimStarter();
      incrementStat('packsOpened');
      syncCardStats(getUniqueOwnedCount(), getOwnedCards().length);
      markClaimed(starterBadge, starterBtn);
      playSfx('pack-open');
      showReveal(t('pg.reveal.starter'), cards);
      const bestRarity = cards.reduce((best, c) => {
        const order = ['Common', 'Uncommon', 'Rare', 'Epic', 'Legendary'];
        return order.indexOf(c.rarity) > order.indexOf(best) ? c.rarity : best;
      }, cards[0].rarity);
      setTimeout(() => playRarityFanfare(bestRarity as AudioRarity), 600);
      updateStats();
    });

    dailyBtn.addEventListener('click', () => {
      if (!isDailyAvailable()) return;
      const card = drawRandomCard();
      addCard(card.id, 'daily');
      claimDaily();
      incrementStat('packsOpened');
      syncCardStats(getUniqueOwnedCount(), getOwnedCards().length);
      markClaimed(dailyBadge, dailyBtn);
      playSfx('pack-open');
      showReveal(t('pg.reveal.daily'), [card]);
      setTimeout(() => playRarityFanfare(card.rarity as AudioRarity), 600);
      updateStats();
    });

    // --- Card Reveal ---
    const revealModal = document.getElementById('reveal-modal')!;
    const revealTitle = document.getElementById('reveal-title')!;
    const revealCards = document.getElementById('reveal-cards')!;
    const revealClose = document.getElementById('reveal-close')!;

    function showReveal(title: string, cards: Card[]) {
      revealTitle.removeAttribute('data-i18n'); // this title is this pack's, not the static one
      revealTitle.textContent = title;
      revealCards.innerHTML = cards.map(card => {
        const rarityClass = RARITY_COLORS[card.rarity as Rarity] || '';
        const artHtml = card.image
          ? `<img src="${card.image}" alt="${card.name}" class="w-16 h-16 object-cover rounded-lg">`
          : `<div class="text-3xl">${card.icon}</div>`;
        return `
          <div class="card-glass p-4 bg-linear-to-br ${card.gradient} ${card.border} animate-float" style="animation-delay: ${Math.random() * 0.5}s">
            <div class="flex items-center gap-4">
              ${artHtml}
              <div class="text-start">
                <h4 class="font-display font-bold text-obsidian-100">${card.name}</h4>
                <p class="text-xs text-obsidian-400">${card.house} &middot; ${card.element}</p>
                <span class="inline-block mt-1 px-2 py-0.5 text-xs rounded-full ${rarityClass}">${rarityName(card.rarity)}</span>
              </div>
            </div>
          </div>
        `;
      }).join('');
      revealModal.classList.remove('hidden');
    }

    revealClose.addEventListener('click', () => {
      revealModal.classList.add('hidden');
    });

    // --- Trivia ---
    const triviaModal = document.getElementById('trivia-modal')!;
    const triviaClose = document.getElementById('trivia-close')!;
    const triviaContent = document.getElementById('trivia-content')!;
    const triviaProgress = document.getElementById('trivia-progress')!;
    const triviaBar = document.getElementById('trivia-bar')!;
    const triviaScoreDisplay = document.getElementById('trivia-score-display')!;
    const triviaStartBtn = document.getElementById('trivia-start-btn')!;

    let triviaQuestions: TriviaQuestion[] = [];
    let triviaIndex = 0;
    let triviaScore = 0;
    /** Questions the model wrote for this round (English only; see content-gen.ts). */
    let triviaFromModel = new Set<TriviaQuestion>();
    /** The model that wrote them: each is marked with it (src/lib/ai-marking.ts). */
    let triviaModel: MarkedModel | null = null;
    /** The language this round's questions are in; a round is finished in the language it began in. */
    let triviaLocale = locale();

    function triviaHeader() {
      if (triviaModal.classList.contains('hidden')) return;
      const total = triviaQuestions.length;
      if (total && triviaIndex >= total) {
        triviaProgress.textContent = t('pg.trivia.complete');
        // U+2066 LEFT-TO-RIGHT ISOLATE ... U+2069: the score out of the total reads left to right in a right-to-left page too.
        triviaScoreDisplay.textContent = `\u2066${triviaScore} / ${total}\u2069`;
      } else {
        triviaProgress.textContent = t('pg.trivia.progress', { n: Math.min(triviaIndex + 1, total || 5), total: total || 5 });
        triviaScoreDisplay.textContent = t('pg.trivia.correct', { n: triviaScore });
      }
    }
    redraw.push(triviaHeader);

    triviaStartBtn.addEventListener('click', async () => {
      await ready;
      playSfx('ui-click');
      triviaIndex = 0;
      triviaScore = 0;
      triviaQuestions = [];
      triviaFromModel = new Set();
      triviaLocale = locale();
      triviaModal.classList.remove('hidden');
      triviaHeader();

      // The model writes questions in English only: nothing has checked what it writes in another
      // language. Every other language plays the bank, whose translations have been checked.
      if (isContentGenAvailable(triviaLocale)) {
        triviaContent.innerHTML = `
          <div class="text-center py-8">
            <div class="text-2xl mb-3 animate-pulse">&#129504;</div>
            <p class="text-sm text-obsidian-400">${esc(t('pg.trivia.generating'))}</p>
          </div>
        `;
        const aiQuestions = await generateTriviaSet(5);
        if (aiQuestions.length >= 3) {
          triviaQuestions = aiQuestions;
          triviaFromModel = new Set(aiQuestions);
          triviaModel = brainInfo();
          // Pad with the bank if the model wrote fewer than 5
          if (triviaQuestions.length < 5) {
            triviaQuestions.push(...(await localRandomQuestions(5 - triviaQuestions.length, triviaLocale)));
          }
        } else {
          triviaQuestions = await localRandomQuestions(5, triviaLocale);
        }
      } else {
        triviaQuestions = await localRandomQuestions(5, triviaLocale);
      }

      showTriviaQuestion();
    });

    triviaClose.addEventListener('click', () => {
      triviaModal.classList.add('hidden');
    });

    function showTriviaQuestion() {
      if (triviaIndex >= triviaQuestions.length) {
        showTriviaResult();
        return;
      }

      const q = triviaQuestions[triviaIndex];
      triviaBar.style.width = `${((triviaIndex + 1) / triviaQuestions.length) * 100}%`;
      triviaHeader();

      const aiBadge = triviaFromModel.has(q)
        ? `<span class="inline-block px-2 py-0.5 text-xs rounded-full bg-purple-500/20 text-purple-400 border border-purple-500/20 ms-2" data-i18n="pg.trivia.aiBadge">${esc(t('pg.trivia.aiBadge'))}</span>`
        : '';

      // The direction of the question's own language, not dir="auto": a question keeps its direction when the
      // interface has since changed language, and an Arabic option that opens with a name in Latin letters
      // ("Portia في تاجر البندقية") is still right to left (dir="auto" took the first letter's: left to right).
      const qLang = triviaFromModel.has(q) ? 'en' : triviaLocale;
      const qDir = isRtl(qLang) ? 'rtl' : 'ltr';
      // A question the model wrote, and its answers, carry the machine-readable mark as well as the badge.
      const mark = aiAttributes(triviaFromModel.has(q) ? triviaModel : null, esc);
      triviaContent.innerHTML = `
        <p id="trivia-question" lang="${qLang}" dir="${qDir}" class="text-sm text-obsidian-200 mb-4 leading-relaxed"${mark}>${esc(q.question)}${aiBadge}</p>
        <div class="space-y-2" lang="${qLang}" dir="${qDir}"${mark}>
          ${q.options.map((opt, i) => `
            <button dir="${qDir}" class="trivia-option w-full text-start card-glass p-3 text-sm text-obsidian-200 hover:border-gold-500/30 transition-all" data-index="${i}">${esc(opt)}</button>
          `).join('')}
        </div>
      `;

      triviaContent.querySelectorAll('.trivia-option').forEach(btn => {
        btn.addEventListener('click', () => {
          const selected = parseInt((btn as HTMLElement).dataset.index || '0');
          const correct = selected === q.correctIndex;

          // Highlight correct/wrong
          triviaContent.querySelectorAll('.trivia-option').forEach((b, i) => {
            const el = b as HTMLElement;
            el.classList.add('pointer-events-none');
            if (i === q.correctIndex) {
              el.classList.add('border-emerald-500/50', 'bg-emerald-500/10');
            } else if (i === selected && !correct) {
              el.classList.add('border-crimson-500/50', 'bg-crimson-500/10');
            }
          });

          if (correct) {
            triviaScore++;
            recordTriviaCorrect();
            incrementStat('triviaCorrect');
            playSfx('trivia-correct');
          } else {
            playSfx('trivia-wrong');
          }

          setTimeout(() => {
            triviaIndex++;
            showTriviaQuestion();
          }, 1200);
        });
      });
    }

    function showTriviaResult() {
      triviaBar.style.width = '100%';
      triviaHeader();

      const won = triviaScore >= 3;
      if (triviaScore === triviaQuestions.length) {
        incrementStat('triviaPerfect');
        // Award a World Card variant for perfect trivia
        const variant = awardRandomVariant(getOwnedCardIds(), 'trivia-mastery');
        if (variant) {
          setTimeout(() => {
            const axis = has(`criterion.${variant.ability.axis}`) ? t(`criterion.${variant.ability.axis}`) : variant.ability.axis;
            (window as any).showToast(t('pg.worldCard', { city: variant.city, bonus: variant.ability.bonus, axis }), 'success', 5000);
          }, 1500);
        }
      }

      if (won) {
        const card = drawRandomCard();
        addCard(card.id, 'trivia');
        syncCardStats(getUniqueOwnedCount(), getOwnedCards().length);
        updateStats();
        playSfx('challenge-win');
        setTimeout(() => playRarityFanfare(card.rarity as AudioRarity), 400);

        const rarityClass = RARITY_COLORS[card.rarity as Rarity] || '';
        triviaContent.innerHTML = `
          <div class="text-center">
            <div class="text-4xl mb-3">&#127881;</div>
            <p class="text-lg font-display font-bold text-emerald-400 mb-2">${esc(t('pg.trivia.won', { n: triviaScore, total: triviaQuestions.length }))}</p>
            <p class="text-sm text-obsidian-400 mb-4" data-i18n="pg.earned">${esc(t('pg.earned'))}</p>
            <div class="card-glass p-4 bg-linear-to-br ${card.gradient} ${card.border} inline-block">
              ${card.image ? `<img src="${card.image}" alt="${card.name}" class="w-20 h-20 object-cover rounded-lg mx-auto mb-2">` : `<div class="text-3xl mb-2">${card.icon}</div>`}
              <h4 class="font-display font-bold text-obsidian-100">${card.name}</h4>
              <span class="inline-block mt-1 px-2 py-0.5 text-xs rounded-full ${rarityClass}">${rarityName(card.rarity)}</span>
            </div>
            <button class="btn-primary mt-4 w-full" onclick="document.getElementById('trivia-modal').classList.add('hidden')" data-i18n="pg.collect">${esc(t('pg.collect'))}</button>
          </div>
        `;
      } else {
        playSfx('challenge-lose');
        triviaContent.innerHTML = `
          <div class="text-center">
            <div class="text-4xl mb-3">&#128172;</div>
            <p class="text-lg font-display font-bold text-crimson-400 mb-2">${esc(t('pg.trivia.lost', { n: triviaScore, total: triviaQuestions.length }))}</p>
            <p class="text-sm text-obsidian-400 mb-4" data-i18n="pg.trivia.need">${esc(t('pg.trivia.need'))}</p>
            <button class="btn-secondary mt-2 w-full" onclick="document.getElementById('trivia-modal').classList.add('hidden')" data-i18n="pg.close">${esc(t('pg.close'))}</button>
          </div>
        `;
      }
    }

    // --- Quote Challenge ---
    const challengeModal = document.getElementById('challenge-modal')!;
    const challengeClose = document.getElementById('challenge-close')!;
    const challengeContent = document.getElementById('challenge-content')!;
    const challengeStartBtn = document.getElementById('challenge-start-btn')!;

    /** The model that wrote the challenge on screen, or null for one from the bank. */
    let challengeModel: MarkedModel | null = null;

    challengeStartBtn.addEventListener('click', async () => {
      await ready;
      playSfx('ui-click');
      challengeModal.classList.remove('hidden');
      const l = locale();

      let challenge: LocalChallenge;

      // As with trivia: the model writes challenges in English only.
      if (isContentGenAvailable(l)) {
        challengeContent.innerHTML = `
          <div class="text-center py-8">
            <div class="text-2xl mb-3 animate-pulse">&#128220;</div>
            <p class="text-sm text-obsidian-400">${esc(t('pg.challenge.crafting'))}</p>
          </div>
        `;
        const aiChallenge = await generateChallenge();
        challenge = aiChallenge ? { ...aiChallenge, id: -1, lang: 'en' } : await localRandomChallenge(l);
        challengeModel = aiChallenge ? brainInfo() : null;
      } else {
        challenge = await localRandomChallenge(l);
        challengeModel = null;
      }

      showChallenge(challenge);
    });

    challengeClose.addEventListener('click', () => {
      challengeModal.classList.add('hidden');
    });

    function showChallenge(challenge: LocalChallenge) {
      // A line in a language other than the interface's is Shakespeare's own English: say so.
      const original = challenge.lang === 'en' && locale() !== 'en';
      const source = `${esc(challenge.play)} — ${esc(challenge.character)}`;
      // The heading's language can differ from the line's: an English original is headed in the interface language
      // where the names table has the play and the speaker (src/lib/play-content.ts).
      const sourceLang = challenge.headingLang ?? challenge.lang;
      const sourceAttrs = `lang="${sourceLang}" dir="${isRtl(sourceLang) ? 'rtl' : 'ltr'}"`;
      const lineAttrs = `lang="${challenge.lang}" dir="${isRtl(challenge.lang) ? 'rtl' : 'ltr'}"`;
      const credit = challenge.translator
        ? `<p class="text-xs text-obsidian-500 mt-1" data-challenge-credit>${esc(t('pg.challenge.translator', { translator: challenge.translator }))}</p>`
        : '';

      challengeContent.innerHTML = `
        <div class="mb-4">
          <p class="text-xs text-obsidian-500 mb-1" data-challenge-source ${sourceAttrs}>${source}</p>
          <span class="inline-block px-2 py-0.5 text-xs rounded-full ${
            challenge.difficulty === 'easy' ? 'bg-emerald-500/20 text-emerald-400' :
            challenge.difficulty === 'medium' ? 'bg-gold-500/20 text-gold-400' :
            'bg-crimson-500/20 text-crimson-400'
          }" data-i18n="pg.difficulty.${challenge.difficulty}">${esc(t(`pg.difficulty.${challenge.difficulty}`))}</span>
          ${original ? `<span class="inline-block px-2 py-0.5 text-xs rounded-full bg-obsidian-700/50 text-obsidian-300 ms-1" data-i18n="pg.challenge.original">${esc(t('pg.challenge.original'))}</span>` : ''}
          ${challengeModel ? `<span class="inline-block px-2 py-0.5 text-xs rounded-full bg-purple-500/20 text-purple-400 border border-purple-500/20 ms-1" data-i18n="pg.trivia.aiBadge">${esc(t('pg.trivia.aiBadge'))}</span>` : ''}
        </div>
        <p id="challenge-quote" ${lineAttrs} class="text-lg text-obsidian-200 font-display leading-relaxed mb-2 italic"${aiAttributes(challengeModel, esc)}>
          "${esc(challenge.displayQuote)}"
        </p>
        ${credit}
        <div class="space-y-3 mb-4 mt-4">
          ${challenge.missingWords.map((_, i) => `
            <div class="flex items-center gap-2">
              <span class="text-xs text-obsidian-500 w-16" data-blank="${i + 1}">${esc(t('pg.challenge.blank', { n: i + 1 }))}</span>
              <input type="text" ${lineAttrs} autocapitalize="off" autocomplete="off" spellcheck="false" class="challenge-input flex-1 bg-obsidian-800 border border-obsidian-700 rounded-lg px-3 py-2 text-sm text-obsidian-100 placeholder-obsidian-500 focus:outline-hidden focus:border-purple-500/50 transition-colors" placeholder="${esc(t('pg.challenge.placeholder'))}" data-i18n-placeholder="pg.challenge.placeholder" data-index="${i}" />
            </div>
          `).join('')}
        </div>
        <button id="challenge-submit" class="btn-primary w-full" data-i18n="pg.challenge.check">${esc(t('pg.challenge.check'))}</button>
        <p class="text-xs text-obsidian-500 mt-2 text-center" data-i18n="pg.challenge.hint">${esc(t('pg.challenge.hint'))}</p>
      `;

      document.getElementById('challenge-submit')!.addEventListener('click', () => {
        const inputs = challengeContent.querySelectorAll('.challenge-input') as NodeListOf<HTMLInputElement>;
        const answers = Array.from(inputs).map(i => i.value);
        const correct = answersMatch(challenge.missingWords, answers, challenge.lang);

        if (correct) {
          recordChallengeComplete();
          incrementStat('challengesCompleted');
          const card = drawRandomCard();
          addCard(card.id, 'challenge');
          syncCardStats(getUniqueOwnedCount(), getOwnedCards().length);
          updateStats();
          playSfx('challenge-win');
          setTimeout(() => playRarityFanfare(card.rarity as AudioRarity), 400);

          const rarityClass = RARITY_COLORS[card.rarity as Rarity] || '';
          challengeContent.innerHTML = `
            <div class="text-center">
              <div class="text-4xl mb-3">&#127881;</div>
              <p class="text-sm text-obsidian-400 mb-2" data-i18n="pg.challenge.full">${esc(t('pg.challenge.full'))}</p>
              <p class="text-sm text-obsidian-200 italic mb-4" ${lineAttrs}>"${esc(challenge.fullQuote)}"</p>
              <p class="text-lg font-display font-bold text-emerald-400 mb-4" data-i18n="pg.challenge.correct">${esc(t('pg.challenge.correct'))}</p>
              <div class="card-glass p-4 bg-linear-to-br ${card.gradient} ${card.border} inline-block">
                ${card.image ? `<img src="${card.image}" alt="${card.name}" class="w-20 h-20 object-cover rounded-lg mx-auto mb-2">` : `<div class="text-3xl mb-2">${card.icon}</div>`}
                <h4 class="font-display font-bold text-obsidian-100">${card.name}</h4>
                <span class="inline-block mt-1 px-2 py-0.5 text-xs rounded-full ${rarityClass}">${rarityName(card.rarity)}</span>
              </div>
              <button class="btn-primary mt-4 w-full" onclick="document.getElementById('challenge-modal').classList.add('hidden')" data-i18n="pg.collect">${esc(t('pg.collect'))}</button>
            </div>
          `;
        } else {
          playSfx('challenge-lose');
          challengeContent.innerHTML = `
            <div class="text-center">
              <div class="text-4xl mb-3">&#128172;</div>
              <p class="text-lg font-display font-bold text-crimson-400 mb-2" data-i18n="pg.challenge.wrong">${esc(t('pg.challenge.wrong'))}</p>
              <p class="text-sm text-obsidian-400 mb-2" data-i18n="pg.challenge.answer">${esc(t('pg.challenge.answer'))}</p>
              <p class="text-sm text-obsidian-200 italic mb-4" ${lineAttrs}>"${esc(challenge.fullQuote)}"</p>
              <p class="text-xs text-obsidian-500 mb-4" ${sourceAttrs}>${source}</p>
              <button class="btn-secondary w-full" onclick="document.getElementById('challenge-modal').classList.add('hidden')" data-i18n="pg.challenge.later">${esc(t('pg.challenge.later'))}</button>
            </div>
          `;
        }
      });
    }
    // Blank labels carry a number, which data-i18n cannot fill: relabel them on a change of language.
    redraw.push(() => {
      challengeContent.querySelectorAll<HTMLElement>('[data-blank]').forEach((el) => {
        el.textContent = t('pg.challenge.blank', { n: Number(el.dataset.blank) });
      });
    });
    // --- Onboarding ---
    const ONBOARDING_KEY = 'inspired-mile-onboarding-done';

    function startOnboarding() {
      if (localStorage.getItem(ONBOARDING_KEY)) return;

      const overlay = document.getElementById('onboarding-overlay')!;
      const tooltip = document.getElementById('onboarding-tooltip')!;
      const arrow = document.getElementById('onboarding-arrow')!;
      const title = document.getElementById('onboarding-title')!;
      const desc = document.getElementById('onboarding-desc')!;
      const step = document.getElementById('onboarding-step')!;
      const nextBtn = document.getElementById('onboarding-next')!;
      const skipBtn = document.getElementById('onboarding-skip')!;

      const steps = [
        { target: '#starter-pack-btn', title: 'pg.onb.1.title', desc: 'pg.onb.1.desc', position: 'bottom' as const },
        { target: '#trivia-start-btn', title: 'pg.onb.2.title', desc: 'pg.onb.2.desc', position: 'top' as const },
        { target: 'a[href="/battle"].btn-danger', title: 'pg.onb.3.title', desc: 'pg.onb.3.desc', position: 'top' as const },
      ];

      let currentStep = 0;
      /** Stops placing the open step's tooltip (its listeners are removed). */
      let reposition: (() => void) | null = null;

      function showStep(i: number) {
        if (i >= steps.length) {
          finishOnboarding();
          return;
        }

        const s = steps[i];
        const target = document.querySelector(s.target) as HTMLElement;
        if (!target) { finishOnboarding(); return; }

        step.textContent = `${i + 1} / ${steps.length}`;
        // Keys on the elements, so a change of language relabels the open step.
        title.dataset.i18n = s.title;
        desc.dataset.i18n = s.desc;
        nextBtn.dataset.i18n = i === steps.length - 1 ? 'pg.onb.done' : 'pg.onb.next';
        applyTranslations(tooltip);

        // Highlight target element
        target.style.position = 'relative';
        target.style.zIndex = '91';
        target.style.boxShadow = '0 0 0 4px rgba(212,175,55,0.4), 0 0 20px rgba(212,175,55,0.2)';
        target.style.borderRadius = '12px';

        // The overlay is fixed, so the tooltip is placed in the viewport: after the target has been scrolled
        // into view (at once, so its box is where it will stay), from the tooltip's measured size, beside the
        // target where there is room and never outside the screen. At phone width the second target is far
        // below the fold; placed from page coordinates before the scroll, the tooltip landed off-screen.
        target.scrollIntoView({ block: 'center', behavior: 'instant' as ScrollBehavior });
        const place = () => {
          const rect = target.getBoundingClientRect();
          const pad = 16;
          const w = tooltip.offsetWidth || 288, h = tooltip.offsetHeight || 160;
          const left = Math.max(pad, Math.min(rect.left + rect.width / 2 - w / 2, window.innerWidth - w - pad));
          const below = rect.bottom + pad, above = rect.top - pad - h;
          const fitsBelow = below + h <= window.innerHeight - pad, fitsAbove = above >= pad;
          const wantBelow = s.position === 'bottom' ? fitsBelow || !fitsAbove : !fitsAbove && fitsBelow;
          const top = Math.max(pad, Math.min(wantBelow ? below : above, window.innerHeight - h - pad));
          tooltip.style.top = `${top}px`;
          tooltip.style.left = `${left}px`;
          // The arrow on the side that faces the target, under the target's middle.
          const edge = '1px solid rgba(212,175,55,0.4)';
          arrow.style.left = `${Math.max(14, Math.min(rect.left + rect.width / 2 - left, w - 14))}px`;
          arrow.style.transform = 'translateX(-50%) rotate(45deg)';
          if (wantBelow) Object.assign(arrow.style, { top: '-6px', bottom: 'auto', borderTop: edge, borderLeft: edge, borderBottom: 'none', borderRight: 'none' });
          else Object.assign(arrow.style, { top: 'auto', bottom: '-6px', borderBottom: edge, borderRight: edge, borderTop: 'none', borderLeft: 'none' });
        };
        place();
        // Placed again when the text arrives in another language, the page scrolls or the window changes size.
        reposition?.();
        window.addEventListener('scroll', place, { passive: true });
        window.addEventListener('resize', place);
        const watch = new ResizeObserver(place);
        watch.observe(tooltip);
        reposition = () => { window.removeEventListener('scroll', place); window.removeEventListener('resize', place); watch.disconnect(); reposition = null; };
      }

      function clearHighlights() {
        steps.forEach(s => {
          const el = document.querySelector(s.target) as HTMLElement;
          if (el) {
            el.style.position = '';
            el.style.zIndex = '';
            el.style.boxShadow = '';
            el.style.borderRadius = '';
          }
        });
      }

      function finishOnboarding() {
        reposition?.();
        clearHighlights();
        overlay.classList.add('hidden');
        overlay.classList.remove('flex');
        localStorage.setItem(ONBOARDING_KEY, '1');
      }

      nextBtn.addEventListener('click', () => {
        clearHighlights();
        currentStep++;
        showStep(currentStep);
      });

      skipBtn.addEventListener('click', finishOnboarding);

      // Show onboarding
      overlay.classList.remove('hidden');
      overlay.classList.add('flex');
      showStep(0);
    }

    // Delay slightly so DOM is settled
    // Not held up by the language: the tooltip's text carries keys and is filled when the area arrives.
    setTimeout(startOnboarding, 500);
  </script>
</BaseLayout>
