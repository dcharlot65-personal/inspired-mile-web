---
import BaseLayout from '../layouts/BaseLayout.astro';
// Who may meet whom online: one switch, which the server reads too (backend/src/multiplayer/matchmaking.rs).
import onlinePlay from '../../backend/data/online-play.json';
const quickMatch = onlinePlay.quickMatch === true;
---

<BaseLayout title="Multiplayer" description="Duel another player in three rounds of verse. Every score is worked out by fixed rules on the server.">

  <!-- English in every interface language (online duels are English only): laid out left to right on an Arabic page too. -->
  <section class="section-padding" lang="en" dir="ltr">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/20 mb-6">
          <span class="w-2 h-2 rounded-full bg-purple-500 animate-pulse"></span>
          <span class="text-purple-400 text-xs font-medium tracking-wide uppercase">Multiplayer</span>
        </div>
        <h1 class="text-4xl sm:text-5xl font-display font-bold mb-4">
          Multiplayer <span class="text-gradient">Arena</span>
        </h1>
        <p class="text-obsidian-400 max-w-2xl mx-auto">
          A duel of verses against another player, best of three. You both write under the same form each round.
          Unlike a solo duel, your verses here are sent to our server, which scores both by fixed rules: the same
          rules this page shows you as you write. No language model reads your verse. Requires an account.
        </p>
        <p id="mp-english-only" class="text-obsidian-400 max-w-2xl mx-auto mt-3 text-sm" lang="en">
          Online duels are fought in English: the server scores English verse only, by the same English rules this page
          previews with. Solo duels are offered in all sixteen languages.
        </p>
        <!-- Who plays and who judges, in the player's own language although the page is English (EU AI Act
             Article 50; src/lib/ai-notice.ts has the solo duel's): the script marks its lang and direction. -->
        <p id="mp-ai-notice" role="note" lang="en" data-i18n="notice.online" class="max-w-2xl mx-auto mt-3 text-sm text-obsidian-200 border border-gold-500/30 bg-gold-500/10 rounded-sm px-3 py-2">
          Online, your opponent is another player, and our server judges both verses by fixed rules. No artificial intelligence plays or judges an online duel.
        </p>
      </div>

      <!-- Lobby -->
      <div id="mp-lobby" class="card-glass p-6 sm:p-8">
        <p id="mp-signin-note" class="hidden mb-6 text-sm text-gold-300 border border-gold-500/30 bg-gold-500/10 rounded-lg px-4 py-3">
          Online play needs an account. Use <strong>Sign in</strong> at the top of the page, then come back here.
        </p>

        <div class="mb-6">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs uppercase tracking-wider text-obsidian-500">Your deck: <span id="mp-deck-name" class="text-obsidian-300 normal-case"></span></span>
            <a href="/collection" class="text-xs text-obsidian-400 hover:text-gold-400 underline">Build a deck</a>
          </div>
          <div id="mp-deck-cards" class="flex flex-wrap gap-2"></div>
          <p class="mt-2 text-xs text-obsidian-500">Three to five characters. One takes the stage each round, each only once. Relics and potions are not played online yet.</p>
          <p class="mt-1 text-xs text-obsidian-500">Online you can field the three starter characters and any character your account holds. Cards this browser holds but your account does not are left out.</p>
        </div>

        <div id="mp-resume" class="hidden mb-6 rounded-lg border border-gold-500/40 bg-gold-500/10 p-4">
          <p class="text-sm text-obsidian-200 mb-3">You have a duel in progress.</p>
          <button id="mp-resume-btn" class="btn-primary px-6">Return to your duel</button>
        </div>

        <div id="mp-invited" class="hidden mb-6 rounded-lg border border-purple-500/30 bg-purple-500/10 p-4">
          <p class="text-sm text-obsidian-200 mb-3">You have been challenged to a duel.</p>
          <button id="mp-accept-btn" class="btn-primary px-6">Accept the challenge</button>
        </div>

        <div id="mp-choices" class:list={['grid gap-4', quickMatch && 'sm:grid-cols-2']}>
          {quickMatch && (
          <div class="rounded-lg border border-obsidian-700/60 bg-obsidian-900/40 p-4 text-center">
            <h2 class="font-display text-lg font-bold text-obsidian-100 mb-1">Quick match</h2>
            <p class="text-xs text-obsidian-400 mb-4">Meet the next player who is looking for a duel.</p>
            <button id="find-match-btn" class="btn-primary px-6">Find a match</button>
            <div id="queue-status" class="hidden">
              <div class="flex items-center justify-center gap-3 mb-2">
                <div class="w-5 h-5 border-2 border-gold-500 border-t-transparent rounded-full animate-spin"></div>
                <span class="text-sm text-obsidian-300">Looking for an opponent…</span>
              </div>
              <button id="cancel-queue-btn" class="text-xs text-obsidian-500 hover:text-crimson-400 transition-colors">Cancel</button>
            </div>
          </div>
          )}
          <div class="rounded-lg border border-obsidian-700/60 bg-obsidian-900/40 p-4 text-center">
            <h2 class="font-display text-lg font-bold text-obsidian-100 mb-1">Challenge a friend</h2>
            <p class="text-xs text-obsidian-400 mb-4">Open a room and send them the link.</p>
            <button id="create-private-btn" class="btn-secondary px-6">Open a room</button>
          </div>
        </div>
        {!quickMatch && (
          <p id="mp-quick-closed" class="mt-4 text-xs text-obsidian-400 text-center max-w-xl mx-auto">
            Quick match, which pairs you with a stranger, is switched off until we review reports every day and you can
            block or mute a player. Until then you duel only people you invite.
          </p>
        )}
        <p id="match-error" class="hidden text-sm text-crimson-400 mt-4 text-center" role="alert"></p>
      </div>

      <!-- Waiting room -->
      <div id="mp-waiting" class="hidden card-glass p-6 sm:p-8 text-center">
        <div class="w-6 h-6 border-2 border-gold-500 border-t-transparent rounded-full animate-spin mx-auto mb-4"></div>
        <p id="mp-waiting-text" class="text-obsidian-200 mb-4">Waiting for your opponent…</p>
        <div id="mp-invite" class="hidden max-w-xl mx-auto">
          <label for="mp-invite-link" class="text-xs uppercase tracking-wider text-obsidian-500">Send this link to your friend</label>
          <div class="flex gap-2 mt-2">
            <input id="mp-invite-link" readonly class="flex-1 min-w-0 bg-obsidian-900 border border-obsidian-700 rounded-lg px-3 py-2 text-xs font-mono text-obsidian-200" />
            <button id="mp-copy-link" class="btn-secondary text-xs px-3">Copy</button>
          </div>
        </div>
        <button id="mp-leave-btn" class="mt-6 text-xs text-obsidian-500 hover:text-crimson-400 transition-colors">Leave</button>
      </div>

      <!-- The duel -->
      <div id="mp-arena" class="hidden">
        <div class="card-glass overflow-hidden">
          <div class="flex items-center justify-between gap-4 p-4 border-b border-obsidian-700/50 bg-obsidian-900/50">
            <div class="min-w-0">
              <p id="mp-round-label" class="text-xs font-mono uppercase tracking-wider text-obsidian-500"></p>
              <p id="mp-form-name" class="font-display text-xl font-bold text-gold-400"></p>
            </div>
            <div class="text-right shrink-0">
              <p class="text-xs text-obsidian-500">
                <span id="mp-player-name" class="text-obsidian-300">You</span>
                <span id="mp-player-score" class="font-mono text-obsidian-100">0</span> ·
                <span id="mp-opponent-score" class="font-mono text-gold-400">0</span>
                <span id="mp-opponent-name" class="text-gold-300">Opponent</span>
              </p>
              <p id="mp-timer" class="text-xs font-mono text-obsidian-500"></p>
            </div>
          </div>

          <div class="p-4 sm:p-6 space-y-5">
            <ol id="mp-plan" class="flex flex-wrap gap-2 text-xs"></ol>
            <p id="mp-notice" class="hidden text-sm text-gold-300 border border-gold-500/30 bg-gold-500/10 rounded-sm px-3 py-2" role="status"></p>

            <!-- Writing -->
            <div id="mp-move-panel" class="space-y-4">
              <p id="mp-form-brief" class="text-obsidian-200"></p>

              <div id="mp-previous" class="hidden rounded-lg border border-obsidian-700/60 bg-obsidian-900/40 p-4">
                <p class="text-xs uppercase tracking-wider text-obsidian-500">Your opponent's last verse (a Riposte may turn a word of it back)</p>
                <blockquote id="mp-previous-verse" class="mt-2 whitespace-pre-line font-display text-obsidian-200 border-l-2 border-gold-500/40 pl-4"></blockquote>
              </div>

              <div>
                <span class="text-xs uppercase tracking-wider text-obsidian-500">Who takes the stage?</span>
                <div id="mp-hand" class="flex flex-wrap gap-2 mt-2"></div>
              </div>

              <div class="grid md:grid-cols-5 gap-4">
                <div class="md:col-span-3">
                  <label for="mp-input" class="text-xs uppercase tracking-wider text-obsidian-500">Your verse</label>
                  <textarea id="mp-input" rows="5" maxlength="600" spellcheck="true"
                    class="mt-2 w-full bg-obsidian-900 border border-obsidian-700 rounded-lg px-4 py-3 text-obsidian-100 font-display text-lg leading-relaxed focus:border-gold-500/50 focus:outline-hidden"
                    placeholder="One line of verse per line…"></textarea>
                </div>
                <div class="md:col-span-2">
                  <span class="text-xs uppercase tracking-wider text-obsidian-500">What your verse must do</span>
                  <ul id="mp-live-checks" class="mt-2 space-y-1.5 text-sm"></ul>
                  <p class="mt-3 text-xs text-obsidian-500">Craft so far: <span id="mp-live-craft" class="font-mono text-gold-400">0</span></p>
                  <p class="mt-1 text-[11px] text-obsidian-600">The server works out the same number from the same rules. The judge's 24 points are shared once both verses are in.</p>
                </div>
              </div>

              <div class="flex items-center justify-between gap-3">
                <p id="mp-hint" class="text-xs text-obsidian-400 min-h-[1rem]" role="status"></p>
                <button id="mp-send-btn" class="btn-primary px-8 shrink-0" disabled>Submit your verse</button>
              </div>
            </div>

            <!-- Verdicts, newest first -->
            <div id="mp-results" class="space-y-4"></div>

            <div id="mp-match-result" class="hidden rounded-lg border border-gold-500/40 bg-gold-500/10 p-5 text-center">
              <p id="mp-match-headline" class="font-display text-2xl font-bold text-gold-300"></p>
              <p id="mp-match-detail" class="text-sm text-obsidian-300 mt-1"></p>
              <a href="/multiplayer" class="btn-primary inline-block mt-4 px-6">Play again</a>
            </div>
          </div>

          <div class="flex items-center justify-between gap-3 px-4 py-3 border-t border-obsidian-700/50 bg-obsidian-900/50">
            <p class="text-xs text-obsidian-600">Match seed <span id="mp-seed" class="font-mono"></span> <span id="mp-seed-check"></span></p>
            <button id="mp-forfeit-btn" class="text-xs text-obsidian-500 hover:text-crimson-400 transition-colors">Forfeit</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    // The rules' own messages (a form's name, a check's label, a device's brief) are rendered
    // in the interface language, as on the battle page. The rest of this page is English only
    // for now, and so is online scoring: the server scores English verse.
    import { initI18n, isRtl, locale, onLocaleChange, t, tm } from '../i18n';
    import { deviceBrief, deviceName, signatureText } from '../i18n/duel';
    import { getCardById, type Card } from '../lib/cards';
    import { getActiveDeck } from '../lib/deck-manager';
    import { getOwnedCardIds } from '../lib/inventory';
    import {
      MultiplayerClient, QUICK_MATCH_LIMIT_MS, accountCards, auditRound, checkInvitation, createPrivateRoom, joinQueue, leaveQueue, listRooms,
      planMatchesSeed, reportContent, type MatchStart, type RoundView, type ServerEvent, type WireSide,
    } from '../lib/multiplayer-client';
    import {
      ONLINE_DECK_MAX, ONLINE_LANG, ONLINE_STARTER, onlineDeckProblem, previewCraft, settleVerse, type OnlinePreview,
    } from '../lib/multiplayer-rules';
    import { deviceForHouse, deviceInPlay, houseWhy } from '../lib/verse/devices';
    import { JUDGE_POOL, ROUNDS, starterDeck } from '../lib/verse/duel';
    import { getForm } from '../lib/verse/forms';
    import { CRITERIA } from '../lib/verse/judge';
    import { loadPronunciation } from '../lib/verse/pronounce';
    import onlinePlay from '../../backend/data/online-play.json';

    /** Quick match is switched off while this is false (owner decision D-02): the page then has no quick-match controls. */
    const QUICK_MATCH = onlinePlay.quickMatch === true;

    const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
    const el = (tag: string, cls = '', text = '') => {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text) e.textContent = text;
      return e;
    };
    const show = (id: string, on = true) => $(id).classList.toggle('hidden', !on);

    // The server scores English by sound, from the pronunciation table. This page needs the
    // same table before it previews or checks anything, or its numbers are the spelling
    // rules' and can differ from the server's. Fetched now; awaited before a room is joined.
    const pronunciation = loadPronunciation();

    // --- What this tab remembers (sessionStorage: this tab only, gone when it closes) ---
    // The seat this tab holds, so a reload or a visit to another page comes back to the duel
    // within the server's grace; and the verse being written, so neither a dropped connection
    // nor a reload loses it while the round is the same.
    const SEAT_KEY = 'inspired-mile-mp-seat';
    const DRAFT_KEY = 'inspired-mile-mp-draft';
    interface SavedSeat { room_id: string; deck: string[]; invite: boolean }
    interface Draft { room_id: string; round: number; char_id: string; verse: string }
    function readJson<T>(key: string): T | null {
      try {
        const raw = sessionStorage.getItem(key);
        return raw ? (JSON.parse(raw) as T) : null;
      } catch {
        return null;
      }
    }
    function writeJson(key: string, value: unknown) {
      try {
        if (value === null) sessionStorage.removeItem(key);
        else sessionStorage.setItem(key, JSON.stringify(value));
      } catch {
        /* storage blocked: the page still works, it just cannot come back after a reload */
      }
    }
    function forgetSeat() {
      writeJson(SEAT_KEY, null);
      writeJson(DRAFT_KEY, null);
    }

    // --- State ---
    let deck: string[] = [];
    let client: MultiplayerClient | null = null;
    let start: MatchStart | null = null;
    let results: RoundView[] = [];
    let round = 0;
    let charId = '';
    let submitted = false;
    let over = false;
    let deadline = 0;
    /** The round the move panel was last drawn for: a round_start for it again (a reconnect) keeps what is written. */
    let shownRound = -1;
    /** A room has been entered on this page: the lobby's own offers (rejoin, resume) stand down. */
    let entered = false;
    let queueAbort: AbortController | null = null;
    const verseInput = $<HTMLTextAreaElement>('mp-input');
    const sendBtn = $<HTMLButtonElement>('mp-send-btn');

    // --- Deck ---
    function cardChip(card: Card, extra = '', device = deviceForHouse(card.house, ONLINE_LANG).id): HTMLElement {
      const b = el('div', `flex items-center gap-2 px-2 py-1.5 rounded-lg border border-obsidian-700 bg-obsidian-900/60 ${extra}`);
      const pic = el('div', 'w-8 h-8 rounded-sm overflow-hidden flex items-center justify-center bg-obsidian-800 shrink-0');
      if (card.image) {
        const img = document.createElement('img');
        img.src = card.image;
        img.alt = '';
        img.className = 'w-full h-full object-cover';
        pic.appendChild(img);
      } else pic.textContent = card.icon;
      b.appendChild(pic);
      const text = el('div', 'min-w-0');
      text.appendChild(el('p', 'text-xs font-semibold text-obsidian-100 truncate', card.name));
      text.appendChild(el('p', 'text-[10px] text-obsidian-400 truncate', deviceName(device)));
      b.appendChild(text);
      return b;
    }

    /**
     * The characters the server lets this account field (it checks again): the starter
     * characters, and those the account holds. Unknown until the account's cards are read.
     */
    let playable = new Set<string>(ONLINE_STARTER);
    function loadDeck() {
      const saved = getActiveDeck();
      const mine = saved
        ? [...new Set(saved.characters)].filter((id) => getCardById(id)?.type === 'Character' && playable.has(id)).slice(0, ONLINE_DECK_MAX)
        : [];
      if (saved && !onlineDeckProblem(mine)) {
        deck = mine;
        $('mp-deck-name').textContent = saved.name;
      } else {
        // Characters the account holds first, then the starter characters.
        deck = starterDeck([...getOwnedCardIds()].filter((id) => playable.has(id))).characters;
        $('mp-deck-name').textContent = 'Starter deck';
      }
      const wrap = $('mp-deck-cards');
      wrap.replaceChildren();
      for (const id of deck) {
        const c = getCardById(id);
        if (c) wrap.appendChild(cardChip(c));
      }
    }
    loadDeck();

    // --- Lobby ---
    function lobbyError(message: string) {
      const p = $('match-error');
      p.textContent = message;
      show('match-error', !!message);
    }

    function friendly(err: unknown, fallback: string): string {
      const message = err instanceof Error ? err.message : '';
      if (!message || /Failed to fetch|NetworkError|Load failed/i.test(message)) return 'The game server cannot be reached right now. Try again in a moment.';
      return message || fallback;
    }

    /** Whether this browser is signed in; null if the server could not be asked. */
    async function signedIn(): Promise<boolean | null> {
      try {
        const me = await fetch('/api/v1/auth/me', { credentials: 'include' });
        return me.ok ? true : me.status === 401 ? false : null;
      } catch {
        return null;
      }
    }

    const invitation = new URLSearchParams(location.search).get('room');
    let resumable: string | null = null;
    void signedIn().then(async (yes) => {
      show('mp-signin-note', !yes);
      if (invitation) {
        show('mp-invited');
        show('mp-choices', false);
      }
      // Signed out: a seat this tab held is not this browser's to take back, and its draft goes.
      if (yes === false) forgetSeat();
      if (!yes) return;
      playable = new Set([...ONLINE_STARTER, ...(await accountCards())]);
      loadDeck();
      // Nothing more to offer if the player went into a room while this was being worked out.
      if (entered) return;
      // This tab held a seat (a reload, or back from another page): take it again.
      const seat = readJson<SavedSeat>(SEAT_KEY);
      if (seat && (!invitation || invitation === seat.room_id)) {
        await enterRoom(seat.room_id, seat.invite, seat.deck);
        return;
      }
      // A duel in progress from another tab or a closed one: offer the way back.
      try {
        const live = (await listRooms()).find((r) => r.state === 'in_progress');
        if (live && !invitation && !entered) {
          resumable = live.id;
          show('mp-resume');
        }
      } catch {
        /* the lobby works without it */
      }
    });

    $('mp-resume-btn').addEventListener('click', () => {
      if (resumable) void enterRoom(resumable, false, deck);
    });

    function resetQueue() {
      queueAbort = null;
      show('queue-status', false);
      show('find-match-btn');
    }

    if (QUICK_MATCH) $('find-match-btn').addEventListener('click', async () => {
      lobbyError('');
      show('queue-status');
      show('find-match-btn', false);
      queueAbort = new AbortController();
      const mine = queueAbort;
      const until = Date.now() + QUICK_MATCH_LIMIT_MS;
      try {
        // The server answers "timeout" after about half a minute; ask again until there is a
        // match, the player cancels, or the wait is over.
        while (queueAbort === mine) {
          const result = await joinQueue(mine.signal);
          if (queueAbort !== mine) return;
          if (result.status === 'matched' && result.room_id) {
            resetQueue();
            await enterRoom(result.room_id, false);
            return;
          }
          if (result.status === 'cancelled') break;
          if (Date.now() >= until) {
            void leaveQueue();
            lobbyError(`Nobody else looked for a duel in the last ${Math.round(QUICK_MATCH_LIMIT_MS / 60000)} minutes. Try again later, or challenge a friend with a link.`);
            $('match-error').dataset.reason = 'queue-timeout';
            break;
          }
        }
      } catch (err) {
        if (mine.signal.aborted) return;
        lobbyError(friendly(err, 'Could not join the queue.'));
      }
      if (queueAbort === mine) resetQueue();
    });

    if (QUICK_MATCH) $('cancel-queue-btn').addEventListener('click', () => {
      queueAbort?.abort();
      resetQueue();
      void leaveQueue();
    });

    $('create-private-btn').addEventListener('click', async () => {
      lobbyError('');
      try {
        const room = await createPrivateRoom();
        await enterRoom(room.room_id, true);
      } catch (err) {
        lobbyError(friendly(err, 'Could not open a room.'));
      }
    });

    $('mp-accept-btn').addEventListener('click', async () => {
      lobbyError('');
      try {
        const room = await checkInvitation(invitation ?? '');
        await enterRoom(room.room_id, false);
      } catch (err) {
        lobbyError(friendly(err, 'That invitation is no longer open.'));
      }
    });

    $('mp-copy-link').addEventListener('click', () => {
      const input = $<HTMLInputElement>('mp-invite-link');
      input.select();
      void navigator.clipboard?.writeText(input.value).then(() => { $('mp-copy-link').textContent = 'Copied'; }, () => undefined);
    });

    $('mp-leave-btn').addEventListener('click', () => {
      forgetSeat();
      client?.forfeit();
      client?.disconnect();
      location.href = '/multiplayer';
    });

    // --- Connection ---
    async function enterRoom(roomId: string, invite: boolean, withDeck: string[] = deck) {
      // One connection per page: a second would take the seat from the first.
      if (entered) return;
      entered = true;
      deck = withDeck;
      writeJson(SEAT_KEY, { room_id: roomId, deck, invite } satisfies SavedSeat);
      show('mp-resume', false);
      show('mp-lobby', false);
      show('mp-waiting');
      if (invite) {
        show('mp-invite');
        $<HTMLInputElement>('mp-invite-link').value = `${location.origin}/multiplayer?room=${roomId}`;
      }
      if (!(await pronunciation)) {
        notice("The pronunciation table could not be loaded. The checklist on this page may not match the server's score for some rhymes and syllable counts; the server's numbers are the ones that count.");
        $('mp-arena').dataset.pronunciation = 'missing';
      }
      client = new MultiplayerClient(location.origin);
      client.onEvent(handleServerEvent);
      client.onState((state) => {
        if (over) return;
        if (state === 'reconnecting') notice('Connection lost. Reconnecting…');
        else if (state === 'open') notice('');
        else notice('The connection to the game server is closed. Reload the page to try again.');
        if (state !== 'open') $('mp-waiting-text').textContent = state === 'reconnecting' ? 'Connection lost. Reconnecting…' : 'The connection to the game server is closed.';
        updateSubmit();
      });
      try {
        await client.connect();
        client.joinRoom(roomId, deck);
      } catch {
        entered = false;
        show('mp-waiting', false);
        show('mp-lobby');
        lobbyError('The game server cannot be reached right now. Try again in a moment.');
      }
    }

    /** The verse being written, kept for this tab so that a dropped connection or a reload does not lose it. */
    function saveDraft() {
      if (!start || over) return;
      writeJson(DRAFT_KEY, { room_id: start.room_id, round, char_id: charId, verse: verseInput.value } satisfies Draft);
    }

    function notice(message: string) {
      $('mp-notice').textContent = message;
      show('mp-notice', !!message);
    }

    // --- The match ---
    /** Errors that mean the verse just sent was not taken. */
    const REFUSED_VERSE = new Set(['content_rejected', 'verse_too_long', 'empty_verse', 'not_in_deck', 'character_used', 'wrong_round', 'bad_message', 'unknown_character']);

    function handleServerEvent(event: ServerEvent) {
      switch (event.type) {
        case 'room_joined':
          if (event.state === 'waiting') $('mp-waiting-text').textContent = event.opponent ? `${event.opponent} is here. Starting…` : 'Waiting for your opponent…';
          break;

        case 'match_start':
          if (event.lang !== ONLINE_LANG) {
            // This page previews English rules only; it cannot check a duel in another language.
            notice(`This duel is scored in a language this page cannot preview (${event.lang}).`);
          }
          start = event;
          results = [];
          $('mp-results').replaceChildren();
          show('mp-waiting', false);
          show('mp-arena');
          $('mp-player-name').textContent = event.you.username;
          $('mp-opponent-name').textContent = event.opponent.username;
          $('mp-seed').textContent = String(event.seed);
          $('mp-seed-check').textContent = planMatchesSeed(event) ? '· its three forms checked against the seed in your browser' : '· WARNING: these forms are not the ones this seed draws';
          $('mp-arena').dataset.seedCheck = planMatchesSeed(event) ? 'ok' : 'mismatch';
          for (const r of event.results) addResult(r);
          renderPlan();
          break;

        case 'round_start': {
          if (!start) break;
          // The same round again (the connection dropped and came back): what is written and the
          // character chosen stay. A new round starts clean, unless this tab kept a draft of it (a reload).
          const again = event.round === shownRound;
          round = event.round;
          submitted = event.submitted;
          deadline = Date.now() + event.seconds_left * 1000;
          if (!again) {
            const draft = readJson<Draft>(DRAFT_KEY);
            const kept = draft && draft.room_id === start.room_id && draft.round === round ? draft : null;
            charId = kept?.char_id ?? '';
            verseInput.value = kept?.verse ?? '';
          }
          // A character the server has since marked as played cannot be chosen.
          if (charId && (usedCharacters().includes(charId) || !start.you.deck.includes(charId))) charId = '';
          shownRound = round;
          show('mp-move-panel');
          renderRound(event.opponent_submitted);
          break;
        }

        case 'verse_accepted':
          submitted = true;
          $('mp-hint').textContent = 'Your verse is in. Waiting for your opponent…';
          updateSubmit();
          break;

        case 'opponent_submitted':
          if (!submitted) $('mp-hint').textContent = 'Your opponent has submitted. They are waiting for you.';
          break;

        case 'round_result':
          addResult(event);
          break;

        case 'match_complete': {
          over = true;
          deadline = 0;
          forgetSeat();
          show('mp-move-panel', false);
          notice('');
          const headline = event.winner === 'you' ? 'You win the duel' : event.winner === 'opponent' ? `${start?.opponent.username ?? 'Your opponent'} wins the duel` : 'The duel is a draw';
          const why = {
            rounds: `Rounds ${event.rounds_won.you} to ${event.rounds_won.opponent}.`,
            points: `Rounds level at ${event.rounds_won.you} each; points ${event.totals.you} to ${event.totals.opponent}.`,
            forfeit: event.winner === 'you' ? 'Your opponent forfeited.' : 'You forfeited.',
            disconnect: event.winner === 'you' ? 'Your opponent left and did not come back.' : 'You were away too long.',
          }[event.reason];
          $('mp-match-headline').textContent = headline;
          $('mp-match-detail').textContent = why;
          const box = $('mp-match-result');
          box.dataset.winner = event.winner;
          box.dataset.reason = event.reason;
          box.dataset.roundsYou = String(event.rounds_won.you);
          box.dataset.roundsOpponent = String(event.rounds_won.opponent);
          box.dataset.totalYou = String(event.totals.you);
          box.dataset.totalOpponent = String(event.totals.opponent);
          show('mp-match-result');
          show('mp-waiting', false);
          show('mp-arena');
          $('mp-forfeit-btn').classList.add('hidden');
          renderPlan();
          break;
        }

        case 'opponent_disconnected':
          notice(`Your opponent's connection dropped. They have ${event.grace_seconds} seconds to come back, or the duel is yours.`);
          break;

        case 'opponent_reconnected':
          notice('');
          break;

        case 'error':
          if (start && !over && (event.code === 'room_closed' || event.code === 'room_not_found' || event.code === 'signed_out')) {
            // Coming back to a duel the server no longer holds (it ended a while ago, or closed),
            // or signed out meanwhile (here or on every device; the server has closed the game
            // connection): nothing more can be played from this tab. It lets the seat and the
            // draft go, as it does whenever it finds itself signed out.
            over = true;
            deadline = 0;
            forgetSeat();
            client?.disconnect();
            show('mp-move-panel', false);
            $('mp-forfeit-btn').classList.add('hidden');
            notice(event.code === 'signed_out'
              ? event.message
              : 'This duel is no longer on the game server: it ended, or it closed, while this page was away.');
            $('mp-arena').dataset.closed = event.code;
            break;
          }
          if (start && !over) {
            $('mp-hint').textContent = event.message;
            // A refused verse was not taken: the player may change it and send again.
            if (REFUSED_VERSE.has(event.code)) submitted = false;
            if (event.code === 'already_submitted') submitted = true;
            renderHand();
            updateSubmit();
          } else if (!start) {
            // Refused before the match began (or the room is gone): back to the lobby, and this
            // tab no longer holds the seat.
            forgetSeat();
            show('mp-waiting', false);
            show('mp-arena', false);
            show('mp-lobby');
            lobbyError(event.message);
            $('match-error').dataset.reason = event.code;
            client?.disconnect();
            client = null;
            entered = false;
          }
          break;
      }
    }

    function renderPlan() {
      if (!start) return;
      const list = $('mp-plan');
      list.replaceChildren();
      for (const p of start.rounds) {
        const done = results.find((r) => r.round === p.index);
        const now = !over && p.index === round && !done;
        const li = el('li', `px-2 py-1 rounded-full border ${now ? 'border-gold-500/60 text-gold-300 bg-gold-500/10' : 'border-obsidian-700 text-obsidian-400'}`);
        const mark = done ? (done.winner === 'you' ? ' · yours' : done.winner === 'opponent' ? ' · theirs' : ' · drawn') : '';
        li.textContent = `${p.index + 1}. ${tm(getForm(p.form_id).name)}${mark}`;
        list.appendChild(li);
      }
      const last = results[results.length - 1];
      $('mp-player-score').textContent = String(last?.rounds_won.you ?? 0);
      $('mp-opponent-score').textContent = String(last?.rounds_won.opponent ?? 0);
    }

    function previousOpponentVerse(): string | undefined {
      return results.find((r) => r.round === round - 1)?.opponent.verse || undefined;
    }

    function renderRound(opponentSubmitted: boolean) {
      if (!start) return;
      const plan = start.rounds[round];
      const form = getForm(plan.form_id);
      const ctx = { lang: start.lang, acrostic: plan.acrostic ?? undefined };
      $('mp-round-label').textContent = `Round ${round + 1} of ${ROUNDS}`;
      $('mp-form-name').textContent = tm(form.name);
      $('mp-form-brief').textContent = tm(form.brief(ctx));
      const previous = previousOpponentVerse();
      show('mp-previous', !!previous);
      $('mp-previous-verse').textContent = previous ?? '';
      $('mp-hint').textContent = submitted ? 'Your verse is in. Waiting for your opponent…' : opponentSubmitted ? 'Your opponent has submitted. They are waiting for you.' : '';
      renderPlan();
      renderHand();
      renderChecks();
      updateSubmit();
    }

    function usedCharacters(): string[] {
      return results.map((r) => r.you.char_id);
    }

    function renderHand() {
      if (!start) return;
      const hand = $('mp-hand');
      hand.replaceChildren();
      const used = usedCharacters();
      for (const id of start.you.deck) {
        const card = getCardById(id);
        if (!card) continue;
        const spent = used.includes(id);
        const chosen = charId === id;
        // With no verse yet to answer, a Riposte house fights with its opening device.
        const device = deviceInPlay(card.house, ONLINE_LANG, !!previousOpponentVerse()).id;
        const b = cardChip(card, `cursor-pointer transition-all ${chosen ? 'border-gold-500/70 bg-gold-500/10' : ''} ${spent || submitted ? 'opacity-30 pointer-events-none' : 'hover:border-gold-500/40'}`, device);
        b.setAttribute('role', 'button');
        b.setAttribute('aria-pressed', String(chosen));
        b.tabIndex = spent || submitted ? -1 : 0;
        b.dataset.charId = id;
        b.dataset.spent = String(spent);
        const why = houseWhy(card.house, ONLINE_LANG);
        b.title = why ? tm(why) : '';
        const choose = () => {
          if (spent || submitted) return;
          charId = id;
          saveDraft();
          renderHand();
          renderChecks();
          updateSubmit();
        };
        b.addEventListener('click', choose);
        b.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); choose(); } });
        hand.appendChild(b);
      }
    }

    /** What the server will score for the verse in the box: the settled text this page sends, and its craft. */
    function preview(): OnlinePreview | null {
      if (!start || !charId) return null;
      const plan = start.rounds[round];
      return previewCraft(
        { index: plan.index, formId: plan.form_id, acrostic: plan.acrostic },
        { charId, deck: start.you.deck, verse: verseInput.value, previousOpponentVerse: previousOpponentVerse() },
      );
    }

    function checkRow(met: boolean, label: string, detail: string): HTMLElement {
      const li = el('li', 'flex gap-2 items-start');
      li.appendChild(el('span', met ? 'text-emerald-400 shrink-0' : 'text-obsidian-600 shrink-0', met ? '✓' : '○'));
      const text = el('span', met ? 'text-obsidian-100' : 'text-obsidian-400');
      text.textContent = label;
      if (detail) text.appendChild(el('span', 'block text-[11px] text-obsidian-500', detail));
      li.appendChild(text);
      li.dataset.met = String(met);
      return li;
    }

    function renderChecks() {
      const list = $('mp-live-checks');
      list.replaceChildren();
      const p = preview();
      const craft = $('mp-live-craft');
      if (!p) {
        list.appendChild(el('li', 'text-obsidian-500', t('live.chooseWho')));
        craft.textContent = '0';
        delete craft.dataset.verse;
        return;
      }
      const s = p.score;
      const written = verseInput.value.trim().length > 0;
      const card = getCardById(charId)!;
      for (const c of s.form.checks) list.appendChild(checkRow(c.met, t('live.points', { label: tm(c.label), points: c.points }), written ? c.detail : ''));
      list.appendChild(checkRow(s.device.met, t('live.device', { name: deviceName(s.device.id), brief: deviceBrief(s.device.id, ONLINE_LANG) }), written ? s.device.detail : ''));
      list.appendChild(checkRow(s.signature.met, t('live.signature', { card: card.name }), signatureText(s.signature)));
      if (s.synergy) list.appendChild(checkRow(true, 'House synergy (+¼ craft)', 'two of this house in your deck, and the device landed'));
      if (written && s.voided && s.voided !== 'empty') {
        const li = el('li', 'flex gap-2 items-start text-crimson-300');
        li.appendChild(el('span', 'shrink-0', '✗'));
        li.appendChild(el('span', '', `${t('void.label')}: ${t(`void.${s.voided}`)}`));
        li.dataset.void = s.voided;
        list.appendChild(li);
      }
      craft.textContent = String(s.craft);
      // The text this craft is for: what the send button sends.
      craft.dataset.verse = p.verse;
    }

    function updateSubmit() {
      const ready = !!start && !over && !submitted && !!charId && settleVerse(verseInput.value).length > 0 && !!client?.connected;
      sendBtn.disabled = !ready;
      verseInput.disabled = submitted || over;
    }

    verseInput.addEventListener('input', () => { saveDraft(); renderChecks(); updateSubmit(); });

    sendBtn.addEventListener('click', () => {
      if (!client || !start || submitted || !charId) return;
      // Sent exactly as the preview scored it: the settled verse (cleaned until cleaning
      // changes nothing), capped, and without half a character at the cut.
      const text = preview()?.verse ?? '';
      if (!text) return;
      if (!client.submitVerse(round, charId, text)) {
        $('mp-hint').textContent = 'Not connected. Your verse will be kept here; try again in a moment.';
        return;
      }
      // Locked until the server answers: "verse_accepted", or an error that unlocks it.
      submitted = true;
      $('mp-hint').textContent = 'Sending…';
      renderHand();
      updateSubmit();
    });

    $('mp-forfeit-btn').addEventListener('click', () => {
      if (!client || over) return;
      if (!confirm('Forfeit the duel? Your opponent wins.')) return;
      client.forfeit();
    });

    setInterval(() => {
      const t = $('mp-timer');
      if (!deadline || over) { t.textContent = ''; return; }
      const left = Math.max(0, Math.ceil((deadline - Date.now()) / 1000));
      t.textContent = `${Math.floor(left / 60)}:${String(left % 60).padStart(2, '0')} left`;
      t.classList.toggle('text-crimson-400', left <= 20);
    }, 500);

    // --- Verdicts ---
    /** A device's name; its id if this page's rules do not know it (the audit line will then say so too). */
    const nameOfDevice = (id: string) => {
      try { return deviceName(id); } catch { return id; }
    };

    function sideCard(title: string, side: WireSide, tone: string): HTMLElement {
      const card = getCardById(side.char_id);
      const box = el('div', 'rounded-lg border border-obsidian-700/60 bg-obsidian-900/40 p-3');
      box.appendChild(el('p', `text-xs uppercase tracking-wider ${tone}`, `${title} · ${card?.name ?? side.char_id}`));
      const verse = el('blockquote', 'mt-2 whitespace-pre-line font-display text-obsidian-100 border-l-2 border-obsidian-600 pl-3 min-h-[2rem]');
      verse.textContent = side.timed_out ? '(no verse in time)' : side.verse;
      box.appendChild(verse);
      const rows = el('dl', 'mt-3 space-y-0.5 text-xs');
      const row = (name: string, value: string, strong = false) => {
        const r = el('div', `flex justify-between gap-3 ${strong ? 'border-t border-obsidian-700 pt-1 mt-1 font-semibold text-obsidian-100' : 'text-obsidian-400'}`);
        r.appendChild(el('dt', '', name));
        r.appendChild(el('dd', 'font-mono', value));
        rows.appendChild(r);
      };
      if (side.score.voided && side.score.voided !== 'empty') row(t('void.label'), t(`void.${side.score.voided}`));
      row('Form', `${side.score.form.earned} of 20`);
      row(`Device: ${nameOfDevice(side.score.device.id)}`, side.score.device.met ? 'landed' : 'missed');
      row('Signature', side.score.signature ? 'landed' : 'missed');
      if (side.score.synergy) row('House synergy', 'yes');
      row('Multiplier', `×${side.score.multiplier}`);
      row('Craft', String(side.score.craft));
      row(`Judge (of ${JUDGE_POOL})`, String(side.judge));
      row('Total', String(side.total), true);
      box.appendChild(rows);
      return box;
    }

    function addResult(r: RoundView) {
      if (!start || results.some((x) => x.round === r.round)) return;
      const problems = auditRound(start, results, r);
      results.push(r);

      const box = el('div', 'rounded-lg border border-obsidian-700/60 p-4');
      box.dataset.roundResult = String(r.round);
      box.dataset.winner = r.winner;
      box.dataset.youChar = r.you.char_id;
      box.dataset.youCraft = String(r.you.score.craft);
      box.dataset.youJudge = String(r.you.judge);
      box.dataset.youTotal = String(r.you.total);
      box.dataset.opponentCraft = String(r.opponent.score.craft);
      box.dataset.opponentJudge = String(r.opponent.judge);
      box.dataset.opponentTotal = String(r.opponent.total);
      box.dataset.audit = problems.length ? 'mismatch' : 'ok';
      box.dataset.youVoid = r.you.score.voided ?? '';
      box.dataset.opponentVoid = r.opponent.score.voided ?? '';

      const head = el('div', 'flex items-center justify-between gap-3 mb-3');
      head.appendChild(el('p', 'text-xs font-mono uppercase tracking-wider text-obsidian-500', `Round ${r.round + 1} · ${tm(getForm(r.form_id).name)}`));
      const verdict = r.winner === 'you' ? 'You take the round' : r.winner === 'opponent' ? `${start.opponent.username} takes the round` : 'The round is drawn';
      head.appendChild(el('p', `text-sm font-display font-bold ${r.winner === 'you' ? 'text-emerald-400' : r.winner === 'opponent' ? 'text-crimson-400' : 'text-obsidian-200'}`, verdict));
      box.appendChild(head);

      const grid = el('div', 'grid sm:grid-cols-2 gap-3');
      grid.appendChild(sideCard('You', r.you, 'text-purple-300'));
      grid.appendChild(sideCard(start.opponent.username, r.opponent, 'text-gold-300'));
      box.appendChild(grid);

      const judge = el('p', 'mt-3 text-xs text-obsidian-400');
      judge.textContent = 'Judged by rule: ' + CRITERIA.map((c) => `${c} ${r.criteria[c] === 'you' ? 'yours' : r.criteria[c] === 'opponent' ? 'theirs' : 'shared'}`).join(' · ');
      box.appendChild(judge);

      const audit = el('p', `mt-2 text-xs ${problems.length ? 'text-crimson-300' : 'text-obsidian-500'}`);
      audit.textContent = problems.length
        ? `This browser recomputed the round and does not agree with the server: ${problems.slice(0, 4).join('; ')}. Please report this.`
        : "Checked in your browser: the server's numbers are exactly what the rules give for these two verses.";
      box.appendChild(audit);

      if (!r.opponent.timed_out) {
        const report = el('button', 'mt-2 text-[11px] text-obsidian-600 hover:text-crimson-400 transition-colors', "Report your opponent's verse");
        report.addEventListener('click', async () => {
          const reason = prompt('What is wrong with this verse?');
          if (!reason || !start) return;
          try {
            await reportContent(start.room_id, `Round ${r.round + 1}: ${reason}`.slice(0, 500));
            report.textContent = 'Reported. Thank you.';
            (report as HTMLButtonElement).disabled = true;
          } catch (err) {
            report.textContent = friendly(err, 'Could not send the report.');
          }
        });
        box.appendChild(report);
      }

      $('mp-results').prepend(box);
      renderPlan();
    }

    // The notice of who plays and who judges is the one line of this English page in the player's language
    // (the layout fills its data-i18n): its lang and direction are the interface's.
    function markNotice() {
      const notice = $('mp-ai-notice');
      notice.lang = locale();
      notice.dir = isRtl(locale()) ? 'rtl' : 'ltr';
    }

    // The rules' messages follow the interface language.
    void initI18n().then(markNotice);
    onLocaleChange(() => {
      markNotice();
      loadDeck();
      if (!start) return;
      const plan = start.rounds[round];
      const form = getForm(plan.form_id);
      $('mp-form-name').textContent = tm(form.name);
      $('mp-form-brief').textContent = tm(form.brief({ lang: start.lang, acrostic: plan.acrostic ?? undefined }));
      renderPlan();
      renderHand();
      renderChecks();
    });

    /**
     * A page left while it waits for a quick match leaves the queue, so the next player is not
     * paired with a closed tab. The server also gives up a request whose connection has gone
     * (handlers.rs join_queue); this covers a proxy that does not pass the close on.
     *
     * The leaving request goes BEFORE the waiting one is aborted. Measured in headless Chromium
     * with the site's service worker controlling the page and the server's own give-up turned
     * off (2026-11-17, the leave-page test in tests/multiplayer.spec.ts): aborted first, the
     * keepalive DELETE made at pagehide never reached the API (8 runs of 8); sent first, it did
     * (4 of 4 at pagehide alone, 4 of 4 as here), and so it did, aborted first, with the service
     * worker blocked (1 run). It is sent at beforeunload, while
     * the page is whole, and at pagehide for a browser that skips beforeunload (the first that
     * runs takes the page out of the queue, so it is sent once). This page asks nothing at
     * beforeunload while it waits (only mid-match), so the leaving is never taken back.
     */
    function leaveQueueOnExit() {
      if (!queueAbort) return;
      void leaveQueue({ keepalive: true });
      queueAbort.abort();
      resetQueue();
    }

    // A closed tab is a disconnect: the server gives this player time to come back, and this
    // tab takes its seat again when it loads (SEAT_KEY). Leaving mid-match is still a risk: say so.
    window.addEventListener('beforeunload', (e) => {
      leaveQueueOnExit();
      if (start && !over) {
        e.preventDefault();
        e.returnValue = '';
      }
    });
    window.addEventListener('pagehide', (e) => {
      client?.disconnect();
      leaveQueueOnExit();
      // Kept in the back/forward cache: if the page is shown again, it takes its seat again.
      if (e.persisted) {
        client = null;
        entered = false;
      }
    });
    window.addEventListener('pageshow', (e) => {
      if (!e.persisted || entered || over) return;
      const seat = readJson<SavedSeat>(SEAT_KEY);
      if (!seat) return;
      // What the page showed stays; the server sends the match as it stands. Until it does, a
      // refusal (the duel ended or closed meanwhile) takes the page back to the lobby.
      start = null;
      void enterRoom(seat.room_id, seat.invite, seat.deck);
    });
  </script>
</BaseLayout>
