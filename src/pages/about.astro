---
import BaseLayout from '../layouts/BaseLayout.astro';
import T from '../components/T.astro';
import { loadArea, t } from '../i18n';
import { monthOfYear, quoted, yearOnly } from '../i18n/pages/runtime';

// English at build time; the script at the foot of the page puts it in the visitor's language.
await loadArea('about');

// People's names, their stage names and their links are the same in every language.
const team = [
  {
    id: 'david',
    name: 'David Charlot, PhD',
    icon: '&#128187;',
    website: 'https://davidjcharlot.com/',
    socials: {
      linkedin: 'https://linkedin.com/in/dcharlot',
      twitter: 'https://x.com/realdavidjc',
    },
  },
  {
    id: 'devon',
    name: 'Devon Glover',
    aka: 'The Sonnet Man',
    icon: '&#127908;',
    website: 'https://southernshakespearefestival.org/sonnet-man/',
    socials: {
      youtube: 'https://www.youtube.com/TheSonnetManTV',
      twitter: 'https://x.com/thesonnetmannyc',
      linkedin: 'https://www.linkedin.com/in/thesonnetman/',
      facebook: 'https://www.facebook.com/TheSonnetMan/',
    },
  },
  {
    id: 'paul',
    name: 'Arrocito del Diablo',
    aka: 'Paul Rice',
    icon: '&#127917;',
  },
  {
    id: 'treston',
    name: 'Treston Knight',
    icon: '&#9881;',
    socials: {
      linkedin: 'https://www.linkedin.com/in/treston',
    },
  },
];

// When each thing happened: a month the browser can name (Intl), or a season or quarter named by a message.
type When = { month: [number, number] } | { key: string; year: number };
const timeline: { when: When; event: string; done: boolean }[] = [
  { when: { month: [2025, 3] }, event: 'e1', done: true },
  { when: { month: [2025, 4] }, event: 'e2', done: true },
  { when: { month: [2025, 6] }, event: 'e3', done: true },
  { when: { key: 'about.journey.summer', year: 2025 }, event: 'e4', done: false },
  { when: { key: 'about.journey.quarter1', year: 2026 }, event: 'e5', done: false },
  { when: { key: 'about.journey.quarter3', year: 2026 }, event: 'e6', done: false },
];
const whenText = (w: When) => ('month' in w ? monthOfYear(w.month[0], w.month[1]) : t(w.key, { year: yearOnly(w.year) }));

const tech = ['collectibles', 'ai', 'theatre', 'speech', 'market'];
const credits = [50, 30, 20, 10];
const FOUNDED = 2025;
const lists = [
  { id: 'forever', icon: '&#9989;', tone: 'emerald' },
  { id: 'earn', icon: '&#127942;', tone: 'gold' },
  { id: 'safe', icon: '&#128101;', tone: 'purple' },
];
const TONE: Record<string, { card: string; chip: string; title: string }> = {
  emerald: { card: 'border-emerald-500/20', chip: 'bg-emerald-500/10 border-emerald-500/20', title: 'text-emerald-400' },
  gold: { card: 'border-gold-500/20', chip: 'bg-gold-500/10 border-gold-500/20', title: 'text-gold-400' },
  purple: { card: 'border-purple-500/20', chip: 'bg-purple-500/10 border-purple-500/20', title: 'text-purple-400' },
};
---

<BaseLayout title="About" description={t('about.meta.description')} descriptionKey="about.meta.description" i18nAreas={['about']}>

  <section class="section-padding">
    <div class="max-w-4xl mx-auto text-center">
      <T k="about.title" as="h1" class="text-4xl sm:text-5xl font-display font-bold mb-6" />
      <T k="about.intro" as="p" class="text-lg text-obsidian-300 leading-relaxed max-w-2xl mx-auto mb-4" />
      <p class="text-obsidian-500 text-sm"><span lang="en" data-proper-name>Sarasota, FL</span> &middot; <span data-when-key="about.founded" data-when-year={FOUNDED}>{t('about.founded', { year: yearOnly(FOUNDED) })}</span></p>
    </div>
  </section>

  <section class="section-padding bg-obsidian-900/30 pt-12">
    <div class="max-w-4xl mx-auto">
      <div class="grid md:grid-cols-2 gap-8">
        <div class="card-glass p-8">
          <T k="about.vision.title" as="h3" class="font-display text-xl font-bold text-gold-400 mb-4" />
          <T k="about.vision.p1" as="p" class="text-sm text-obsidian-300 leading-relaxed mb-4" />
          <T k="about.vision.p2" as="p" class="text-sm text-obsidian-300 leading-relaxed" />
        </div>
        <div class="card-glass p-8">
          <T k="about.why.title" as="h3" class="font-display text-xl font-bold text-gold-400 mb-4" />
          <T k="about.why.p1" as="p" class="text-sm text-obsidian-300 leading-relaxed mb-4" aHref="https://southernshakespearefestival.org/sonnet-man/" aClass="text-gold-400 hover:text-gold-300 transition-colors" aExternal />
          <T k="about.why.p2" as="p" class="text-sm text-obsidian-300 leading-relaxed" />
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding">
    <div class="max-w-4xl mx-auto">
      <T k="about.team.title" as="h2" class="text-3xl font-display font-bold text-center mb-12" />
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {team.map((member) => (
          <div class="card-glass p-6 text-center hover:border-gold-500/30 transition-all">
            <div class="w-16 h-16 rounded-full bg-gold-500/10 border border-gold-500/20 flex items-center justify-center mx-auto mb-4">
              <span class="text-2xl" set:html={member.icon} />
            </div>
            <h3 class="font-display text-lg font-semibold text-obsidian-100" lang="en" data-proper-name>{member.name}</h3>
            {member.aka && <p class="text-xs text-gold-400 mb-1" data-proper-name set:html={quoted(member.aka, 'en')} />}
            <T k={`about.team.${member.id}.role`} as="p" class="text-xs text-obsidian-500 mb-3" />
            <T k={`about.team.${member.id}.bio`} as="p" class="text-sm text-obsidian-400 leading-relaxed" />
            {member.website && (
              <a href={member.website} target="_blank" rel="noopener noreferrer" class="inline-block mt-3 text-xs text-gold-400 hover:text-gold-300 transition-colors">
                <span dir="ltr">{new URL(member.website).hostname.replace('www.', '')} &rarr;</span>
              </a>
            )}
            {member.socials && (
              <div class="flex items-center justify-center gap-3 mt-3">
                {member.socials.youtube && (
                  <a href={member.socials.youtube} target="_blank" rel="noopener noreferrer" class="text-obsidian-500 hover:text-gold-400 transition-colors" aria-label="YouTube">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                  </a>
                )}
                {member.socials.twitter && (
                  <a href={member.socials.twitter} target="_blank" rel="noopener noreferrer" class="text-obsidian-500 hover:text-gold-400 transition-colors" aria-label="X / Twitter">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                  </a>
                )}
                {member.socials.linkedin && (
                  <a href={member.socials.linkedin} target="_blank" rel="noopener noreferrer" class="text-obsidian-500 hover:text-gold-400 transition-colors" aria-label="LinkedIn">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                  </a>
                )}
                {member.socials.facebook && (
                  <a href={member.socials.facebook} target="_blank" rel="noopener noreferrer" class="text-obsidian-500 hover:text-gold-400 transition-colors" aria-label="Facebook">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                  </a>
                )}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-obsidian-900/30">
    <div class="max-w-2xl mx-auto">
      <T k="about.journey.title" as="h2" class="text-3xl font-display font-bold text-center mb-12" />
      <div class="space-y-0">
        {timeline.map((item, i) => (
          <div class="flex gap-4">
            <div class="flex flex-col items-center">
              <div class={`w-3 h-3 rounded-full ${item.done ? 'bg-gold-400' : 'bg-obsidian-600'} shrink-0`}></div>
              {i < timeline.length - 1 && <div class="w-px h-16 bg-obsidian-700"></div>}
            </div>
            <div class="pb-8">
              <!-- Arabic month names fell apart into separate letters in the monospace font (no Arabic in
                   JetBrains Mono; the fallback is a monospaced Arabic): Arabic takes the text font. -->
              {'month' in item.when
                ? <span class="text-xs font-mono [&:lang(ar)]:font-sans text-gold-500" data-when-month={item.when.month.join('-')}>{whenText(item.when)}</span>
                : <span class="text-xs font-mono [&:lang(ar)]:font-sans text-gold-500" data-when-key={item.when.key} data-when-year={item.when.year}>{whenText(item.when)}</span>}
              <T k={`about.journey.${item.event}`} as="p" class="text-sm text-obsidian-300 mt-1" />
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding">
    <div class="max-w-4xl mx-auto">
      <T k="about.tech.title" as="h2" class="text-3xl font-display font-bold text-center mb-12" />
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {tech.map((id) => (
          <div class="card-glass p-6">
            <T k={`about.tech.${id}.title`} as="h4" class="font-display font-semibold text-obsidian-200 mb-2" />
            <T k={`about.tech.${id}.body`} as="p" class="text-sm text-obsidian-400" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-obsidian-900/30">
    <div class="max-w-4xl mx-auto">
      <T k="about.free.title" as="h2" class="text-3xl font-display font-bold text-center mb-4" />
      <T k="about.free.body" as="p" class="text-center text-obsidian-400 text-sm mb-10 max-w-xl mx-auto" />
      <div class="grid sm:grid-cols-3 gap-6">
        {lists.map((list) => (
          <div class={`card-glass p-6 ${TONE[list.tone].card}`}>
            <div class="flex items-center gap-2 mb-3">
              <div class={`w-8 h-8 shrink-0 rounded-lg border flex items-center justify-center ${TONE[list.tone].chip}`}>
                <span class="text-lg" set:html={list.icon} />
              </div>
              <T k={`about.free.${list.id}.title`} as="h4" class={`font-display font-semibold ${TONE[list.tone].title}`} />
            </div>
            <ul class="space-y-2 text-sm text-obsidian-300">
              {[1, 2, 3, 4, 5, 6].map((n) => (
                <T k={`about.free.${list.id}.l${n}`} as="li" vars={list.id === 'earn' && n <= credits.length ? { n: credits[n - 1] } : undefined} />
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding">
    <div class="max-w-2xl mx-auto text-center">
      <div class="card-glass p-10 glow-gold">
        <T k="about.join.title" as="h2" class="text-2xl font-display font-bold mb-3" />
        <T k="about.join.body" as="p" class="text-obsidian-400 text-sm mb-6" />
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/battle" class="btn-primary"><T k="about.join.battle" /></a>
          <a href="/playground" class="btn-secondary"><T k="about.join.playground" /></a>
        </div>
      </div>
    </div>
  </section>

  <script>
    import { t } from '../i18n';
    import { initPage, monthOfYear, yearOnly } from '../i18n/pages/runtime';

    void initPage(['about'], () => {
      document.querySelectorAll<HTMLElement>('[data-when-month]').forEach((el) => {
        const [year, month] = el.dataset.whenMonth!.split('-').map(Number);
        el.textContent = monthOfYear(year, month);
      });
      document.querySelectorAll<HTMLElement>('[data-when-key]').forEach((el) => {
        el.textContent = t(el.dataset.whenKey!, { year: yearOnly(Number(el.dataset.whenYear)) });
      });
    });
  </script>
</BaseLayout>
