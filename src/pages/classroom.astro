---
import BaseLayout from '../layouts/BaseLayout.astro';
// Every sentence on this page is a key in src/i18n/pages/classroom (and "shared"); the
// English written in the markup is what a reader sees before the script has run.
---

<BaseLayout title="Classroom Mode" description="Teachers create classrooms and set Shakespeare trivia and challenges for their students.">

  <section class="section-padding">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 mb-6">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-emerald-400 text-xs font-medium tracking-wide uppercase" data-i18n="classroom.badge">Education</span>
        </div>
        <h1 class="text-4xl sm:text-5xl font-display font-bold mb-4">
          <span class="text-gradient" data-i18n="classroom.title">Classroom Mode</span>
        </h1>
        <p class="text-obsidian-400 text-lg max-w-2xl mx-auto" data-i18n="classroom.intro">
          Create or join a classroom. Teachers set Shakespeare trivia and challenges for their students.
        </p>
      </div>

      <!-- Consent Gate -->
      <div id="consent-gate" class="card-glass p-6 rounded-2xl mb-8 border-gold-500/20">
        <h3 class="text-lg font-display font-bold text-gold-400 mb-4" data-i18n="classroom.gate.title">Before you begin</h3>
        <p class="text-sm text-obsidian-400 mb-4" data-i18n="classroom.gate.body">
          Classroom Mode is made for schools. Choose your role to continue.
        </p>

        <div class="space-y-3 mb-6">
          <button id="role-teacher" class="w-full card-glass p-4 text-start hover:border-gold-500/30 transition-all flex items-center gap-4">
            <div class="w-10 h-10 rounded-lg bg-gold-500/10 border border-gold-500/20 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
            </div>
            <div class="min-w-0">
              <p class="text-sm font-semibold text-obsidian-200" data-i18n="classroom.role.teacher">I am a teacher</p>
              <p class="text-xs text-obsidian-500" data-i18n="classroom.role.teacherHint">Create and manage classrooms</p>
            </div>
          </button>
          <button id="role-student" class="w-full card-glass p-4 text-start hover:border-emerald-500/30 transition-all flex items-center gap-4">
            <div class="w-10 h-10 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            </div>
            <div class="min-w-0">
              <p class="text-sm font-semibold text-obsidian-200" data-i18n="classroom.role.student">I am a student</p>
              <p class="text-xs text-obsidian-500" data-i18n="classroom.role.studentHint">Join a classroom that already exists</p>
            </div>
          </button>
        </div>
      </div>

      <!-- Teacher Consent -->
      <div id="teacher-consent" class="card-glass p-6 rounded-2xl mb-8 border-gold-500/20 hidden">
        <h3 class="text-lg font-display font-bold text-gold-400 mb-4" data-i18n="classroom.teacher.title">Teacher confirmation</h3>
        <div class="space-y-3 mb-4">
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="checkbox" class="teacher-check mt-1 w-4 h-4 shrink-0 rounded-sm border-obsidian-600 bg-obsidian-800 text-gold-500 focus:ring-gold-500/50" />
            <span class="text-xs text-obsidian-300 leading-relaxed" data-i18n="classroom.teacher.check1">I am a teacher, an instructor or a school administrator, and I am authorised to use this with my students.</span>
          </label>
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="checkbox" class="teacher-check mt-1 w-4 h-4 shrink-0 rounded-sm border-obsidian-600 bg-obsidian-800 text-gold-500 focus:ring-gold-500/50" />
            <span class="text-xs text-obsidian-300 leading-relaxed" data-i18n="classroom.teacher.check2">I will obtain the consent of a parent or guardian before enrolling any student under 18.</span>
          </label>
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="checkbox" class="teacher-check mt-1 w-4 h-4 shrink-0 rounded-sm border-obsidian-600 bg-obsidian-800 text-gold-500 focus:ring-gold-500/50" />
            <!-- One sentence in five pieces: each language orders them with its own grammar, and each piece carries its own spaces. -->
            <span class="text-xs text-obsidian-300 leading-relaxed"><span data-i18n="classroom.teacher.check3Before">I have read and agree to the </span><a href="/terms" class="text-gold-400 hover:text-gold-300" data-i18n="footer.terms">Terms of Service</a><span data-i18n="classroom.teacher.check3And"> and the </span><a href="/privacy" class="text-gold-400 hover:text-gold-300" data-i18n="footer.privacy">Privacy Policy</a><span data-i18n="classroom.teacher.check3After">, including the sections on classroom and educational use and on FERPA.</span></span>
          </label>
        </div>
        <button id="teacher-continue" class="btn-gold px-6 py-3 rounded-xl font-display font-bold text-sm w-full opacity-50 pointer-events-none" data-i18n="classroom.teacher.continue">Continue as a teacher</button>
      </div>

      <!-- Student Consent -->
      <div id="student-consent" class="card-glass p-6 rounded-2xl mb-8 border-emerald-500/20 hidden">
        <h3 class="text-lg font-display font-bold text-emerald-400 mb-4" data-i18n="classroom.student.title">Student consent</h3>
        <p class="text-sm text-obsidian-400 mb-4" data-i18n="classroom.student.intro">
          Before you join a classroom, please confirm the following:
        </p>
        <div class="space-y-3 mb-4">
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="checkbox" class="student-check mt-1 w-4 h-4 shrink-0 rounded-sm border-obsidian-600 bg-obsidian-800 text-emerald-500 focus:ring-emerald-500/50" />
            <span class="text-xs text-obsidian-300 leading-relaxed" data-i18n="classroom.student.check1">My parent or legal guardian knows I am using Inspired Mile for schoolwork and has given permission.</span>
          </label>
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="checkbox" class="student-check mt-1 w-4 h-4 shrink-0 rounded-sm border-obsidian-600 bg-obsidian-800 text-emerald-500 focus:ring-emerald-500/50" />
            <span class="text-xs text-obsidian-300 leading-relaxed" data-i18n="classroom.student.check2">My teacher has given me a join code for a classroom.</span>
          </label>
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="checkbox" class="student-check mt-1 w-4 h-4 shrink-0 rounded-sm border-obsidian-600 bg-obsidian-800 text-emerald-500 focus:ring-emerald-500/50" />
            <span class="text-xs text-obsidian-300 leading-relaxed" data-i18n="classroom.student.check3">I understand that my teacher can see that I joined the classroom, and when.</span>
          </label>
        </div>
        <button id="student-continue" class="btn-gold px-6 py-3 rounded-xl font-display font-bold text-sm w-full bg-emerald-500 hover:bg-emerald-400 border-emerald-500 opacity-50 pointer-events-none" data-i18n="classroom.student.continue">Continue as a student</button>
      </div>

      <!-- Join / Create Toggle (hidden until consent complete) -->
      <div id="classroom-actions" class="hidden">
      <div class="flex flex-wrap gap-3 justify-center mb-8">
        <button id="btn-join" class="btn-gold px-6 py-3 rounded-xl font-display font-bold text-sm" data-i18n="classroom.join.tab">Join a classroom</button>
        <button id="btn-create" class="btn-outline px-6 py-3 rounded-xl font-display font-bold text-sm" data-i18n="classroom.create.tab">Create a classroom</button>
      </div>
      </div>

      <!-- Join Form -->
      <div id="join-form" class="card-glass p-6 rounded-2xl mb-8 hidden">
        <h3 class="text-lg font-display font-bold text-obsidian-200 mb-4" data-i18n="classroom.join.title">Join with a code</h3>
        <div class="flex flex-wrap gap-3">
          <!-- The code is six Latin letters in every language: left to right, and never letter-spaced away. -->
          <input id="join-code" type="text" maxlength="6" placeholder="6-character code" data-i18n-placeholder="classroom.join.placeholder" data-i18n-aria-label="classroom.detail.code" aria-label="Join code" autocapitalize="characters" autocomplete="off" spellcheck="false"
                 class="flex-1 min-w-0 bg-obsidian-800 border border-obsidian-700 rounded-xl px-4 py-3 text-obsidian-200 placeholder-obsidian-500 font-mono text-lg text-center uppercase placeholder:normal-case placeholder:text-sm placeholder:font-sans focus:border-gold-400 focus:outline-hidden" />
          <button id="join-submit" class="btn-gold px-6 py-3 rounded-xl font-display font-bold" data-i18n="classroom.join.submit">Join</button>
        </div>
        <p id="join-msg" role="status" class="text-sm mt-3 text-obsidian-400 hidden"></p>
      </div>

      <!-- Create Form (hidden by default) -->
      <div id="create-form" class="card-glass p-6 rounded-2xl mb-8 hidden">
        <h3 class="text-lg font-display font-bold text-obsidian-200 mb-4" data-i18n="classroom.create.title">Create a classroom</h3>
        <div class="flex flex-wrap gap-3">
          <input id="class-name" type="text" maxlength="128" placeholder="Classroom name" data-i18n-placeholder="classroom.create.placeholder" data-i18n-aria-label="classroom.create.placeholder" aria-label="Classroom name" dir="auto"
                 class="flex-1 min-w-0 bg-obsidian-800 border border-obsidian-700 rounded-xl px-4 py-3 text-obsidian-200 placeholder-obsidian-500 focus:border-gold-400 focus:outline-hidden" />
          <button id="create-submit" class="btn-gold px-6 py-3 rounded-xl font-display font-bold" data-i18n="classroom.create.submit">Create</button>
        </div>
        <p id="create-msg" role="status" class="text-sm mt-3 text-obsidian-400 hidden"></p>
      </div>

      <!-- My Classrooms -->
      <div id="classrooms-section" class="mb-8">
        <h2 class="text-2xl font-display font-bold text-obsidian-200 mb-6" data-i18n="classroom.mine.title">My classrooms</h2>
        <div id="classrooms-list" class="space-y-4">
          <!-- skeleton -->
          <div class="card-glass animate-pulse p-6 rounded-2xl">
            <div class="h-5 bg-obsidian-700 rounded-sm w-1/3 mb-3"></div>
            <div class="h-4 bg-obsidian-700 rounded-sm w-1/4"></div>
          </div>
        </div>
        <p id="no-classrooms" class="text-obsidian-500 text-center py-8 hidden" data-i18n="classroom.mine.empty">You have not joined a classroom yet.</p>
      </div>

      <!-- Classroom Detail (shown when a classroom is selected) -->
      <div id="classroom-detail" class="hidden">
        <div class="flex items-center gap-3 mb-6">
          <button id="back-btn" class="text-obsidian-400 hover:text-gold-400 transition-colors shrink-0" aria-label="Back to my classrooms" data-i18n-aria-label="classroom.detail.back">
            <!-- The arrow points back: to the left in left-to-right languages, to the right in Arabic. -->
            <svg class="w-5 h-5 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
          </button>
          <!-- <bdi>: a name keeps its own direction, while the line it sits on stays aligned with the page. -->
          <h2 class="text-2xl font-display font-bold text-obsidian-200 min-w-0 break-words"><bdi id="detail-name"></bdi></h2>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          <!-- Join Code Card -->
          <div class="card-glass p-6 rounded-2xl">
            <h3 class="text-sm font-bold text-obsidian-400 uppercase tracking-wide mb-2" data-i18n="classroom.detail.code">Join code</h3>
            <p class="text-3xl font-mono tracking-widest text-gold-400" id="detail-code" lang="en" dir="ltr" translate="no"></p>
            <button id="copy-code" class="mt-3 text-xs text-obsidian-400 hover:text-gold-400 transition-colors" data-i18n="classroom.detail.copy">Copy the code</button>
          </div>

          <!-- Members Card -->
          <div class="card-glass p-6 rounded-2xl">
            <h3 class="text-sm font-bold text-obsidian-400 uppercase tracking-wide mb-2" data-i18n="classroom.detail.members">Members</h3>
            <div id="members-list" class="space-y-2 max-h-48 overflow-y-auto"></div>
          </div>
        </div>

        <!-- Assignments (teacher only) -->
        <div id="assignments-section" class="mt-6">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
            <h3 class="text-lg font-display font-bold text-obsidian-200" data-i18n="classroom.assign.title">Assignments</h3>
            <button id="new-assignment" class="btn-gold px-4 py-2 rounded-lg text-xs font-bold hidden"><span aria-hidden="true">+ </span><span data-i18n="classroom.assign.new">New assignment</span></button>
          </div>

          <div id="assignment-form" class="card-glass p-4 rounded-xl mb-4 hidden">
            <div class="flex flex-wrap gap-3">
              <input id="assign-title" type="text" maxlength="128" placeholder="Assignment title" data-i18n-placeholder="classroom.assign.titlePlaceholder" data-i18n-aria-label="classroom.assign.titlePlaceholder" aria-label="Assignment title" dir="auto"
                     class="flex-1 min-w-40 bg-obsidian-800 border border-obsidian-700 rounded-lg px-3 py-2 text-sm text-obsidian-200 placeholder-obsidian-500 focus:border-gold-400 focus:outline-hidden" />
              <select id="assign-type" aria-label="Kind of activity" data-i18n-aria-label="classroom.assign.typeLabel" class="bg-obsidian-800 border border-obsidian-700 rounded-lg px-3 py-2 text-sm text-obsidian-200 focus:border-gold-400 focus:outline-hidden">
                <option value="trivia" data-i18n="activity.trivia">Trivia</option>
                <option value="challenge" data-i18n="activity.challenge">Challenge</option>
                <option value="battle" data-i18n="activity.battle">Battle</option>
              </select>
              <button id="assign-submit" class="btn-gold px-4 py-2 rounded-lg text-xs font-bold" data-i18n="classroom.assign.add">Add</button>
            </div>
            <p id="assign-msg" role="alert" class="text-sm mt-3 text-red-400 hidden"></p>
          </div>

          <div id="assignments-list" class="space-y-3"></div>
          <p id="no-assignments" class="text-obsidian-500 text-center py-4 hidden" data-i18n="classroom.assign.empty">No assignments yet.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Teacher Onboarding Wizard -->
  <div id="teacher-wizard" class="fixed inset-0 z-100 bg-obsidian-950/85 hidden items-center justify-center p-4">
    <div class="card-glass max-w-md w-full max-h-full overflow-y-auto p-6 bg-obsidian-900/95 backdrop-blur-xl border border-gold-500/20 rounded-2xl shadow-2xl">
      <div class="flex items-center justify-between gap-3 mb-4">
        <div class="flex items-center gap-2 min-w-0">
          <div class="w-8 h-8 rounded-lg bg-gold-500/10 border border-gold-500/20 flex items-center justify-center shrink-0">
            <svg class="w-4 h-4 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
          </div>
          <!-- Tabular figures, not a monospace font: a monospace face has no Arabic, Devanagari or Thai of its own, and the fallback pulls their letters apart. -->
          <span id="wizard-step" class="text-xs tabular-nums text-gold-500/60"></span>
        </div>
        <button id="wizard-skip" class="text-xs text-obsidian-500 hover:text-obsidian-300 transition-colors shrink-0" data-i18n="classroom.wizard.skip">Skip the tour</button>
      </div>

      <div id="wizard-content">
        <!-- Step 1 -->
        <div class="wizard-page" data-step="1">
          <h3 class="font-display text-lg font-bold text-gold-300 mb-2" data-i18n="classroom.wizard.s1.title">Create your classroom</h3>
          <p class="text-sm text-obsidian-300 mb-3" data-i18n="classroom.wizard.s1.body">Choose “Create a classroom” and give it a name, such as “Period 3 English” or “Shakespeare 101”. Each classroom gets its own 6-character join code.</p>
          <div class="card-glass p-3 bg-obsidian-800/50 rounded-lg text-center">
            <span class="font-mono text-2xl tracking-widest text-gold-400" lang="en" dir="ltr" translate="no">ABCDEF</span>
            <p class="text-[10px] text-obsidian-500 mt-1" data-i18n="classroom.wizard.s1.example">Example of a join code</p>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="wizard-page hidden" data-step="2">
          <h3 class="font-display text-lg font-bold text-gold-300 mb-2" data-i18n="classroom.wizard.s2.title">Share it with your students</h3>
          <p class="text-sm text-obsidian-300 mb-3" data-i18n="classroom.wizard.s2.body">Give your students the 6-character code. They choose “I am a student”, confirm the consent and enter the code. No email address is needed.</p>
          <div class="flex flex-wrap gap-2 justify-center">
            <div class="card-glass px-3 py-2 rounded-lg text-center">
              <span class="text-xs text-obsidian-400" data-i18n="classroom.wizard.s2.board">Write it on the board</span>
            </div>
            <div class="card-glass px-3 py-2 rounded-lg text-center">
              <span class="text-xs text-obsidian-400" data-i18n="classroom.wizard.s2.lms">Post it on your learning platform</span>
            </div>
            <div class="card-glass px-3 py-2 rounded-lg text-center">
              <span class="text-xs text-obsidian-400" data-i18n="classroom.wizard.s2.print">Print a handout</span>
            </div>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="wizard-page hidden" data-step="3">
          <h3 class="font-display text-lg font-bold text-gold-300 mb-2" data-i18n="classroom.wizard.s3.title">Set activities</h3>
          <p class="text-sm text-obsidian-300 mb-3" data-i18n="classroom.wizard.s3.body">Create assignments for your class: Shakespeare trivia to check knowledge, quotation challenges to fill in the missing words, or a duel of verses for creative writing.</p>
          <div class="space-y-2">
            <div class="card-glass p-2 rounded-lg flex items-baseline gap-2">
              <span class="text-emerald-400 text-xs min-w-16 shrink-0" data-i18n="activity.trivia">Trivia</span>
              <span class="text-xs text-obsidian-400" data-i18n="classroom.wizard.s3.trivia">5 multiple-choice questions on Shakespeare</span>
            </div>
            <div class="card-glass p-2 rounded-lg flex items-baseline gap-2">
              <span class="text-purple-400 text-xs min-w-16 shrink-0" data-i18n="activity.challenge">Challenge</span>
              <span class="text-xs text-obsidian-400" data-i18n="classroom.wizard.s3.challenge">Fill in the missing words of famous quotations</span>
            </div>
            <div class="card-glass p-2 rounded-lg flex items-baseline gap-2">
              <span class="text-crimson-400 text-xs min-w-16 shrink-0" data-i18n="activity.battle">Battle</span>
              <span class="text-xs text-obsidian-400" data-i18n="classroom.wizard.s3.battle">A three-round duel of verses, judged on the device</span>
            </div>
          </div>
        </div>

        <!-- No step on following progress: Classroom Mode records none (it keeps class names, members and
             assignments), and the tour said it did, with "FERPA compliant" beside it (owner decision D-03). -->
      </div>

      <div class="flex items-center justify-between gap-3 mt-5 pt-4 border-t border-obsidian-800">
        <div class="flex gap-1.5">
          <div class="wizard-dot w-2 h-2 rounded-full bg-gold-400" data-dot="1"></div>
          <div class="wizard-dot w-2 h-2 rounded-full bg-obsidian-600" data-dot="2"></div>
          <div class="wizard-dot w-2 h-2 rounded-full bg-obsidian-600" data-dot="3"></div>
        </div>
        <div class="flex gap-2">
          <button id="wizard-prev" class="text-xs text-obsidian-500 hover:text-obsidian-300 transition-colors hidden" data-i18n="auth.back">Back</button>
          <button id="wizard-next" class="btn-primary text-xs px-4 py-2"></button>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { createClassroom, listClassrooms, joinClassroom, listMembers, listAssignments, createAssignment } from '../lib/classroom';
    import type { Assignment, Classroom, ClassroomMember } from '../lib/classroom';
    import { apiErrorCode } from '../lib/api-errors';
    import { getCurrentUser } from '../lib/storage-backend';
    import { has, t } from '../i18n';
    import { date, plural } from '../i18n/fmt';
    import { errorText, esc, initPage, onPageLocaleChange } from '../i18n/page';

    const WIZARD_STEPS = 3;

    // --- Consent Gate ---
    const CONSENT_KEY = 'inspired-mile-classroom-consent';
    const consentGate = document.getElementById('consent-gate')!;
    const teacherConsent = document.getElementById('teacher-consent')!;
    const studentConsent = document.getElementById('student-consent')!;
    const classroomActions = document.getElementById('classroom-actions')!;

    const storedConsent = localStorage.getItem(CONSENT_KEY);
    if (storedConsent === 'teacher' || storedConsent === 'student') {
      // Already consented — show actions directly
      consentGate.classList.add('hidden');
      classroomActions.classList.remove('hidden');
      if (storedConsent === 'student') {
        // Students can only join, not create
        document.getElementById('btn-create')?.classList.add('hidden');
      }
    }

    // Role selection
    document.getElementById('role-teacher')?.addEventListener('click', () => {
      consentGate.classList.add('hidden');
      teacherConsent.classList.remove('hidden');
    });

    document.getElementById('role-student')?.addEventListener('click', () => {
      consentGate.classList.add('hidden');
      studentConsent.classList.remove('hidden');
    });

    // Teacher checkbox logic
    const teacherChecks = document.querySelectorAll('.teacher-check') as NodeListOf<HTMLInputElement>;
    const teacherContinue = document.getElementById('teacher-continue')!;
    teacherChecks.forEach(cb => {
      cb.addEventListener('change', () => {
        const allChecked = Array.from(teacherChecks).every(c => c.checked);
        if (allChecked) {
          teacherContinue.classList.remove('opacity-50', 'pointer-events-none');
        } else {
          teacherContinue.classList.add('opacity-50', 'pointer-events-none');
        }
      });
    });
    teacherContinue.addEventListener('click', () => {
      localStorage.setItem(CONSENT_KEY, 'teacher');
      teacherConsent.classList.add('hidden');
      classroomActions.classList.remove('hidden');
      startTeacherWizard();
    });

    // Student checkbox logic
    const studentChecks = document.querySelectorAll('.student-check') as NodeListOf<HTMLInputElement>;
    const studentContinue = document.getElementById('student-continue')!;
    studentChecks.forEach(cb => {
      cb.addEventListener('change', () => {
        const allChecked = Array.from(studentChecks).every(c => c.checked);
        if (allChecked) {
          studentContinue.classList.remove('opacity-50', 'pointer-events-none');
        } else {
          studentContinue.classList.add('opacity-50', 'pointer-events-none');
        }
      });
    });
    studentContinue.addEventListener('click', () => {
      localStorage.setItem(CONSENT_KEY, 'student');
      studentConsent.classList.add('hidden');
      classroomActions.classList.remove('hidden');
      // Students can only join
      document.getElementById('btn-create')?.classList.add('hidden');
      joinForm.classList.remove('hidden');
    });

    // --- Classroom UI ---
    const joinForm = document.getElementById('join-form')!;
    const createForm = document.getElementById('create-form')!;
    const btnJoin = document.getElementById('btn-join')!;
    const btnCreate = document.getElementById('btn-create')!;
    const classroomsList = document.getElementById('classrooms-list')!;
    const noClassrooms = document.getElementById('no-classrooms')!;
    const classroomsSection = document.getElementById('classrooms-section')!;
    const classroomDetail = document.getElementById('classroom-detail')!;

    /**
     * Everything this script writes is kept as "what to say", not as a sentence, so that it
     * can be said again in another language: a notice is a function that builds its text.
     */
    type Notice = { text: () => string; tone: 'ok' | 'error' } | null;
    const notices = new Map<string, Notice>();

    function setNotice(id: string, notice: Notice) {
      notices.set(id, notice);
      drawNotice(id);
    }

    function drawNotice(id: string) {
      const el = document.getElementById(id)!;
      const notice = notices.get(id) ?? null;
      if (!notice) {
        el.classList.add('hidden');
        el.textContent = '';
        return;
      }
      el.textContent = notice.text();
      el.className = `text-sm mt-3 ${notice.tone === 'ok' ? 'text-emerald-400' : 'text-red-400'}`;
    }

    const failure = (e: unknown): Notice => ({ text: () => errorText(e), tone: 'error' });

    type ListState = 'loading' | 'ready' | 'signed-out' | { error: unknown };
    let currentClassrooms: Classroom[] = [];
    let listState: ListState = 'loading';
    let openId: number | null = null;
    let openMembers: ClassroomMember[] = [];
    let openAssignments: Assignment[] | null = null;
    let copied = false;

    // Toggle join/create forms
    btnJoin?.addEventListener('click', () => {
      joinForm.classList.remove('hidden');
      createForm.classList.add('hidden');
      btnJoin.className = 'btn-gold px-6 py-3 rounded-xl font-display font-bold text-sm';
      if (btnCreate) btnCreate.className = 'btn-outline px-6 py-3 rounded-xl font-display font-bold text-sm';
    });

    btnCreate?.addEventListener('click', () => {
      createForm.classList.remove('hidden');
      joinForm.classList.add('hidden');
      btnCreate.className = 'btn-gold px-6 py-3 rounded-xl font-display font-bold text-sm';
      btnJoin.className = 'btn-outline px-6 py-3 rounded-xl font-display font-bold text-sm';
    });

    // Auto-show join form for students who completed consent
    if (storedConsent === 'student') {
      joinForm.classList.remove('hidden');
    }

    // Join classroom
    document.getElementById('join-submit')!.addEventListener('click', async () => {
      const code = (document.getElementById('join-code') as HTMLInputElement).value.trim();
      if (!code || code.length !== 6) {
        setNotice('join-msg', { text: () => t('classroom.join.needCode'), tone: 'error' });
        return;
      }
      try {
        const result = await joinClassroom(code);
        setNotice('join-msg', { text: () => t('classroom.join.done', { name: result.classroom }), tone: 'ok' });
        loadClassrooms();
      } catch (e) {
        setNotice('join-msg', failure(e));
      }
    });

    // Create classroom
    document.getElementById('create-submit')!.addEventListener('click', async () => {
      const name = (document.getElementById('class-name') as HTMLInputElement).value.trim();
      if (!name) {
        setNotice('create-msg', { text: () => t('classroom.create.needName'), tone: 'error' });
        return;
      }
      try {
        await createClassroom(name);
        setNotice('create-msg', { text: () => t('classroom.create.done'), tone: 'ok' });
        (document.getElementById('class-name') as HTMLInputElement).value = '';
        loadClassrooms();
      } catch (e) {
        setNotice('create-msg', failure(e));
      }
    });

    // Back button
    document.getElementById('back-btn')!.addEventListener('click', () => {
      openId = null;
      classroomDetail.classList.add('hidden');
      classroomsSection.classList.remove('hidden');
    });

    function drawClassrooms() {
      if (listState === 'loading') return; // the skeleton in the markup stands in
      noClassrooms.classList.add('hidden');
      if (listState === 'signed-out') {
        classroomsList.innerHTML = `<p class="text-obsidian-500 text-center py-4">${esc(t('classroom.mine.signIn'))}</p>`;
        return;
      }
      if (listState !== 'ready') {
        classroomsList.innerHTML = `<p class="text-red-400 text-center py-4" role="alert">${esc(errorText(listState.error))}</p>`;
        return;
      }
      if (currentClassrooms.length === 0) {
        classroomsList.innerHTML = '';
        noClassrooms.classList.remove('hidden');
        return;
      }
      classroomsList.innerHTML = currentClassrooms.map(c => `
        <button class="card-glass p-5 rounded-2xl w-full text-start hover:border-gold-400/30 transition-colors" data-id="${c.id}">
          <div class="flex items-center justify-between gap-3">
            <div class="min-w-0">
              <h3 class="font-display font-bold text-obsidian-200 break-words"><bdi>${esc(c.name)}</bdi></h3>
              <p class="text-xs text-obsidian-500 mt-1">${esc(plural('classroom.members', c.member_count))} &middot; ${esc(t('classroom.list.code'))} <span class="font-mono text-gold-400" lang="en" dir="ltr" translate="no">${esc(c.join_code)}</span></p>
            </div>
            <svg class="w-5 h-5 text-obsidian-500 shrink-0 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </div>
        </button>
      `).join('');

      classroomsList.querySelectorAll('[data-id]').forEach(btn => {
        btn.addEventListener('click', () => {
          openClassroom(parseInt(btn.getAttribute('data-id')!));
        });
      });
    }

    // Load classrooms
    async function loadClassrooms() {
      try {
        currentClassrooms = await listClassrooms();
        listState = 'ready';
      } catch (e) {
        listState = apiErrorCode(e) === 'not_signed_in' ? 'signed-out' : { error: e };
      }
      drawClassrooms();
    }

    function drawDetail() {
      const classroom = currentClassrooms.find(c => c.id === openId);
      if (!classroom) return;

      document.getElementById('detail-name')!.textContent = classroom.name;
      document.getElementById('detail-code')!.textContent = classroom.join_code;
      document.getElementById('copy-code')!.textContent = t(copied ? 'classroom.detail.copied' : 'classroom.detail.copy');

      document.getElementById('members-list')!.innerHTML = openMembers.map(m => `
        <div class="flex items-center justify-between gap-2 text-sm">
          <span class="text-obsidian-200 min-w-0 break-words"><bdi>${esc(m.username)}</bdi></span>
          <span class="text-xs px-2 py-0.5 rounded-full shrink-0 ${m.role === 'teacher' ? 'bg-gold-400/10 text-gold-400' : 'bg-obsidian-700 text-obsidian-400'}">${esc(t(m.role === 'teacher' ? 'classroom.badge.teacher' : 'classroom.badge.student'))}</span>
        </div>
      `).join('');

      const list = document.getElementById('assignments-list')!;
      const noA = document.getElementById('no-assignments')!;
      if (!openAssignments) {
        list.innerHTML = '';
        noA.classList.add('hidden');
      } else if (openAssignments.length === 0) {
        list.innerHTML = '';
        noA.classList.remove('hidden');
      } else {
        noA.classList.add('hidden');
        list.innerHTML = openAssignments.map(a => {
          // The kinds the server knows have names; an unknown kind is shown as the server wrote it.
          const kind = has(`activity.${a.assignment_type}`) ? t(`activity.${a.assignment_type}`) : a.assignment_type;
          return `
            <div class="card-glass p-4 rounded-xl flex items-center justify-between gap-3">
              <div class="min-w-0">
                <p class="font-display font-bold text-obsidian-200 text-sm break-words"><bdi>${esc(a.title)}</bdi></p>
                <p class="text-xs text-obsidian-500">${esc(date(a.created_at))}</p>
              </div>
              <span class="text-xs px-2 py-1 rounded-full bg-emerald-500/10 text-emerald-400 shrink-0">${esc(kind)}</span>
            </div>
          `;
        }).join('');
      }
    }

    async function openClassroom(id: number) {
      const classroom = currentClassrooms.find(c => c.id === id);
      if (!classroom) return;

      openId = id;
      openMembers = [];
      openAssignments = null;
      copied = false;
      setNotice('assign-msg', null);
      classroomsSection.classList.add('hidden');
      classroomDetail.classList.remove('hidden');
      drawDetail();

      // Copy code
      document.getElementById('copy-code')!.onclick = async () => {
        try {
          await navigator.clipboard.writeText(classroom.join_code);
        } catch {
          return; // no clipboard here: the code is on screen to be read
        }
        copied = true;
        drawDetail();
        setTimeout(() => { copied = false; if (openId === id) drawDetail(); }, 2000);
      };

      // Load members
      const newBtn = document.getElementById('new-assignment')!;
      newBtn.classList.add('hidden');
      try {
        openMembers = await listMembers(id);
        // Only this classroom's teacher is offered the assignment form (the server checks again).
        const me = getCurrentUser()?.id;
        const isTeacher = openMembers.some(m => m.role === 'teacher' && m.user_id === me);
        if (isTeacher) {
          newBtn.classList.remove('hidden');
          newBtn.onclick = () => document.getElementById('assignment-form')!.classList.toggle('hidden');
        }
      } catch { /* not signed in, or not a member: the list stays empty */ }

      // Load assignments
      try {
        openAssignments = await listAssignments(id);
      } catch { /* as above */ }
      if (openId === id) drawDetail();

      // Assignment submit
      document.getElementById('assign-submit')!.onclick = async () => {
        const title = (document.getElementById('assign-title') as HTMLInputElement).value.trim();
        const type = (document.getElementById('assign-type') as HTMLSelectElement).value;
        if (!title) return;
        try {
          await createAssignment(id, title, type);
          (document.getElementById('assign-title') as HTMLInputElement).value = '';
          document.getElementById('assignment-form')!.classList.add('hidden');
          openClassroom(id); // refresh
        } catch (e) {
          setNotice('assign-msg', failure(e));
        }
      };
    }

    // --- Teacher Onboarding Wizard ---
    const WIZARD_KEY = 'inspired-mile-teacher-wizard-done';
    let wizardStep = 1;

    function drawWizard() {
      document.getElementById('wizard-step')!.textContent = t('classroom.wizard.step', { n: wizardStep, total: WIZARD_STEPS });
      document.getElementById('wizard-next')!.textContent = t(wizardStep === WIZARD_STEPS ? 'classroom.wizard.start' : 'classroom.wizard.next');
    }

    function startTeacherWizard() {
      if (localStorage.getItem(WIZARD_KEY)) return;

      const wizard = document.getElementById('teacher-wizard')!;
      const pages = wizard.querySelectorAll('.wizard-page') as NodeListOf<HTMLElement>;
      const dots = wizard.querySelectorAll('.wizard-dot') as NodeListOf<HTMLElement>;
      const prevBtn = document.getElementById('wizard-prev')!;
      const nextBtn = document.getElementById('wizard-next')!;

      wizard.classList.remove('hidden');
      wizard.classList.add('flex');

      function showStep(n: number) {
        wizardStep = n;
        pages.forEach(p => p.classList.add('hidden'));
        dots.forEach(d => d.classList.remove('bg-gold-400'));
        dots.forEach(d => d.classList.add('bg-obsidian-600'));

        const page = wizard.querySelector(`[data-step="${n}"]`) as HTMLElement;
        if (page) page.classList.remove('hidden');
        const dot = wizard.querySelector(`[data-dot="${n}"]`) as HTMLElement;
        if (dot) { dot.classList.remove('bg-obsidian-600'); dot.classList.add('bg-gold-400'); }

        prevBtn.classList.toggle('hidden', n === 1);
        drawWizard();
      }

      nextBtn.addEventListener('click', () => {
        if (wizardStep >= WIZARD_STEPS) {
          closeWizard();
        } else {
          showStep(wizardStep + 1);
        }
      });

      prevBtn.addEventListener('click', () => {
        if (wizardStep > 1) showStep(wizardStep - 1);
      });

      document.getElementById('wizard-skip')!.addEventListener('click', closeWizard);

      function closeWizard() {
        localStorage.setItem(WIZARD_KEY, '1');
        wizard.classList.add('hidden');
        wizard.classList.remove('flex');
      }

      showStep(1);
    }

    /** Everything built with t(), drawn again. Runs once the language is known and on every change of it. */
    function redraw() {
      drawWizard();
      drawClassrooms();
      if (openId !== null) drawDetail();
      for (const id of notices.keys()) drawNotice(id);
    }

    // Nothing is drawn with t() before the language and this page's strings are in.
    initPage(['classroom', 'shared'], { title: 'classroom.meta.title', description: 'classroom.meta.description' })
      .catch((e) => console.error('[classroom] the language could not be loaded', e))
      .then(() => {
        redraw();
        onPageLocaleChange(redraw);
        loadClassrooms();
      });
  </script>

</BaseLayout>
