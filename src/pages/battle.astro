---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Battle Arena" description="A duel of verses: play your cards, keep the form, and out-write an AI that runs entirely in your browser.">

  <!-- Every visible string on this page is a message key (src/i18n). The English here is what
       shows until the script has run; data-i18n fills it in the visitor's language. -->
  <section class="section-padding">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-crimson-500/10 border border-crimson-500/20 mb-6">
          <span class="w-2 h-2 rounded-full bg-crimson-500 animate-pulse"></span>
          <span class="text-crimson-400 text-xs font-medium tracking-wide uppercase" data-i18n="battle.badge">Live Arena</span>
        </div>
        <h1 class="font-display text-4xl sm:text-5xl font-bold text-obsidian-100 mb-4"><span data-i18n="battle.titleA">Battle</span> <span class="text-gradient" data-i18n="battle.titleB">Arena</span></h1>
        <p class="text-obsidian-300 max-w-xl mx-auto" data-i18n="battle.intro">
          Three rounds, three forms. Your cards decide what your verse must do. The opponent runs in your browser: nothing you write leaves this device.
        </p>
      </div>

      <!-- Setup -->
      <div id="duel-setup" class="card-glass p-6 sm:p-8">
        <h2 class="font-display text-2xl font-bold text-gold-400 mb-1" data-i18n="battle.prepare">Prepare your duel</h2>
        <p class="text-sm text-obsidian-400 mb-6" data-i18n="battle.prepareNote">Each character can take the stage once. Relics and potions cost ink.</p>

        <div class="grid sm:grid-cols-2 gap-6">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs uppercase tracking-wider text-obsidian-500" data-i18n="battle.deck">Deck</span>
              <a href="/collection" class="text-xs text-obsidian-400 hover:text-gold-400 underline" data-i18n="battle.buildDeck">Build a deck</a>
            </div>
            <p id="deck-name" class="text-sm font-semibold text-gold-400 mb-2"></p>
            <div id="deck-cards" class="flex flex-wrap gap-2"></div>
          </div>

          <div class="space-y-4">
            <label class="block">
              <span class="text-xs uppercase tracking-wider text-obsidian-500" data-i18n="battle.opponent">Opponent</span>
              <select id="difficulty" class="mt-1 w-full bg-obsidian-900 border border-obsidian-700 rounded-lg px-3 py-2 text-sm text-obsidian-100">
                <option value="apprentice" data-i18n="battle.difficulty.apprentice">Apprentice: writes one draft</option>
                <option value="player" selected data-i18n="battle.difficulty.player">Player: picks the better of two drafts</option>
                <option value="master" data-i18n="battle.difficulty.master">Master: picks the best of three drafts</option>
              </select>
            </label>
            <label class="block">
              <span class="text-xs uppercase tracking-wider text-obsidian-500" data-i18n="battle.duelLanguage">Language of the duel</span>
              <select id="language" class="mt-1 w-full bg-obsidian-900 border border-obsidian-700 rounded-lg px-3 py-2 text-sm text-obsidian-100"></select>
              <span id="language-note" class="hidden mt-1 block text-xs text-obsidian-400" role="status"></span>
            </label>
          </div>
        </div>

        <!-- World card (city variant) -->
        <div id="variant-equip" class="hidden mt-6 p-3 rounded-lg border border-obsidian-700/50 bg-obsidian-900/30">
          <div class="flex items-center justify-between">
            <div>
              <span class="text-xs uppercase tracking-wider text-obsidian-500" data-i18n="battle.worldCard">World card</span>
              <span id="equipped-variant-label" class="ms-2 text-xs font-semibold text-obsidian-400"></span>
            </div>
            <button id="equip-variant-btn" class="text-xs text-obsidian-400 hover:text-gold-400 transition-colors border border-obsidian-700 rounded-sm px-2 py-1" data-i18n="battle.equip">Equip</button>
          </div>
          <div id="variant-picker" class="hidden mt-3 max-h-48 overflow-y-auto space-y-1"></div>
        </div>

        <!-- Brain -->
        <div class="mt-6 p-4 rounded-lg border border-obsidian-700/50 bg-obsidian-900/30">
          <span class="text-xs uppercase tracking-wider text-obsidian-500" data-i18n="battle.mind">Your opponent's mind</span>
          <p id="brain-status" class="text-sm text-obsidian-300 mt-1">Checking what this device can run…</p>
          <div id="brain-choices" class="hidden mt-3 flex flex-wrap gap-3">
            <button id="brain-model-btn" class="btn-primary text-sm"></button>
            <button id="brain-other-btn" class="hidden btn-secondary text-sm"></button>
            <button id="brain-rules-btn" class="btn-secondary text-sm" data-i18n="brain.playNow">Play now without a download</button>
          </div>
          <div id="loading-screen" class="hidden mt-3">
            <p id="loading-status" class="text-sm text-obsidian-400 mb-2"></p>
            <div class="h-2 rounded-full bg-obsidian-800 overflow-hidden">
              <div id="loading-bar" class="h-full bg-linear-to-r from-gold-500 to-gold-400 rounded-full transition-all duration-300" style="width:0%"></div>
            </div>
            <p id="loading-detail" class="text-xs text-obsidian-500 mt-2" data-i18n="brain.kept">Downloaded once and kept by your browser. Nothing is sent anywhere.</p>
          </div>
        </div>

        <div class="mt-6 flex items-center justify-between gap-4">
          <p id="setup-note" class="text-xs text-obsidian-500"></p>
          <button id="start-duel" class="btn-primary px-8" disabled data-i18n="battle.begin">Begin the duel</button>
        </div>
      </div>

      <!-- The duel -->
      <div id="battle-arena" class="hidden">
        <div class="card-glass overflow-hidden">
          <div class="flex items-center justify-between p-4 border-b border-obsidian-700/50 bg-obsidian-900/50">
            <div>
              <p id="round-label" class="text-xs font-mono uppercase tracking-wider text-obsidian-500"></p>
              <p id="form-name" class="font-display text-xl font-bold text-gold-400"></p>
            </div>
            <div class="text-end">
              <p class="text-xs text-obsidian-500"><span data-i18n="battle.you">You</span> <span id="player-score" class="font-mono text-obsidian-200">0</span> · <span id="ai-score" class="font-mono text-gold-400">0</span> <span data-i18n="battle.opponent">Opponent</span></p>
              <p id="ai-model-badge" class="text-xs text-obsidian-500"></p>
            </div>
          </div>

          <div class="p-4 sm:p-6 space-y-5">
            <p id="form-brief" class="text-obsidian-200"></p>

            <!-- Opponent -->
            <div class="rounded-lg border border-obsidian-700/60 bg-obsidian-900/40 p-4">
              <div class="flex items-start gap-3">
                <div id="opponent-portrait" class="w-14 h-14 rounded-sm overflow-hidden shrink-0 flex items-center justify-center bg-obsidian-800 text-2xl"></div>
                <div class="min-w-0 flex-1">
                  <p class="text-xs uppercase tracking-wider text-obsidian-500" data-i18n="round.opponentPlays">Your opponent plays</p>
                  <p id="opponent-name" class="font-display font-bold text-obsidian-100"></p>
                  <p id="opponent-device" class="text-xs text-obsidian-400"></p>
                </div>
              </div>
              <p id="opponent-curse" class="hidden mt-3 text-sm text-crimson-300 border border-crimson-500/30 bg-crimson-500/10 rounded-sm px-3 py-2"></p>
              <!-- The verse is in the duel's language, which may read the other way from the interface. -->
              <blockquote id="opponent-verse" dir="auto" class="mt-3 whitespace-pre-line font-display text-lg text-obsidian-100 border-s-2 border-gold-500/40 ps-4 min-h-[3rem]"></blockquote>
            </div>

            <!-- Your move -->
            <div id="move-panel" class="space-y-4">
              <div>
                <div class="flex items-center justify-between mb-2">
                  <span class="text-xs uppercase tracking-wider text-obsidian-500" data-i18n="round.whoAnswers">Who answers?</span>
                  <span class="text-xs text-obsidian-400"><span data-i18n="round.ink">Ink</span> <span id="ink" class="font-mono text-gold-400"></span></span>
                </div>
                <div id="hand-characters" class="flex flex-wrap gap-2"></div>
              </div>
              <div id="hand-items-wrap" class="hidden">
                <span class="text-xs uppercase tracking-wider text-obsidian-500" data-i18n="round.items">Relics and potions (1 ink each)</span>
                <div id="hand-items" class="flex flex-wrap gap-2 mt-2"></div>
                <p id="item-note" class="mt-2 text-xs text-obsidian-400 min-h-[1rem]"></p>
              </div>

              <div class="grid md:grid-cols-5 gap-4">
                <div class="md:col-span-3">
                  <label for="verse-input" class="text-xs uppercase tracking-wider text-obsidian-500" data-i18n="round.yourVerse">Your verse</label>
                  <textarea id="verse-input" rows="5" maxlength="600" spellcheck="true" dir="auto"
                    class="mt-2 w-full bg-obsidian-900 border border-obsidian-700 rounded-lg px-4 py-3 text-obsidian-100 font-display text-lg leading-relaxed focus:border-gold-500/50 focus:outline-hidden"
                    placeholder="One line of verse per line…" data-i18n-placeholder="round.versePlaceholder"></textarea>
                </div>
                <div class="md:col-span-2">
                  <span class="text-xs uppercase tracking-wider text-obsidian-500" data-i18n="round.mustDo">What your verse must do</span>
                  <ul id="live-checks" class="mt-2 space-y-1.5 text-sm"></ul>
                  <p class="mt-3 text-xs text-obsidian-500"><span data-i18n="round.craftSoFar">Craft so far:</span> <span id="live-craft" class="font-mono text-gold-400">0</span></p>
                </div>
              </div>

              <div class="flex items-center justify-between gap-3">
                <div class="flex items-center gap-4">
                  <button id="mic-btn" class="flex items-center gap-2 text-xs px-3 py-2 rounded-lg border border-obsidian-700 text-obsidian-300 hover:text-gold-400 hover:border-gold-500/40 transition-colors" aria-pressed="false">
                    <span aria-hidden="true">🎙</span><span id="mic-label">Speak it</span>
                  </button>
                  <button id="voice-toggle" class="text-xs text-obsidian-500 hover:text-gold-400 transition-colors"><span id="voice-label">Voice: Off</span></button>
                </div>
                <button id="submit-verse" class="btn-primary px-8" disabled>Speak your verse</button>
              </div>
            </div>

            <!-- Verdict -->
            <div id="verdict" class="hidden"></div>
          </div>
        </div>
        <p class="text-center text-xs text-obsidian-600 mt-3"><span data-i18n="round.seedLabel">Match seed</span> <span id="seed-label" class="font-mono"></span>. <span data-i18n="round.seedNote">The same seed and deck draw the same forms.</span></p>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-3 gap-4 mt-8">
        <div class="card-glass p-4 text-center">
          <span class="text-2xl font-display font-bold text-gold-400" id="rounds-played">0</span>
          <p class="text-xs text-obsidian-500 mt-1" data-i18n="stats.rounds">Rounds played</p>
        </div>
        <div class="card-glass p-4 text-center">
          <span class="text-2xl font-display font-bold text-crimson-400" id="battles-total">0</span>
          <p class="text-xs text-obsidian-500 mt-1" data-i18n="stats.duels">Duels</p>
        </div>
        <div class="card-glass p-4 text-center">
          <span class="text-2xl font-display font-bold text-emerald-400" id="win-rate">--%</span>
          <p class="text-xs text-obsidian-500 mt-1" data-i18n="stats.won">Rounds won</p>
        </div>
      </div>
    </div>
  </section>

  <script>
    import { brainInfo, canOfferGrand, chooseTier, detectCapability, generate, isBrainLoaded, loadBrain, modelJudges, modelWrites, MODELS, type Tier } from '../lib/brain';
    import { CARD_CATALOG, drawRandomCard, getCardById, RARITY_COLORS, type Card, type Rarity } from '../lib/cards';
    import { addCard, getOwnedCardIds, getOwnedCards, getUniqueOwnedCount, recordBattleWin } from '../lib/inventory';
    import { getPlayerStats, incrementStat, setHighScore, syncCardStats } from '../lib/achievements';
    import { initAudio, isInitialized, playMusic, playRarityFanfare, playSfx, preloadSfx, duckMusic, unduckMusic, type Rarity as AudioRarity } from '../lib/audio-manager';
    import { getActiveDeck } from '../lib/deck-manager';
    import { CITY_CATALOG, decodeVariantId, getCityByCode, getOwnedVariants, type CityAbility } from '../lib/variants';
    import { isSpeaking, isVoiceLoaded, loadVoice, speak, stopSpeaking } from '../lib/thespian-voice';
    import { POTION_CURSE, POWER_WORD_BONUS, deviceForHouse, houseWhy } from '../lib/verse/devices';
    import {
      JUDGE_POOL, ROUNDS, createDuel, illegalMove, inkAt, matchWinner, moveCost, resolveRound, scoreVerse, starterDeck,
      type Duel, type DuelDeck, type PlayerMove, type RoundResult, type VerseScore,
    } from '../lib/verse/duel';
    import { cancelListening, EAR_MEGABYTES, isEarLoaded, isListening, loadEar, startListening, stopListening } from '../lib/ear';
    import { FORM_POINTS, getForm } from '../lib/verse/forms';
    import { CRITERIA } from '../lib/verse/judge';
    import { writeOpponentVerse, type Difficulty } from '../lib/verse/opponent';
    import { PACK_LANGS, hasPack, loadPack } from '../lib/verse/packs';
    import { referee } from '../lib/verse/referee';
    import { cleanVerse } from '../lib/verse/text';
    import { initI18n, languageName, locale, onLocaleChange, t, tm } from '../i18n';
    import { criterionName, curseName, curseRule, curseRuleTheirs, deviceBrief, deviceName, signatureText } from '../i18n/duel';
    import type { Msg } from '../lib/verse/msg';

    const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
    const el = (tag: string, cls = '', text = '') => {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text) e.textContent = text;
      return e;
    };

    // A line of status that must follow the interface language: the element remembers the
    // message it shows, so a change of language can say it again.
    const shown = new Map<HTMLElement, Msg | null>();
    function say$(target: HTMLElement, key: string | null, vars?: Msg['vars']) {
      shown.set(target, key ? { key, vars } : null);
      target.textContent = key ? t(key, vars) : '';
    }
    function resay() {
      for (const [target, m] of shown) target.textContent = m ? tm(m) : '';
    }

    // --- State ---
    const params = new URLSearchParams(location.search);
    let deck: DuelDeck;
    let duel: Duel | null = null;
    let roundIndex = 0;
    let moves: PlayerMove[] = [];
    let results: RoundResult[] = [];
    let move: PlayerMove = { charId: '' };
    let opponentVerse = '';
    let busy = false;
    let judging = false;
    let tier: Tier = 'none';
    let useModel = false;
    let voiceEnabled = false;
    let variantAbility: CityAbility | null = null;
    let equippedCity = '';
    /** What the arena is showing, so a change of language can draw it again. */
    let view: 'setup' | 'round' | 'verdict' | 'finished' = 'setup';
    let matchResult: 'player' | 'opponent' | null = null;
    let reward: Card | null = null;

    /** The language verses are measured in: the duel's, or the one chosen for the next duel. */
    const duelLang = () => duel?.lang ?? langSelect.value ?? 'en';

    // --- Stats ---
    function showStats() {
      const ps = getPlayerStats();
      $('rounds-played').textContent = String(ps.totalRounds);
      $('battles-total').textContent = String(ps.totalBattles);
      $('win-rate').textContent = ps.totalRounds > 0 ? `${Math.round((ps.battleWins / ps.totalRounds) * 100)}%` : '--%';
    }
    showStats();

    // --- Deck ---
    function cardChip(card: Card, extra = ''): HTMLElement {
      const b = el('div', `flex items-center gap-2 px-2 py-1.5 rounded-lg border border-obsidian-700 bg-obsidian-900/60 ${extra}`);
      const pic = el('div', 'w-8 h-8 rounded-sm overflow-hidden flex items-center justify-center bg-obsidian-800 shrink-0');
      if (card.image) {
        const img = document.createElement('img');
        img.src = card.image;
        img.alt = '';
        img.className = 'w-full h-full object-cover';
        pic.appendChild(img);
      } else pic.textContent = card.icon;
      b.appendChild(pic);
      const text = el('div', 'min-w-0');
      // Card names stay in English: they are the characters' names.
      text.appendChild(el('p', 'text-xs font-semibold text-obsidian-100 truncate', card.name));
      const curse = POTION_CURSE[card.id];
      const sub =
        card.type === 'Character' ? tm(deviceForHouse(card.house, duelLang()).name) : card.type === 'Potion' ? (curse ? curseName(curse) : t('chip.curse')) : t('chip.powerWords');
      text.appendChild(el('p', 'text-[10px] text-obsidian-400 truncate', sub));
      b.appendChild(text);
      return b;
    }

    function loadDeck() {
      const saved = getActiveDeck();
      const valid = saved && saved.characters.filter((id) => getCardById(id)).length >= ROUNDS;
      if (valid) {
        deck = { characters: saved!.characters, relics: saved!.relics, potions: saved!.potions };
        $('deck-name').textContent = saved!.name;
      } else {
        deck = starterDeck(getOwnedCardIds());
        $('deck-name').textContent = t('battle.starterDeck');
      }
      const wrap = $('deck-cards');
      wrap.replaceChildren();
      for (const id of [...deck.characters, ...deck.relics, ...deck.potions]) {
        const c = getCardById(id);
        if (c) wrap.appendChild(cardChip(c));
      }
    }

    // --- Language of the duel ---
    const langSelect = $<HTMLSelectElement>('language');
    const offered: string[] = [...PACK_LANGS];
    /**
     * Every language the game has verse data for is offered, with or without a model.
     * What changes with a model is who the player meets: in a language the loaded model
     * has not been shown to write verse in (docs/language/MODEL-EVAL.md) the opponent
     * plays written verse, and the picker says so beside the language's name.
     */
    function fillLanguages(prefer?: string) {
      const want = prefer ?? params.get('lang') ?? localStorage.getItem('inspired-mile-duel-lang') ?? locale();
      const info = useModel ? brainInfo() : null;
      langSelect.replaceChildren();
      for (const code of offered) {
        const o = document.createElement('option');
        o.value = code;
        const written = !!info && !modelWrites(info, code);
        o.dataset.opponent = info ? (written ? 'written' : 'model') : 'written';
        o.textContent = written ? `${languageName(code)} · ${t('badge.written')}` : languageName(code);
        langSelect.appendChild(o);
      }
      langSelect.value = offered.includes(want) ? want : 'en';
      languageNote();
    }
    /** Under the picker: who writes and who judges in the chosen language, when it is not the loaded model. */
    function languageNote() {
      const note = $('language-note');
      const info = useModel ? brainInfo() : null;
      const lang = langSelect.value || 'en';
      const lines: string[] = [];
      if (info && !modelWrites(info, lang)) lines.push(t('battle.lang.written', { language: languageName(lang), model: info.label }));
      if (info && !modelJudges(info, lang)) lines.push(t('battle.lang.rules', { language: languageName(lang), model: info.label }));
      note.textContent = lines.join(' ');
      note.dataset.writer = info && modelWrites(info, lang) ? 'model' : 'written';
      note.dataset.judge = info && modelJudges(info, lang) ? 'model' : 'rules';
      note.classList.toggle('hidden', lines.length === 0);
    }
    langSelect.addEventListener('change', () => {
      localStorage.setItem('inspired-mile-duel-lang', langSelect.value);
      languageNote();
      renderBadge();
      loadDeck();
    });

    // --- World card ---
    function renderEquipped() {
      const label = $('equipped-variant-label');
      if (variantAbility) {
        label.textContent = `${equippedCity} (${t('variant.bonus', { n: variantAbility.bonus, criterion: criterionName(variantAbility.axis) })})`;
        label.className = 'ms-2 text-xs font-semibold text-gold-400';
      } else {
        label.textContent = t('battle.noneEquipped');
        label.className = 'ms-2 text-xs font-semibold text-obsidian-400';
      }
    }
    function renderVariantPicker() {
      const owned = getOwnedVariants();
      if (!owned.length) return;
      $('variant-equip').classList.remove('hidden');
      const picker = $('variant-picker');
      picker.replaceChildren();
      const none = el('button', 'variant-pick w-full text-start text-xs p-2 rounded-sm hover:bg-obsidian-800 text-obsidian-400', t('battle.noWorldCard'));
      none.dataset.variantId = '';
      picker.appendChild(none);
      for (const v of owned) {
        const decoded = decodeVariantId(v.variantId);
        const city = decoded && getCityByCode(decoded.cityCode);
        const card = CARD_CATALOG.find((c) => c.id === v.baseCardId);
        if (!city || !card) continue;
        const cfg = CITY_CATALOG[city];
        const b = el('button', 'variant-pick w-full text-start text-xs p-2 rounded-sm hover:bg-obsidian-800 text-obsidian-300 flex items-center justify-between');
        b.dataset.variantId = v.variantId;
        b.appendChild(el('span', '', t('battle.cardInCity', { card: card.name, city })));
        b.appendChild(el('span', 'text-gold-500 text-[10px]', t('variant.bonus', { n: cfg.ability.bonus, criterion: criterionName(cfg.ability.axis) })));
        picker.appendChild(b);
      }
      renderEquipped();
    }
    $('equip-variant-btn').addEventListener('click', () => $('variant-picker').classList.toggle('hidden'));
    $('variant-picker').addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('.variant-pick') as HTMLElement | null;
      if (!b) return;
      const decoded = b.dataset.variantId ? decodeVariantId(b.dataset.variantId) : null;
      const city = decoded && getCityByCode(decoded.cityCode);
      variantAbility = city ? CITY_CATALOG[city].ability : null;
      equippedCity = city || '';
      renderEquipped();
      $('variant-picker').classList.add('hidden');
    });

    // --- Brain ---
    const startBtn = $<HTMLButtonElement>('start-duel');
    const BRAIN_KEY = 'inspired-mile-brain';
    const size = (mb: number) => (mb >= 1000 ? `${(mb / 1000).toFixed(1)} GB` : `${mb} MB`);

    function ready(noteKey: string | null) {
      say$($('setup-note'), noteKey);
      startBtn.disabled = false;
    }

    /** The model loader reports its progress in English; say it in the interface language. */
    function progressText(raw: string): string {
      const down = raw.match(/^Downloading (.+): (\d+) of (\d+) MB$/);
      if (down) return t('brain.downloading', { model: down[1], done: down[2], total: down[3] });
      const done = raw.match(/^(.+) ready$/);
      if (done) return t('brain.ready', { model: done[1] });
      return raw;
    }

    async function summon(which: Tier = tier) {
      if (which === 'none') return;
      tier = which;
      $('brain-choices').classList.add('hidden');
      $('loading-screen').classList.remove('hidden');
      say$($('loading-status'), 'brain.summoning');
      const ok = await loadBrain(tier, (p) => {
        shown.delete($('loading-status'));
        $('loading-status').textContent = progressText(p.text);
        $('loading-bar').style.width = `${p.percent}%`;
      });
      $('loading-screen').classList.add('hidden');
      if (ok) {
        const info = brainInfo()!;
        useModel = true;
        localStorage.setItem(BRAIN_KEY, info.tier);
        say$($('brain-status'), info.writesIn.length ? 'brain.loaded' : 'brain.loadedJudgeOnly', { model: info.label });
        fillLanguages(langSelect.value);
        loadDeck();
        ready(null);
      } else {
        useModel = false;
        fillLanguages(langSelect.value);
        say$($('brain-status'), 'brain.failed');
        ready('brain.noModel');
      }
    }

    async function initBrain() {
      const forced = params.get('brain');
      const cap = await detectCapability();
      tier = forced === 'rules' ? 'none' : chooseTier(cap);
      if (tier === 'none') {
        say$($('brain-status'), cap.webgpu ? 'brain.written' : 'brain.noWebgpu');
        ready('brain.noModel');
        return;
      }
      // Where the device can take it, Gemma is offered first: it writes better verse,
      // judges more reliably and, measured on Apple Metal, answers faster than LFM3.
      const first = canOfferGrand(cap) ? MODELS.grand : MODELS[tier];
      const second = canOfferGrand(cap) ? MODELS.standard : null;
      say$($('brain-status'), 'brain.canRun', { model: first.label, size: size(first.megabytes) });
      say$($('brain-model-btn'), 'brain.summon', { model: first.label, size: size(first.megabytes) });
      $('brain-choices').classList.remove('hidden');
      $('brain-model-btn').addEventListener('click', () => summon(first.tier));
      if (second) {
        const g = $('brain-other-btn');
        say$(g, 'brain.summonLighter', { model: second.label, size: size(second.megabytes) });
        g.classList.remove('hidden');
        g.addEventListener('click', () => summon(second.tier));
      }
      $('brain-rules-btn').addEventListener('click', () => {
        useModel = false;
        localStorage.setItem(BRAIN_KEY, 'rules');
        $('brain-choices').classList.add('hidden');
        say$($('brain-status'), 'brain.writtenReload');
        ready('brain.noModel');
      });
      // Someone who has already downloaded the model does not need asking again.
      // ?brain=grand|standard|lite picks a model outright (used by the model tests).
      if (forced === 'grand' || forced === 'standard' || forced === 'lite') summon(forced);
      else {
        const before = localStorage.getItem(BRAIN_KEY);
        if (before === 'grand' && canOfferGrand(cap)) summon('grand');
        else if (before === 'grand' || before === 'standard' || before === 'lite' || forced === 'model') summon(tier);
      }
    }

    // --- Voice ---
    function say(text: string) {
      if (!voiceEnabled) return;
      duckMusic();
      speak(text, undefined, duel?.lang ?? 'en');
      const timer = setInterval(() => {
        if (!isSpeaking()) {
          clearInterval(timer);
          unduckMusic();
        }
      }, 200);
    }
    const voiceLabel = $('voice-label');
    $('voice-toggle').addEventListener('click', async () => {
      voiceEnabled = !voiceEnabled;
      if (voiceEnabled && !isVoiceLoaded()) {
        say$(voiceLabel, 'voice.loading');
        voiceEnabled = await loadVoice();
      }
      say$(voiceLabel, voiceEnabled ? 'voice.on' : 'voice.off');
      if (!voiceEnabled) stopSpeaking();
    });

    // --- Microphone: speech is transcribed on the device ---
    const micBtn = $<HTMLButtonElement>('mic-btn');
    const micLabel = $('mic-label');
    async function finishTake() {
      say$(micLabel, 'mic.transcribing');
      micBtn.disabled = true;
      try {
        const said = await stopListening(duel?.lang ?? 'en');
        if (said) {
          verseInput.value = verseInput.value.trim() ? `${verseInput.value.trim()}\n${said}` : said;
          renderChecks();
          updateSubmit();
        }
        say$(micLabel, said ? 'mic.speak' : 'mic.heardNothing');
      } catch (err) {
        console.error('[mic]', err);
        say$(micLabel, 'mic.failed');
      }
      micBtn.disabled = false;
      micBtn.setAttribute('aria-pressed', 'false');
      micBtn.classList.remove('border-crimson-500', 'text-crimson-400');
    }
    micBtn.addEventListener('click', async () => {
      if (isListening()) return finishTake();
      if (!navigator.mediaDevices?.getUserMedia) {
        say$(micLabel, 'mic.none');
        return;
      }
      try {
        if (!isEarLoaded()) {
          micBtn.disabled = true;
          say$(micLabel, 'mic.loadingEar', { mb: EAR_MEGABYTES });
          const ok = await loadEar((raw) => {
            // The ear reports "Loading the ear: 42%" in English.
            const pct = raw.match(/(\d+)%/);
            if (pct) say$(micLabel, 'mic.loadingEarProgress', { percent: pct[1] });
          });
          micBtn.disabled = false;
          if (!ok) {
            say$(micLabel, 'mic.earFailed');
            return;
          }
        }
        await startListening(finishTake);
        say$(micLabel, 'mic.listening');
        micBtn.setAttribute('aria-pressed', 'true');
        micBtn.classList.add('border-crimson-500', 'text-crimson-400');
      } catch (err) {
        console.error('[mic]', err);
        cancelListening();
        micBtn.disabled = false;
        say$(micLabel, 'mic.denied');
      }
    });

    // --- Round ---
    const verseInput = $<HTMLTextAreaElement>('verse-input');
    const submitBtn = $<HTMLButtonElement>('submit-verse');

    function currentScore(): VerseScore | null {
      if (!duel || !move.charId) return null;
      const plan = duel.rounds[roundIndex];
      return scoreVerse({
        verse: verseInput.value,
        form: getForm(plan.formId),
        ctx: plan.ctx,
        card: getCardById(move.charId)!,
        deckCharacters: duel.player.characters,
        opponentVerse,
        curse: plan.opponent.curse,
        lent: move.relicId ? duel.playerRelics[move.relicId] : undefined,
      });
    }

    function checkRow(met: boolean, label: string, detail: string, tone = 'gold'): HTMLElement {
      const li = el('li', 'flex gap-2 items-start');
      li.appendChild(el('span', met ? `text-${tone === 'crimson' ? 'crimson' : 'emerald'}-400 shrink-0` : 'text-obsidian-600 shrink-0', met ? (tone === 'crimson' ? '✗' : '✓') : '○'));
      const text = el('span', met && tone !== 'crimson' ? 'text-obsidian-100' : tone === 'crimson' && met ? 'text-crimson-300' : 'text-obsidian-400');
      text.textContent = label;
      // The detail is evidence from the verse (its words, its counts), so it takes the verse's direction.
      if (detail) {
        const d = el('span', 'block text-[11px] text-obsidian-500', detail);
        d.dir = 'auto';
        text.appendChild(d);
      }
      li.appendChild(text);
      return li;
    }

    function renderChecks() {
      const list = $('live-checks');
      list.replaceChildren();
      const s = currentScore();
      if (!s || !duel) {
        list.appendChild(el('li', 'text-obsidian-500', t('live.chooseWho')));
        $('live-craft').textContent = '0';
        return;
      }
      const written = verseInput.value.trim().length > 0;
      for (const c of s.form.checks) list.appendChild(checkRow(c.met, t('live.points', { label: tm(c.label), points: c.points }), written ? c.detail : ''));
      const card = getCardById(move.charId)!;
      list.appendChild(checkRow(s.device.met, t('live.device', { name: deviceName(s.device.id), brief: deviceBrief(s.device.id, duel.lang) }), written ? s.device.detail : ''));
      list.appendChild(checkRow(s.signature.met, t('live.signature', { card: card.name }), signatureText(s.signature)));
      if (s.powerWords) {
        const lent = duel.playerRelics[move.relicId!];
        list.appendChild(checkRow(s.powerWords.met, t('live.power', { bonus: POWER_WORD_BONUS, words: lent.words.join(', ') }), s.powerWords.used.length ? t('live.powerUsed', { words: s.powerWords.used.join(', ') }) : ''));
      }
      if (s.curse) {
        list.appendChild(checkRow(
          s.curse.violations > 0,
          t('live.curse', { name: curseName(s.curse.id) }),
          s.curse.violations ? t('live.curseBroken', { n: s.curse.violations, penalty: s.curse.penalty }) : t('live.curseHolding'),
          'crimson',
        ));
      }
      $('live-craft').textContent = String(s.craft);
    }

    function renderHand() {
      if (!duel) return;
      const d = duel;
      const spent = moves.reduce((n, m) => n + moveCost(m), 0);
      const ink = inkAt(roundIndex, spent) - moveCost(move);
      $('ink').textContent = String(ink);

      const chars = $('hand-characters');
      chars.replaceChildren();
      for (const id of d.player.characters) {
        const card = getCardById(id);
        if (!card) continue;
        const used = moves.some((m) => m.charId === id);
        const chosen = move.charId === id;
        const b = cardChip(card, `cursor-pointer transition-all ${chosen ? 'border-gold-500/70 bg-gold-500/10' : ''} ${used ? 'opacity-30 pointer-events-none' : 'hover:border-gold-500/40'}`);
        b.setAttribute('role', 'button');
        b.dataset.charId = id;
        const why = houseWhy(card.house, d.lang);
        b.title = why ? tm(why) : '';
        if (!used) b.addEventListener('click', () => { move.charId = id; playSfx('ui-click'); renderHand(); renderChecks(); updateSubmit(); });
        chars.appendChild(b);
      }

      const items = $('hand-items');
      items.replaceChildren();
      const all = [...d.player.relics.map((id) => ({ id, kind: 'relic' as const })), ...d.player.potions.map((id) => ({ id, kind: 'potion' as const }))];
      $('hand-items-wrap').classList.toggle('hidden', all.length === 0);
      for (const { id, kind } of all) {
        const card = getCardById(id);
        if (!card) continue;
        const used = moves.some((m) => (kind === 'relic' ? m.relicId : m.potionId) === id);
        const chosen = (kind === 'relic' ? move.relicId : move.potionId) === id;
        const cantAfford = !chosen && ink < 1;
        const b = cardChip(card, `cursor-pointer transition-all ${chosen ? 'border-purple-500/70 bg-purple-500/10' : ''} ${used || cantAfford ? 'opacity-30 pointer-events-none' : 'hover:border-purple-500/40'}`);
        b.setAttribute('role', 'button');
        b.dataset.itemId = id;
        if (kind === 'relic') b.title = t('hand.lends', { words: d.playerRelics[id].words.join(', ') });
        else {
          const cast = d.playerCurses[id];
          b.title = t('hand.curses', { rule: curseRuleTheirs(cast.curseId, cast.param, d.lang) });
        }
        if (!used && !cantAfford) {
          b.addEventListener('click', () => {
            if (kind === 'relic') move.relicId = chosen ? undefined : id;
            else move.potionId = chosen ? undefined : id;
            playSfx('ui-click');
            renderHand();
            renderChecks();
          });
        }
        items.appendChild(b);
      }
      // Say in plain sight what the chosen items do; a tooltip is no use on a phone.
      const notes: string[] = [];
      if (move.relicId) notes.push(t('hand.relicNote', { card: getCardById(move.relicId)!.name, words: d.playerRelics[move.relicId].words.join(', ') }));
      if (move.potionId) {
        const cast = d.playerCurses[move.potionId];
        const card = getCardById(move.potionId)!.name;
        notes.push(roundIndex + 1 < ROUNDS
          ? t('hand.potionNote', { card, rule: curseRuleTheirs(cast.curseId, cast.param, d.lang) })
          : t('hand.potionLastRound', { card }));
      }
      $('item-note').textContent = notes.join(' ');
    }

    function updateSubmit() {
      submitBtn.disabled = busy || !move.charId || cleanVerse(verseInput.value).length === 0;
      submitBtn.textContent = judging ? t('round.deliberating') : t('round.submit');
    }

    verseInput.addEventListener('input', () => { renderChecks(); updateSubmit(); });

    /** The header of a round: its number, its form, the opponent's card and any curse. */
    function renderRoundHeader() {
      if (!duel) return;
      const plan = duel.rounds[roundIndex];
      const form = getForm(plan.formId);
      const card = getCardById(plan.opponent.charId)!;
      $('round-label').textContent = t('round.label', { n: roundIndex + 1, total: ROUNDS });
      $('form-name').textContent = tm(form.name);
      $('form-brief').textContent = tm(form.brief(plan.ctx));
      $('opponent-name').textContent = card.name;
      const device = deviceForHouse(card.house, duel.lang);
      $('opponent-device').textContent = t('round.device', { name: tm(device.name), brief: tm(device.brief(duel.lang)) });
      const curse = $('opponent-curse');
      if (plan.opponent.curse) {
        const c = plan.opponent.curse;
        curse.textContent = t('round.cursesYou', { card: card.name, name: curseName(c.curseId), rule: curseRule(c.curseId, c.param, duel.lang) });
        curse.classList.remove('hidden');
      } else curse.classList.add('hidden');
    }

    async function beginRound() {
      if (!duel) return;
      const plan = duel.rounds[roundIndex];
      const card = getCardById(plan.opponent.charId)!;
      view = 'round';
      move = { charId: '' };
      opponentVerse = '';
      verseInput.value = '';
      $('verdict').classList.add('hidden');
      $('verdict').replaceChildren();
      $('move-panel').classList.remove('hidden');

      renderRoundHeader();
      const portrait = $('opponent-portrait');
      portrait.replaceChildren();
      if (card.image) {
        const img = document.createElement('img');
        img.src = card.image;
        img.alt = '';
        img.className = 'w-full h-full object-cover';
        portrait.appendChild(img);
      } else portrait.textContent = card.icon;

      renderHand();
      renderChecks();
      busy = true;
      updateSubmit();

      // The opponent opens. It is written before the player commits a potion, so a
      // curse cast this round binds the opponent's NEXT verse; see castCarry below.
      const verseEl = $('opponent-verse');
      verseEl.textContent = '…';
      const written = await writeOpponentVerse({
        duel,
        roundIndex,
        curse: castCarry,
        previousPlayerVerse: results.at(-1)?.playerVerse,
        difficulty: ($<HTMLSelectElement>('difficulty').value as Difficulty) ?? 'player',
        generate: useModel && isBrainLoaded() && modelWrites(brainInfo(), duel.lang) ? (m, o) => generate(m, { maxTokens: o.maxTokens, temperature: o.temperature }) : undefined,
        onDraft: (n, of) => { verseEl.textContent = of > 1 ? t('round.composingDraft', { card: card.name, n, total: of }) : t('round.composing', { card: card.name }); },
      });
      opponentVerse = written.verse;
      verseEl.textContent = opponentVerse;
      verseEl.lang = duel.lang;
      verseEl.dataset.source = written.source;
      say(opponentVerse);
      busy = false;
      renderChecks();
      updateSubmit();
      verseInput.focus();
    }

    /** A potion played this round curses the opponent's next verse. */
    let castCarry: Duel['playerCurses'][string] | undefined;
    let castApplied: Duel['playerCurses'][string] | undefined;

    function side(title: string, s: VerseScore, judge: number, total: number, tone: string): HTMLElement {
      const box = el('div', 'rounded-lg border border-obsidian-700/60 bg-obsidian-900/50 p-3 text-xs space-y-1');
      box.appendChild(el('p', `font-display font-bold text-sm ${tone}`, title));
      const row = (k: string, v: string, cls = 'text-obsidian-300') => {
        const r = el('div', 'flex justify-between gap-2');
        r.appendChild(el('span', 'text-obsidian-500', k));
        r.appendChild(el('span', cls, v));
        box.appendChild(r);
      };
      row(t('verdict.form'), `${s.form.earned} / ${FORM_POINTS}${s.form.kept ? ' ✓' : ''}`);
      if (s.powerWords) row(t('verdict.powerWords'), s.powerWords.met ? `+${s.powerWords.bonus}` : t('verdict.notUsed'));
      row(deviceName(s.device.id), s.device.met ? '+½' : t('verdict.missed'));
      row(t('verdict.signature'), s.signature.met ? '+½' : t('verdict.missed'));
      if (s.synergy) row(t('verdict.synergy'), '+¼');
      row(t('verdict.multiplier'), `×${s.multiplier}`);
      if (s.curse) row(t('verdict.curse', { name: curseName(s.curse.id) }), s.curse.penalty ? `−${s.curse.penalty}` : t('verdict.held'), s.curse.penalty ? 'text-crimson-400' : 'text-emerald-400');
      row(t('verdict.craft'), String(s.craft), 'text-obsidian-100 font-semibold');
      row(t('verdict.judge'), `${judge} / ${JUDGE_POOL}`, 'text-obsidian-100 font-semibold');
      const sum = el('div', 'flex justify-between gap-2 border-t border-obsidian-700 pt-1 mt-1');
      sum.appendChild(el('span', 'text-obsidian-300 font-semibold', t('verdict.roundScore')));
      sum.appendChild(el('span', `${tone} font-bold text-sm`, String(total)));
      box.appendChild(sum);
      return box;
    }

    async function submit() {
      if (!duel || busy) return;
      const bad = illegalMove(duel, roundIndex, move, moves);
      if (bad) {
        say$($('setup-note'), `illegal.${bad}`);
        return;
      }
      busy = true;
      judging = true;
      updateSubmit();
      const playerVerse = cleanVerse(verseInput.value);
      const judge = await referee(playerVerse, opponentVerse, duel.lang);

      // The opponent's verse this round was written under the curse carried in, if any.
      const applied = castApplied;
      const scored = resolveRound(
        { ...duel, playerCurses: applied ? { ...duel.playerCurses, __carried: applied } : duel.playerCurses },
        roundIndex,
        { ...move, potionId: applied ? '__carried' : undefined },
        playerVerse,
        opponentVerse,
        judge,
        results.at(-1)?.playerVerse,
      );

      // World card: bonus craft when you take its criterion from the judge.
      if (variantAbility) {
        const criterion = variantAbility.axis === 'shakespeare' ? 'allusion' : variantAbility.axis;
        if (judge.criteria[criterion] === 'player') {
          scored.playerTotal += variantAbility.bonus;
          scored.winner = scored.playerTotal >= scored.opponentTotal ? 'player' : 'opponent';
        }
      }

      results.push(scored);
      moves.push({ ...move });
      castApplied = castCarry = move.potionId ? duel.playerCurses[move.potionId] : undefined;

      incrementStat('totalRounds');
      if (scored.winner === 'player') {
        incrementStat('battleWins');
        recordBattleWin();
        playSfx('battle-victory');
      } else playSfx('battle-defeat');
      setHighScore(scored.playerTotal);
      $('player-score').textContent = String(results.filter((r) => r.winner === 'player').length);
      $('ai-score').textContent = String(results.filter((r) => r.winner === 'opponent').length);
      showStats();
      busy = false;
      judging = false;
      updateSubmit();
      view = 'verdict';
      showVerdict(scored, true);
    }
    submitBtn.addEventListener('click', submit);

    function showVerdict(r: RoundResult, scroll: boolean) {
      if (!duel) return;
      $('move-panel').classList.add('hidden');
      const v = $('verdict');
      v.replaceChildren();
      v.classList.remove('hidden');
      v.dataset.winner = r.winner;

      const mine = el('blockquote', 'whitespace-pre-line font-display text-lg text-obsidian-100 border-s-2 border-crimson-500/40 ps-4 mb-4', r.playerVerse);
      mine.dir = 'auto';
      v.appendChild(el('p', 'text-xs uppercase tracking-wider text-obsidian-500 mb-1', t('verdict.yourAnswer')));
      v.appendChild(mine);

      const theirCard = getCardById(duel.rounds[r.index].opponent.charId)!.name;
      v.appendChild(el('p', `font-display text-2xl font-bold mb-3 ${r.winner === 'player' ? 'text-emerald-400' : 'text-crimson-400'}`, r.winner === 'player' ? t('verdict.roundYours') : t('verdict.roundTheirs', { card: theirCard })));

      const grid = el('div', 'grid sm:grid-cols-2 gap-3');
      grid.appendChild(side(t('battle.you'), r.player, r.judge.player, r.playerTotal, 'text-crimson-300'));
      grid.appendChild(side(t('battle.opponent'), r.opponent, r.judge.opponent, r.opponentTotal, 'text-gold-300'));
      v.appendChild(grid);

      const crit = el('div', 'mt-3 flex flex-wrap gap-2 text-[11px]');
      for (const c of CRITERIA) {
        const who = r.judge.criteria[c] ?? 'split';
        crit.appendChild(el(
          'span',
          `px-2 py-0.5 rounded-full border ${who === 'player' ? 'border-emerald-500/40 text-emerald-300' : who === 'opponent' ? 'border-gold-500/40 text-gold-300' : 'border-obsidian-700 text-obsidian-400'}`,
          t('verdict.criterion', { criterion: criterionName(c), who: t(`verdict.who.${who}`) }),
        ));
      }
      v.appendChild(crit);
      const info = brainInfo();
      v.appendChild(el('p', 'mt-2 text-[11px] text-obsidian-500', r.judge.source === 'model' && info
        ? t(info.judge === 'grade' ? 'verdict.judgedGrade' : 'verdict.judgedCompare', { model: info.label })
        // A model is loaded but does not judge this language: say that, not "no model is running".
        : useModel && info && duel && !modelJudges(info, duel.lang)
          ? t('battle.lang.rules', { language: languageName(duel.lang), model: info.label })
          : t('verdict.judgedRules')));

      const winner = matchWinner(results);
      const done = winner !== null || results.length >= ROUNDS;
      const next = el('button', 'btn-primary mt-5 px-8', done ? t('verdict.seeResult') : t('verdict.next'));
      next.id = 'next-round';
      next.dataset.done = String(done);
      next.addEventListener('click', () => {
        if (done) return finish(winner ?? (results.filter((x) => x.winner === 'player').length * 2 > results.length ? 'player' : 'opponent'));
        roundIndex++;
        beginRound();
      });
      v.appendChild(next);
      if (scroll) next.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function finish(winner: 'player' | 'opponent') {
      view = 'finished';
      matchResult = winner;
      reward = null;
      if (winner === 'player') {
        reward = drawRandomCard();
        addCard(reward.id, 'battle');
        syncCardStats(getUniqueOwnedCount(), getOwnedCards().length);
        const rarity = reward.rarity as AudioRarity;
        setTimeout(() => playRarityFanfare(rarity), 300);
      }
      renderFinish();
    }

    function renderFinish() {
      const winner = matchResult;
      if (!winner) return;
      const v = $('verdict');
      v.replaceChildren();
      v.dataset.match = winner;
      $('round-label').textContent = t('end.over');
      $('form-name').textContent = winner === 'player' ? t('end.victory') : t('end.defeat');
      $('form-brief').textContent = '';
      v.appendChild(el('p', `font-display text-3xl font-bold mb-2 ${winner === 'player' ? 'text-emerald-400' : 'text-crimson-400'}`, winner === 'player' ? t('end.won') : t('end.lost')));
      v.appendChild(el('p', 'text-sm text-obsidian-400 mb-4', t('end.tally', {
        you: results.filter((r) => r.winner === 'player').length,
        them: results.filter((r) => r.winner === 'opponent').length,
        total: results.reduce((s, r) => s + r.playerTotal, 0),
      })));

      if (reward) {
        const box = el('div', 'inline-flex items-center gap-3 card-glass p-3 border-gold-500/30 mb-4');
        box.id = 'battle-reward';
        box.appendChild(cardChip(reward));
        box.appendChild(el('span', `px-1.5 py-0.5 text-xs rounded-full ${RARITY_COLORS[reward.rarity as Rarity] ?? ''}`, t(`rarity.${String(reward.rarity).toLowerCase()}`)));
        v.appendChild(el('p', 'text-xs text-emerald-400 font-semibold', t('end.cardEarned')));
        v.appendChild(box);
      }
      const again = el('button', 'btn-primary px-8 block', t('end.again'));
      again.id = 'duel-again';
      again.addEventListener('click', () => start(Math.floor(Math.random() * 2 ** 31)));
      v.appendChild(again);
    }

    function renderBadge() {
      const info = useModel ? brainInfo() : null;
      const lang = duelLang();
      // Who the player meets in this language: the model, the written opponent judged by the model, or neither.
      $('ai-model-badge').textContent = !info || (!modelWrites(info, lang) && !modelJudges(info, lang))
        ? t('badge.written')
        : t(modelWrites(info, lang) ? 'badge.onDevice' : 'badge.writtenJudged', { model: info.label });
    }

    async function start(seed: number) {
      const lang = langSelect.value || 'en';
      startBtn.disabled = true;
      // The verses, acrostic words and power words of the duel's language.
      await loadPack(lang);
      duel = createDuel(seed, lang, (loadDeck(), deck));
      roundIndex = 0;
      moves = [];
      results = [];
      matchResult = null;
      castCarry = castApplied = undefined;
      $('seed-label').textContent = String(seed);
      $('player-score').textContent = '0';
      $('ai-score').textContent = '0';
      renderBadge();
      $('duel-setup').classList.add('hidden');
      $('battle-arena').classList.remove('hidden');
      incrementStat('totalBattles');
      showStats();
      if (!isInitialized()) initAudio();
      playMusic('battle-beat', 800);
      preloadSfx(['ui-whoosh', 'battle-victory', 'battle-defeat', 'fanfare-common', 'fanfare-rare', 'fanfare-legendary', 'ui-click']);
      beginRound();
    }

    startBtn.addEventListener('click', () => {
      const s = Number(params.get('seed'));
      start(Number.isFinite(s) && s > 0 ? s : Math.floor(Math.random() * 2 ** 31));
    });

    /** Draw again everything that was built with t(): called when the interface language changes. */
    function redraw() {
      resay();
      const chosen = langSelect.value;
      fillLanguages(chosen);
      loadDeck();
      renderVariantPicker();
      updateSubmit();
      if (!duel) return;
      renderBadge();
      if (view === 'finished') return renderFinish();
      renderRoundHeader();
      renderHand();
      renderChecks();
      if (view === 'verdict' && results.length) showVerdict(results[results.length - 1], false);
    }

    // --- Start-up: the interface language first, then everything that speaks it ---
    initI18n().then(() => {
      say$($('brain-status'), 'brain.checking');
      say$(micLabel, 'mic.speak');
      say$(voiceLabel, 'voice.off');
      fillLanguages();
      loadDeck();
      renderVariantPicker();
      updateSubmit();
      initBrain();
      onLocaleChange((l) => {
        // A visitor who changes the interface language most likely wants to duel in it:
        // make it the duel's language too, where it is on offer and no duel is under way.
        if (!duel && offered.includes(l)) langSelect.value = l;
        redraw();
      });
    });
  </script>
</BaseLayout>
