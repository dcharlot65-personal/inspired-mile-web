---
import BaseLayout from '../layouts/BaseLayout.astro';
import T from '../components/T.astro';
import { loadArea, t } from '../i18n';
import { num, quoted } from '../i18n/pages/runtime';
import { elementName, houseInitial, houseName, rarityName } from '../i18n/pages/terms';
import { CARD_CATALOG } from '../lib/cards';

// English at build time; the script at the foot of the page puts it in the visitor's language.
await Promise.all(['home', 'card-terms'].map((a) => loadArea(a)));

const features = [
  { icon: '&#9813;', id: 'cards' },
  { icon: '&#9876;', id: 'duel' },
  { icon: '&#127183;', id: 'earn' },
  { icon: '&#128279;', id: 'private' },
];

const houses = [
  { house: 'Montague', work: 'romeo-and-juliet', color: 'from-crimson-500 to-crimson-700' },
  { house: 'Capulet', work: 'romeo-and-juliet', color: 'from-blue-500 to-blue-700' },
  { house: 'Danish Court', work: 'hamlet', color: 'from-purple-500 to-purple-700' },
  { house: 'Forest of Arden', work: 'as-you-like-it', color: 'from-emerald-500 to-emerald-700' },
].map((h) => ({ ...h, count: CARD_CATALOG.filter((c) => c.house === h.house).length }));

const sonnetMan = CARD_CATALOG.find((c) => c.id === 'SM-001')!;
const houseCount = new Set(CARD_CATALOG.filter((c) => c.type === 'Character').map((c) => c.house)).size;
---

<BaseLayout title="Home" description={t('home.meta.description')} descriptionKey="home.meta.description" i18nAreas={['home']}>

  <!-- Hero Section -->
  <section class="relative min-h-[90vh] flex items-center overflow-hidden">
    <!-- Background effects -->
    <div class="absolute inset-0">
      <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-gold-500/5 rounded-full blur-3xl"></div>
      <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-crimson-500/5 rounded-full blur-3xl"></div>
      <div class="absolute inset-0 bg-linear-to-b from-obsidian-950 via-transparent to-obsidian-950"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <!-- Left: Text -->
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gold-500/10 border border-gold-500/20 mb-6">
            <span class="w-2 h-2 rounded-full bg-gold-400 animate-pulse"></span>
            <!-- The name of Devon Glover's programme: a proper name, the same in every language. -->
            <span class="text-gold-400 text-xs font-medium tracking-wide uppercase" lang="en" translate="no" data-proper-name>Shakespeare on the Go</span>
          </div>

          <T k="home.hero.title" as="h1" class="text-4xl sm:text-5xl lg:text-6xl font-display font-bold leading-tight mb-6" bClass="block text-gradient" />

          <T k="home.hero.body" as="p" class="text-lg text-obsidian-300 leading-relaxed mb-8 max-w-lg" />

          <div class="flex flex-wrap gap-4">
            <a href="/playground" class="btn-primary">
              <T k="home.cta.playground" />
              <svg class="w-4 h-4 ms-2 rtl:-scale-x-100" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </a>
            <a href="/collection" class="btn-secondary"><T k="home.cta.collection" /></a>
          </div>

          <div class="flex items-start gap-6 sm:gap-8 mt-10 text-sm text-obsidian-400">
            <!-- The first two columns keep their longest word (in Japanese, their longest phrase: 家門
                 split one character per line); the long third one gives way. -->
            <div class="min-w-min">
              <span class="block text-2xl font-display font-bold text-gold-400" data-num={CARD_CATALOG.length}>{num(CARD_CATALOG.length)}</span>
              <T k="home.stat.cards" />
            </div>
            <div class="w-px self-stretch bg-obsidian-700"></div>
            <div class="min-w-min">
              <span class="block text-2xl font-display font-bold text-gold-400" data-num={houseCount}>{num(houseCount)}</span>
              <T k="home.stat.houses" />
            </div>
            <div class="w-px self-stretch bg-obsidian-700"></div>
            <div class="min-w-0">
              <span class="block text-2xl font-display font-bold text-gold-400" data-num="0">{num(0)}</span>
              <T k="home.stat.servers" />
            </div>
          </div>
        </div>

        <!-- Right: Card Preview -->
        <div class="flex justify-center lg:justify-end">
          <div class="relative">
            <!-- Glow effect -->
            <div class="absolute inset-0 bg-gold-500/20 blur-3xl rounded-full scale-75"></div>

            <!-- Main card -->
            <div class="relative w-72 h-[420px] rounded-2xl overflow-hidden animate-float glow-gold">
              <div class="absolute inset-0 bg-linear-to-br from-obsidian-800 via-obsidian-900 to-obsidian-950 border-2 border-gold-500/30 rounded-2xl">
                <!-- Card header -->
                <div class="p-4 flex items-center justify-between">
                  <span class="text-xs font-mono text-gold-500/60">{sonnetMan.id}</span>
                  <span class="text-xs text-crimson-400"><T k="card-terms.stat.atk" /> <span class="font-mono" data-num={sonnetMan.atk}>{num(sonnetMan.atk)}</span></span>
                </div>

                <!-- Card art area -->
                <div class="mx-4 h-48 rounded-lg bg-linear-to-br from-gold-500/10 to-crimson-500/10 border border-gold-500/20 overflow-hidden">
                  <img src={sonnetMan.image} alt={sonnetMan.name} class="w-full h-full object-cover" fetchpriority="high" decoding="async" />
                </div>

                <!-- Card info: the name and the line come from the card data as they are -->
                <div class="p-4">
                  <h3 class="font-display text-lg font-bold text-gold-300" data-card-text><bdi>{sonnetMan.name}</bdi></h3>
                  <p class="text-xs text-obsidian-400 mt-1"><T k="home.card.role" /> &middot; <span data-i18n-html="rarity.legendary">{rarityName(sonnetMan.rarity)}</span></p>
                  <div class="mt-3 flex items-center gap-2">
                    <span class="px-2 py-0.5 text-xs rounded-sm bg-crimson-500/20 text-crimson-400 border border-crimson-500/30" data-i18n-html="card-terms.element.fire">{elementName(sonnetMan.element)}</span>
                    <T k="home.card.bard" class="px-2 py-0.5 text-xs rounded-sm bg-gold-500/20 text-gold-400 border border-gold-500/30" />
                  </div>
                  <p class="text-xs text-obsidian-400 mt-3 italic leading-relaxed" data-card-text set:html={quoted(sonnetMan.quote, 'en')} />
                </div>

                <!-- Card footer -->
                <div class="absolute bottom-0 left-0 right-0 p-3 flex items-center justify-between bg-obsidian-950/80">
                  <div class="flex items-center gap-3 text-xs text-obsidian-500">
                    <span><T k="card-terms.stat.hp" /> <span data-num={sonnetMan.hp}>{num(sonnetMan.hp)}</span></span>
                    <span><T k="card-terms.stat.def" /> <span data-num={sonnetMan.def}>{num(sonnetMan.def)}</span></span>
                  </div>
                  <div class="flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-gold-400"></span>
                    <span class="w-1.5 h-1.5 rounded-full bg-gold-400"></span>
                    <span class="w-1.5 h-1.5 rounded-full bg-gold-400"></span>
                    <span class="w-1.5 h-1.5 rounded-full bg-gold-400/30"></span>
                    <span class="w-1.5 h-1.5 rounded-full bg-gold-400/30"></span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Secondary floating cards -->
            <div class="absolute -left-12 top-16 w-48 h-72 rounded-xl bg-linear-to-br from-obsidian-800 to-obsidian-900 border border-crimson-500/20 -rotate-12 opacity-40 -z-10"></div>
            <div class="absolute -right-8 top-24 w-48 h-72 rounded-xl bg-linear-to-br from-obsidian-800 to-obsidian-900 border border-blue-500/20 rotate-[8deg] opacity-30 -z-10"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="section-padding">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <T k="home.platform.title" as="h2" class="text-3xl sm:text-4xl font-display font-bold mb-4" />
        <T k="home.platform.body" as="p" class="text-obsidian-400 max-w-2xl mx-auto" />
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {features.map((feature) => (
          <div class="card-glass p-6 hover:border-gold-500/30 transition-all duration-300 group">
            <div class="text-3xl mb-4 group-hover:scale-110 transition-transform" set:html={feature.icon} />
            <T k={`home.feature.${feature.id}.title`} as="h3" class="font-display text-lg font-semibold text-obsidian-100 mb-2" />
            <T k={`home.feature.${feature.id}.body`} as="p" class="text-sm text-obsidian-400 leading-relaxed" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Houses Section -->
  <section class="section-padding bg-obsidian-900/30">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <T k="home.houses.title" as="h2" class="text-3xl sm:text-4xl font-display font-bold mb-4" />
        <T k="home.houses.body" as="p" class="text-obsidian-400 max-w-2xl mx-auto" />
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {houses.map((house) => (
          <div class="card-glass p-6 hover:border-gold-500/30 transition-all duration-300 group">
            <div class={`w-12 h-12 rounded-lg bg-linear-to-br ${house.color} flex items-center justify-center mb-4 group-hover:scale-110 transition-transform`}>
              <span class="text-white font-display font-bold text-lg" data-house-initial={house.house}>{houseInitial(house.house, 'en')}</span>
            </div>
            <h3 class="font-display text-lg font-semibold text-obsidian-100 mb-1" data-house={house.house}>{houseName(house.house)}</h3>
            <T k={`card-terms.work.${house.work}`} as="p" class="text-xs text-obsidian-500 mb-3 italic" />
            <T k="home.houses.cards" vars={{ n: house.count }} class="text-xs text-obsidian-400" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Cross-Mile Spoken Sanctuary · Live CFW1 World Shaper -->
  <section id="spoken-sanctuary" class="section-padding" aria-labelledby="spoken-sanctuary-title">
    <div class="max-w-5xl mx-auto">
      <div class="card-glass p-6 sm:p-8 border border-gold-500/25">
        <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
          <div class="min-w-0">
            <T k="home.spoken.eyebrow" as="p" class="text-xs font-mono text-gold-400 uppercase tracking-wider mb-1.5" />
            <T k="home.spoken.title" as="h2" id="spoken-sanctuary-title" class="text-2xl sm:text-3xl font-display font-bold text-obsidian-100" bClass="text-gradient" />
            <T k="home.spoken.body" as="p" class="text-sm text-obsidian-400 mt-2 max-w-2xl leading-relaxed" />
          </div>
          <div class="flex flex-wrap items-center gap-2 max-w-full">
            <span data-spoken-status class="text-xs font-mono px-3 py-1 rounded-full border border-emerald-500/30 bg-emerald-500/10 text-emerald-400">
              {t('home.spoken.vaultCurated')}
            </span>
            <label for="sonnet-spoken-model" class="sr-only" data-i18n-html="home.spoken.modelLabel">{t('home.spoken.modelLabel')}</label>
            <select
              id="sonnet-spoken-model"
              data-spoken-model
              data-proper-name
              lang="en"
              dir="ltr"
              aria-label={t('home.spoken.modelLabel')}
              data-i18n-attr="aria-label:home.spoken.modelLabel"
              class="max-w-full text-xs font-mono bg-obsidian-950 border border-gold-500/40 rounded-lg px-3 py-2 text-obsidian-100 focus:border-gold-400 focus:outline-hidden"
            >
              <option value="tier0-rust">Tier-0 Rust 0ms</option>
              <option value="inkling-2-mini" selected>Inkling 2 Mini · 3.4B Looped</option>
              <option value="liquid-lfm-3.5">Liquid AI LFM 3.5 · 2B Tri-Hybrid</option>
              <option value="gemma-4-e2b-web">Gemma 4 E2B Web · LiteRT-LM</option>
              <option value="qwen-3.6-webllm">Qwen 3.6 WebLLM</option>
              <option value="nemotron-3.5-asr">Nemotron 3.5 ASR</option>
              <option value="mistral-large-4">Mistral Large 4 · Frontier</option>
            </select>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 mb-6">
          <label for="sonnet-spoken-wish" class="sr-only" data-i18n-html="home.spoken.wishPlaceholder">{t('home.spoken.wishPlaceholder')}</label>
          <input
            id="sonnet-spoken-wish"
            type="text"
            data-spoken-wish
            data-user-text
            spellcheck="false"
            autocomplete="off"
            placeholder={t('home.spoken.wishPlaceholder')}
            data-i18n-attr="placeholder:home.spoken.wishPlaceholder"
            class="flex-1 min-w-0 bg-obsidian-950 border border-obsidian-700 rounded-lg px-4 py-3 text-sm text-obsidian-100 placeholder:text-obsidian-500 focus:border-gold-500/60 focus:outline-hidden"
          />
          <button
            type="button"
            data-spoken-mic
            class="hidden btn-secondary px-4 py-2.5 text-xs whitespace-nowrap"
          >
            {t('home.spoken.speakBtn')}
          </button>
          <a
            data-spoken-launch
            href="https://chessfighter.inspiredmile.com/#mode=spoken&model=inkling-2-mini&wish=rainy%20night%20obsidian%20forge%20low%20gravity%20four%20towers%20painted"
            class="btn-primary px-5 py-3 text-sm whitespace-nowrap"
          >
            <T k="home.spoken.morphBtn" />
          </a>
        </div>

        <div class="grid sm:grid-cols-2 gap-3 mb-5">
          <div data-spoken-card class="rounded-xl border border-obsidian-700/70 bg-obsidian-950/75 p-4 flex flex-col justify-between gap-2.5 hover:border-gold-500/40 transition-colors min-w-0">
            <div class="flex items-center justify-between gap-2">
              <span data-spoken-badge class="text-[11px] font-mono px-2.5 py-0.5 rounded-full border border-gold-500/40 bg-gold-500/10 text-gold-300">2 · PAINTED</span>
              <span data-spoken-votes dir="ltr" class="text-xs font-mono text-emerald-400">▲ 31</span>
            </div>
            <div class="min-w-0">
              <h3 data-spoken-title data-proper-name lang="en" dir="ltr" class="font-display text-sm font-semibold text-obsidian-100 truncate">GOLDEN SANCTUM CINEMA</h3>
              <p data-spoken-meta data-proper-name lang="en" dir="ltr" class="text-xs font-mono text-obsidian-400 mt-1 line-clamp-2 break-words">CFW1-AgICAAH1 · "golden sanctum pyramid platforms jade staffs painted orbit camera"</p>
            </div>
            <a
              data-spoken-world-link
              href="https://chessfighter.inspiredmile.com/#mode=spoken&cfw1=CFW1-AgICAAH1&model=inkling-2-mini&wish=golden%20sanctum%20pyramid%20platforms%20jade%20staffs%20painted%20orbit%20camera"
              class="inline-flex items-center gap-1 text-xs font-semibold text-gold-400 hover:text-gold-300 transition-colors mt-1"
            >
              <span data-spoken-enter-label>{t('home.spoken.enterArena')}</span>
            </a>
          </div>

          <div data-spoken-card class="rounded-xl border border-obsidian-700/70 bg-obsidian-950/75 p-4 flex flex-col justify-between gap-2.5 hover:border-gold-500/40 transition-colors min-w-0">
            <div class="flex items-center justify-between gap-2">
              <span data-spoken-badge class="text-[11px] font-mono px-2.5 py-0.5 rounded-full border border-gold-500/40 bg-gold-500/10 text-gold-300">2 · PAINTED</span>
              <span data-spoken-votes dir="ltr" class="text-xs font-mono text-emerald-400">▲ 26</span>
            </div>
            <div class="min-w-0">
              <h3 data-spoken-title data-proper-name lang="en" dir="ltr" class="font-display text-sm font-semibold text-obsidian-100 truncate">MOONLIT LOW-G TOWERS</h3>
              <p data-spoken-meta data-proper-name lang="en" dir="ltr" class="text-xs font-mono text-obsidian-400 mt-1 line-clamp-2 break-words">CFW1-AgMCAAH8 · "obsidian forge wire-fu low gravity four towers painted"</p>
            </div>
            <a
              data-spoken-world-link
              href="https://chessfighter.inspiredmile.com/#mode=spoken&cfw1=CFW1-AgMCAAH8&model=inkling-2-mini&wish=obsidian%20forge%20wire-fu%20low%20gravity%20four%20towers%20painted"
              class="inline-flex items-center gap-1 text-xs font-semibold text-gold-400 hover:text-gold-300 transition-colors mt-1"
            >
              <span data-spoken-enter-label>{t('home.spoken.enterArena')}</span>
            </a>
          </div>

          <div data-spoken-card class="rounded-xl border border-obsidian-700/70 bg-obsidian-950/75 p-4 flex flex-col justify-between gap-2.5 hover:border-gold-500/40 transition-colors min-w-0">
            <div class="flex items-center justify-between gap-2">
              <span data-spoken-badge class="text-[11px] font-mono px-2.5 py-0.5 rounded-full border border-obsidian-600 text-obsidian-300">1 · SIMPLE</span>
              <span data-spoken-votes dir="ltr" class="text-xs font-mono text-emerald-400">▲ 19</span>
            </div>
            <div class="min-w-0">
              <h3 data-spoken-title data-proper-name lang="en" dir="ltr" class="font-display text-sm font-semibold text-obsidian-100 truncate">GREYBOX WIRE-FU DOJO</h3>
              <p data-spoken-meta data-proper-name lang="en" dir="ltr" class="text-xs font-mono text-obsidian-400 mt-1 line-clamp-2 break-words">CFW1-AQEBAgF5 · "simple greybox twin platforms low gravity pure kung-fu"</p>
            </div>
            <a
              data-spoken-world-link
              href="https://chessfighter.inspiredmile.com/#mode=spoken&cfw1=CFW1-AQEBAgF5&model=inkling-2-mini&wish=simple%20greybox%20twin%20platforms%20low%20gravity%20pure%20kung-fu"
              class="inline-flex items-center gap-1 text-xs font-semibold text-gold-400 hover:text-gold-300 transition-colors mt-1"
            >
              <span data-spoken-enter-label>{t('home.spoken.enterArena')}</span>
            </a>
          </div>

          <div data-spoken-card class="rounded-xl border border-obsidian-700/70 bg-obsidian-950/75 p-4 flex flex-col justify-between gap-2.5 hover:border-gold-500/40 transition-colors min-w-0">
            <div class="flex items-center justify-between gap-2">
              <span data-spoken-badge class="text-[11px] font-mono px-2.5 py-0.5 rounded-full border border-gold-500/40 bg-gold-500/10 text-gold-300">2 · PAINTED</span>
              <span data-spoken-votes dir="ltr" class="text-xs font-mono text-emerald-400">▲ 16</span>
            </div>
            <div class="min-w-0">
              <h3 data-spoken-title data-proper-name lang="en" dir="ltr" class="font-display text-sm font-semibold text-obsidian-100 truncate">VOLCANIC SPEAR BRIDGE</h3>
              <p data-spoken-meta data-proper-name lang="en" dir="ltr" class="text-xs font-mono text-obsidian-400 mt-1 line-clamp-2 break-words">CFW1-AAMDBAFy · "citadelle rampart sky bridge viper launchers heavy iron painted"</p>
            </div>
            <a
              data-spoken-world-link
              href="https://chessfighter.inspiredmile.com/#mode=spoken&cfw1=CFW1-AAMDBAFy&model=inkling-2-mini&wish=citadelle%20rampart%20sky%20bridge%20viper%20launchers%20heavy%20iron%20painted"
              class="inline-flex items-center gap-1 text-xs font-semibold text-gold-400 hover:text-gold-300 transition-colors mt-1"
            >
              <span data-spoken-enter-label>{t('home.spoken.enterArena')}</span>
            </a>
          </div>
        </div>

        <details class="border-t border-obsidian-800 pt-4 text-xs text-obsidian-400">
          <summary class="cursor-pointer font-mono font-medium text-obsidian-200 hover:text-gold-400 transition-colors">
            <T k="home.spoken.agentSummary" />
          </summary>
          <div class="mt-3 flex flex-wrap items-center gap-2" dir="ltr">
            <code
              data-spoken-curl
              data-proper-name
              lang="en"
              class="flex-1 min-w-0 px-3 py-2 rounded-lg border border-obsidian-700 bg-obsidian-950 text-emerald-400 font-mono text-[11px] overflow-x-auto whitespace-nowrap"
            >{`curl -X POST https://chessfighter.inspiredmile.com/ws/agent/morf -H "Content-Type: application/json" -d '{"room":"SANCTUM","model":"inkling-2-mini","wish":"rainy night obsidian forge low gravity four towers painted"}'`}</code>
            <button
              type="button"
              data-spoken-copy
              class="px-3 py-2 rounded-lg border border-obsidian-700 bg-obsidian-900 text-obsidian-200 font-mono text-xs hover:border-gold-500/40 transition-colors"
            >
              {t('home.spoken.copy')}
            </button>
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section-padding">
    <div class="max-w-4xl mx-auto text-center">
      <div class="card-glass p-10 sm:p-16 glow-gold">
        <T k="home.ready.title" as="h2" class="text-3xl sm:text-4xl font-display font-bold mb-4" />
        <T k="home.ready.body" as="p" class="text-obsidian-300 mb-8 max-w-lg mx-auto" />
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/battle" class="btn-danger">
            <T k="home.ready.arena" />
            <svg class="w-4 h-4 ms-2 rtl:-scale-x-100" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
          <a href="/playground" class="btn-secondary"><T k="home.ready.earn" /></a>
          <!-- The line above names the Theatre; it is linked here (owner decision D-03). The words are the theatre page's own. -->
          <a href="/theatre" id="home-theatre" class="btn-secondary"><span data-i18n="theatre.enterVr">Enter the theatre</span></a>
        </div>
      </div>
    </div>
  </section>

  <script>
    import { initAudio, isInitialized, playMusic } from '../lib/audio-manager';
    import { initSonnetSpokenPortal } from '../lib/spoken-portal';
    import { initPage } from '../i18n/pages/runtime';
    import { locale } from '../i18n';
    import { houseInitial, houseName } from '../i18n/pages/terms';

    let spokenPortal: ReturnType<typeof initSonnetSpokenPortal> | null = null;

    void initPage(['home', 'card-terms'], () => {
      document.querySelectorAll<HTMLElement>('[data-house]').forEach((el) => {
        el.textContent = houseName(el.dataset.house!);
      });
      document.querySelectorAll<HTMLElement>('[data-house-initial]').forEach((el) => {
        el.textContent = houseInitial(el.dataset.houseInitial!, locale());
      });
      if (!spokenPortal) {
        spokenPortal = initSonnetSpokenPortal();
      } else {
        spokenPortal.refreshLocale();
      }
    });

    document.addEventListener('click', () => {
      if (!isInitialized()) initAudio();
      playMusic('landing-ambient', 2000);
    }, { once: true });
  </script>
</BaseLayout>
