const cmuNotice = pronEn.split('\n').filter((l) => l.startsWith('#')).map((l) => l.replace(/^# ?/, '')).join('\n');

const linkCls = 'text-accent hover:text-accent-light transition-colors underline';
---

<Layout title="Credits and Licenses" description="The models, data, fonts, libraries, art and music in Sonnet Man, where each comes from, and its license.">
  <!-- English in every interface language, like the privacy policy and the terms: laid out left to right on
       an Arabic page too (tests/english-pages-rtl.spec.ts). -->
  <section class="pt-32 pb-20 px-6" lang="en" dir="ltr">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-4xl font-display font-bold text-white mb-4">Credits and Licenses</h1>
      <p class="text-brand-gray text-sm mb-12">Last updated: November 19, 2026</p>

      <div class="space-y-10 text-brand-slate text-[15px] leading-relaxed">
        <div>
          <p>
            Sonnet Man is made by Voyage Tracable, LLC (DBA Inspired Mile). It is built on the work of many people and
            projects. This page names each one the game ships or downloads, with where it comes from, its license, what we
            changed, and what its license asks of us. What could not be traced is said plainly at the end of the page.
          </p>
        </div>

        <div>
          <h2 class="text-xl font-display font-semibold text-white mb-3">Artificial intelligence in the game</h2>
          <p>
            A solo duel's opponent and judge can be a language model running in your browser. Before every first duel the
            battle page says which applies: artificial intelligence on your device, or a program that plays verses prepared
            in advance with the judging done by fixed rules. Online duels use no model: the server scores both verses by
            fixed rules. The models below are downloaded by your browser from Hugging Face when you ask for them, and run there:
            nothing you write or say in a solo duel leaves your device.
          </p>
        </div>

        <div>
          <h2 class="text-xl font-display font-semibold text-white mb-3">Models</h2>
          <div class="space-y-6">
            {MODELS.map((e) => <EntryBlock e={e} />)}
          </div>
        </div>

        <div>
          <h2 class="text-xl font-display font-semibold text-white mb-3">Language data</h2>
          <p class="mb-4">
            How a verse is read, in sixteen languages, comes from these sources. Several are under CC BY-SA 4.0: the tables the
            game made from Wiktionary, CC-CEDICT, JMdict and JMnedict are adaptations of them and are licensed under
            <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer" class={linkCls}>CC BY-SA 4.0</a> too.
            What they hold that was taken from those works stays the copyright of those works' authors; we claim no copyright over it.
          </p>
          <div class="space-y-6">
            {DATA.map((e) => <EntryBlock e={e} />)}
          </div>
        </div>

        <div>
          <h2 class="text-xl font-display font-semibold text-white mb-3">Fonts</h2>
          <p class="mb-3">
            Five families, as Google Fonts serves them (their Latin and Latin Extended parts, unchanged), under the
            <a href="https://openfontlicense.org/" target="_blank" rel="noopener noreferrer" class={linkCls}>SIL Open Font License 1.1</a>.
            The license, with each family's copyright line, is served beside the fonts:
            <a href="/fonts/OFL.txt" class={linkCls}>/fonts/OFL.txt</a>. The fonts may not be sold by themselves, and a changed
            version may not use a Reserved Font Name.
          </p>
          <ul class="list-disc list-inside space-y-1 ml-2">
            {FONTS.map((f) => <li><strong class="text-white">{f.name}</strong>, by {f.by}: <a href={f.href} target="_blank" rel="noopener noreferrer" class={linkCls}>{f.href.replace('https://', '')}</a></li>)}
          </ul>
        </div>

        <div>
          <h2 class="text-xl font-display font-semibold text-white mb-3">Software in your browser</h2>
          <div class="space-y-6">
            {LIBRARIES.map((e) => <EntryBlock e={e} />)}
          </div>
          <p class="mt-4">
            The game's server is not distributed, so the libraries it is built from are not listed here.
          </p>
        </div>

        <div>
          <h2 class="text-xl font-display font-semibold text-white mb-3">Art</h2>
          <div class="space-y-6">
            {ART.map((e) => <EntryBlock e={e} />)}
          </div>
          <p class="mt-4">The site's icons (the "IM" monogram) were made for Inspired Mile.</p>
        </div>

        <div>
          <h2 class="text-xl font-display font-semibold text-white mb-3">Music and sound</h2>
          <div class="space-y-6">
            {AUDIO.map((e) => <EntryBlock e={e} />)}
          </div>
        </div>

        <div>
          <h2 class="text-xl font-display font-semibold text-white mb-3">3D and film</h2>
          <p>
            The Sonnet Man's 3D figure in the viewer (a Gaussian splat and a point cloud of 16,384 points) was made on
            February 15, 2026 with Inspired Mile's own tools, which also reduced it for the web; which model made it is not yet
            recorded. The game ships no film or video.
          </p>
        </div>

        <div>
          <h2 class="text-xl font-display font-semibold text-white mb-3">Not yet traced</h2>
          <p>
            Two of the background tracks (on the playground and in the collection), the game's fourteen sound effects, and
            the model that made the 3D figure are not yet traced to their source. Each will be credited here, or replaced,
            once its source is confirmed.
          </p>
        </div>

        <div>
          <h2 id="notice-cmu" class="text-xl font-display font-semibold text-white mb-3">Notices: the CMU Pronouncing Dictionary and SCOWL</h2>
          <p class="mb-3">
            As the English pronunciation table carries them. SCOWL's is its whole Copyright file, with the notices of the
            works it names; it is also served alone at <a href="/licenses/SCOWL-Copyright.txt" class={linkCls}>/licenses/SCOWL-Copyright.txt</a>.
          </p>
          <pre class="whitespace-pre-wrap text-xs bg-obsidian-900/60 border border-obsidian-800 rounded-sm p-4 text-obsidian-300">{cmuNotice}</pre>
        </div>

        <div>
          <h2 id="notices" class="text-xl font-display font-semibold text-white mb-3">Third-party notices</h2>
          <p>
            The license texts and notices of every package and work above that asks for them, as they go with the copies this
            site sends to your browser, are in one file, written from the build itself:
            <a id="third-party-notices" href={NOTICES_FILE} class={linkCls}>{NOTICES_FILE}</a>. The notices of the code compiled
            into ONNX Runtime are served beside it:
            <a href="/licenses/onnxruntime-1.31-ThirdPartyNotices.txt" class={linkCls}>ONNX Runtime 1.31</a> and
            <a href="/licenses/onnxruntime-1.22-ThirdPartyNotices.txt" class={linkCls}>ONNX Runtime 1.22</a>. Nothing in our
            <a href="/terms" class={linkCls}>Terms of Service</a> restricts what these licenses allow you to do with these works.
          </p>
        </div>

        <div>
          <h2 class="text-xl font-display font-semibold text-white mb-3">Notice: mecab-ipadic</h2>
          <p>
            The full notice of the Nara Institute of Science and Technology, with the conditions of ICOT Free Software that
            apply to the dictionary, is served beside the game at
            <a href="/licenses/mecab-ipadic-NOTICE.txt" class={linkCls}>/licenses/mecab-ipadic-NOTICE.txt</a>.
          </p>
        </div>

        <div>
          <h2 class="text-xl font-display font-semibold text-white mb-3">Contact</h2>
          <p>
            If your work is in the game and is not credited as you wish, write to
            <a href="mailto:contact@voyagetracable.com" class={linkCls}>contact@voyagetracable.com</a>.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
