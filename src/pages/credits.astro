    source: [{ text: 'opengameart.org/content/battle-theme-a', href: 'https://opengameart.org/content/battle-theme-a' }, { text: 'cynicmusic.com', href: 'https://cynicmusic.com/' }, { text: 'pixelsphere.org', href: 'https://pixelsphere.org/' }],
