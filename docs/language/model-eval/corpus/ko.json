  {
   "id": "ko-10",
   "poet": "윤동주",
   "poem": "쉽게 씌어진 시",
   "died": 1945,
   "text": "창밖에 밤비가 속살거려\n육첩방(六疊房)은 남의 나라",
   "firstLineOnPage": "창밖에 밤비가 속살거려",
   "source": {
    "site": "ko.wikisource.org",
    "page": "쉽게 씌어진 시",
    "url": "https://ko.wikisource.org/wiki/%EC%89%BD%EA%B2%8C_%EC%94%8C%EC%96%B4%EC%A7%84_%EC%8B%9C",
    "permalink": "https://ko.wikisource.org/w/index.php?oldid=203001",
    "revid": 203001,
    "fetched": "2026-11-16"
   }
  },
  {
   "id": "ko-11",
   "poet": "윤동주",
   "poem": "참회록",
   "died": 1945,
   "text": "파란 녹이 낀 구리거울 속에\n내 얼골이 남어있는것은",
   "firstLineOnPage": "파란 녹이 낀 구리거울 속에",
   "source": {
    "site": "ko.wikisource.org",
    "page": "하늘과 바람과 별과 시 (1948년)/참회록",
