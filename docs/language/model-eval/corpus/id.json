  {
   "id": "id-12",
   "poet": "Chairil Anwar",
   "poem": "Aku",
   "died": 1949,
   "text": "Melangkahkan aku bukan tuak menggelegak\nCumbu-buatan satu biduan\nKujauhi ahli agama serta lembing katanya",
   "firstLineOnPage": "Melangkahkan aku bukan tuak menggelegak",
   "source": {
    "site": "id.wikisource.org",
