  {
   "id": "id-01",
   "poet": "Raja Ali Haji",
   "poem": "Gurindam Dua Belas",
   "died": 1873,
   "text": "Barang siapa tiada memegang agama,\nsekali-kali tiada boleh dibilangkan nama.",
   "firstLineOnPage": "Barang siapa tiada memegang agama,",
   "source": {
    "site": "id.wikisource.org",
    "page": "Gurindam Dua Belas",
    "url": "https://id.wikisource.org/wiki/Gurindam_Dua_Belas",
    "permalink": "https://id.wikisource.org/w/index.php?oldid=268498",
    "revid": 268498,
    "fetched": "2026-11-16"
   }
  },
  {
   "id": "id-02",
   "poet": "Raja Ali Haji",
   "poem": "Gurindam Dua Belas",
   "died": 1873,
   "text": "Barang siapa mengenal yang empat,\nmaka ia itulah orang yang ma'rifat.",
   "firstLineOnPage": "Barang siapa mengenal yang empat,",
   "source": {
    "site": "id.wikisource.org",
    "page": "Gurindam Dua Belas",
    "url": "https://id.wikisource.org/wiki/Gurindam_Dua_Belas",
    "permalink": "https://id.wikisource.org/w/index.php?oldid=268498",
    "revid": 268498,
    "fetched": "2026-11-16"
   }
  },
  {
   "id": "id-03",
   "poet": "Raja Ali Haji",
   "poem": "Gurindam Dua Belas",
   "died": 1873,
   "text": "Barang siapa mengenal Allah,\nsuruh dan tegahnya tiada ia menyalah.",
   "firstLineOnPage": "Barang siapa mengenal Allah,",
   "source": {
    "site": "id.wikisource.org",
    "page": "Gurindam Dua Belas",
    "url": "https://id.wikisource.org/wiki/Gurindam_Dua_Belas",
    "permalink": "https://id.wikisource.org/w/index.php?oldid=268498",
    "revid": 268498,
    "fetched": "2026-11-16"
   }
  },
  {
   "id": "id-04",
   "poet": "Raja Ali Haji",
   "poem": "Gurindam Dua Belas",
   "died": 1873,
   "text": "Barang siapa mengenal diri,\nmaka telah mengenal akan Tuhan yang bahri.",
   "firstLineOnPage": "Barang siapa mengenal diri,",
   "source": {
    "site": "id.wikisource.org",
    "page": "Gurindam Dua Belas",
    "url": "https://id.wikisource.org/wiki/Gurindam_Dua_Belas",
    "permalink": "https://id.wikisource.org/w/index.php?oldid=268498",
    "revid": 268498,
    "fetched": "2026-11-16"
   }
  },
  {
   "id": "id-05",
   "poet": "Hamzah al-Fansuri",
   "poem": "Syair Perahu",
   "died": 1590,
   "text": "Wahai muda kenali dirimu,\nialah perahu tamsil tubuhmu,\ntiadalah berapa lama hidupmu,\nke akhirat jua kekal diammu.",
   "firstLineOnPage": "Wahai muda kenali dirimu,",
   "source": {
    "site": "id.wikisource.org",
    "page": "Syair Perahu",
    "url": "https://id.wikisource.org/wiki/Syair_Perahu",
    "permalink": "https://id.wikisource.org/w/index.php?oldid=252081",
    "revid": 252081,
    "fetched": "2026-11-16"
   }
  },
  {
   "id": "id-06",
   "poet": "Hamzah al-Fansuri",
   "poem": "Syair Perahu",
   "died": 1590,
   "text": "Hai muda arif-budiman,\nhasilkan kemudi dengan pedoman,\nalat perahumu jua kerjakan,\nitulah jalan membetuli insan.",
   "firstLineOnPage": "Hai muda arif-budiman,",
   "source": {
    "site": "id.wikisource.org",
    "page": "Syair Perahu",
    "url": "https://id.wikisource.org/wiki/Syair_Perahu",
    "permalink": "https://id.wikisource.org/w/index.php?oldid=252081",
    "revid": 252081,
    "fetched": "2026-11-16"
   }
  },
  {
   "id": "id-07",
   "poet": "Amir Hamzah",
   "poem": "Berdiri Aku",
   "died": 1946,
   "text": "Berdiri aku di senja senyap\nCamar melayang menepis buih\nMelayah bakau mengurai puncak\nBerjulang datang ubur terkembang",
   "firstLineOnPage": "Berdiri aku di senja senyap",
   "source": {
    "site": "id.wikisource.org",
    "page": "Berdiri Aku",
    "url": "https://id.wikisource.org/wiki/Berdiri_Aku",
    "permalink": "https://id.wikisource.org/w/index.php?oldid=149823",
    "revid": 149823,
    "fetched": "2026-11-16"
   }
  },
  {
   "id": "id-08",
   "poet": "Amir Hamzah",
   "poem": "Berdiri Aku",
   "died": 1946,
   "text": "Angin pulang menyejuk bumi\nMenepuk teluk mengempas emas\nLari ke gunung memuncak sunyi\nBerayun-ayun di atas alas.",
   "firstLineOnPage": "Angin pulang menyejuk bumi",
   "source": {
    "site": "id.wikisource.org",
    "page": "Berdiri Aku",
    "url": "https://id.wikisource.org/wiki/Berdiri_Aku",
    "permalink": "https://id.wikisource.org/w/index.php?oldid=149823",
    "revid": 149823,
    "fetched": "2026-11-16"
   }
  },
  {
   "id": "id-09",
   "poet": "Amir Hamzah",
   "poem": "Padamu Jua",
   "died": 1946,
   "text": "Habis kikis\nsegala cintaku hilang terbang\npulang kembali aku padamu",
   "firstLineOnPage": "Habis kikis",
   "source": {
    "site": "id.wikisource.org",
    "page": "Padamu Jua",
    "url": "https://id.wikisource.org/wiki/Padamu_Jua",
    "permalink": "https://id.wikisource.org/w/index.php?oldid=26439",
    "revid": 26439,
    "fetched": "2026-11-16"
   }
  },
  {
   "id": "id-10",
   "poet": "Amir Hamzah",
   "poem": "Hanyut Aku",
   "died": 1946,
   "text": "Hanyut aku, kekasihku!\nHanyut aku!\nulurkan tanganmu, tolong aku.",
   "firstLineOnPage": "Hanyut aku, kekasihku!",
   "source": {
    "site": "id.wikisource.org",
    "page": "Hanyut Aku",
    "url": "https://id.wikisource.org/wiki/Hanyut_Aku",
    "permalink": "https://id.wikisource.org/w/index.php?oldid=26440",
    "revid": 26440,
    "fetched": "2026-11-16"
   }
  },
  {
   "id": "id-11",
   "poet": "Chairil Anwar",
   "poem": "Derai-Derai Cemara",
   "died": 1949,
   "text": "cemara menderai sampai jauh\nterasa hari akan jadi malam\nada beberapa dahan di tingkap merapuh\ndipukul angin yang terpendam",
   "firstLineOnPage": "cemara menderai sampai jauh",
   "source": {
    "site": "id.wikisource.org",
    "page": "Derai-Derai Cemara",
