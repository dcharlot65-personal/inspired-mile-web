 "excerpts": [
  {
   "id": "id-01",
   "poet": "Raja Ali Haji",
   "poem": "Gurindam Dua Belas",
   "died": 1873,
   "text": "Barang siapa tiada memegang agama,\nsekali-kali tiada boleh dibilangkan nama.",
   "firstLineOnPage": "Barang siapa tiada memegang agama,",
   "source": {
    "site": "id.wikisource.org",
    "page": "Gurindam Dua Belas",
    "url": "https://id.wikisource.org/wiki/Gurindam_Dua_Belas",
    "permalink": "https://id.wikisource.org/w/index.php?oldid=268498",
    "revid": 268498,
    "fetched": "2026-11-18"
   }
  },
  {
   "id": "id-02",
   "poet": "Raja Ali Haji",
   "poem": "Gurindam Dua Belas",
   "died": 1873,
   "text": "Barang siapa mengenal yang empat,\nmaka ia itulah orang yang ma'rifat.",
   "firstLineOnPage": "Barang siapa mengenal yang empat,",
   "source": {
    "site": "id.wikisource.org",
    "page": "Gurindam Dua Belas",
    "url": "https://id.wikisource.org/wiki/Gurindam_Dua_Belas",
    "permalink": "https://id.wikisource.org/w/index.php?oldid=268498",
    "revid": 268498,
    "fetched": "2026-11-18"
   }
  },
  {
   "id": "id-03",
   "poet": "Raja Ali Haji",
   "poem": "Gurindam Dua Belas",
   "died": 1873,
   "text": "Barang siapa mengenal Allah,\nsuruh dan tegahnya tiada ia menyalah.",
   "firstLineOnPage": "Barang siapa mengenal Allah,",
   "source": {
    "site": "id.wikisource.org",
    "page": "Gurindam Dua Belas",
    "url": "https://id.wikisource.org/wiki/Gurindam_Dua_Belas",
    "permalink": "https://id.wikisource.org/w/index.php?oldid=268498",
    "revid": 268498,
    "fetched": "2026-11-18"
   }
  },
  {
   "id": "id-04",
   "poet": "Raja Ali Haji",
   "poem": "Gurindam Dua Belas",
   "died": 1873,
   "text": "Barang siapa mengenal diri,\nmaka telah mengenal akan Tuhan yang bahri.",
   "firstLineOnPage": "Barang siapa mengenal diri,",
   "source": {
    "site": "id.wikisource.org",
    "page": "Gurindam Dua Belas",
    "url": "https://id.wikisource.org/wiki/Gurindam_Dua_Belas",
    "permalink": "https://id.wikisource.org/w/index.php?oldid=268498",
    "revid": 268498,
    "fetched": "2026-11-18"
   }
  },
  {
   "id": "id-05",
   "poet": "Hamzah al-Fansuri",
   "poem": "Syair Perahu",
   "died": 1590,
   "text": "Wahai muda kenali dirimu,\nialah perahu tamsil tubuhmu,\ntiadalah berapa lama hidupmu,\nke akhirat jua kekal diammu.",
   "firstLineOnPage": "Wahai muda kenali dirimu,",
   "source": {
    "site": "id.wikisource.org",
    "page": "Syair Perahu",
    "url": "https://id.wikisource.org/wiki/Syair_Perahu",
    "permalink": "https://id.wikisource.org/w/index.php?oldid=252081",
    "revid": 252081,
    "fetched": "2026-11-18"
   }
  },
  {
   "id": "id-06",
   "poet": "Hamzah al-Fansuri",
   "poem": "Syair Perahu",
   "died": 1590,
   "text": "Hai muda arif-budiman,\nhasilkan kemudi dengan pedoman,\nalat perahumu jua kerjakan,\nitulah jalan membetuli insan.",
   "firstLineOnPage": "Hai muda arif-budiman,",
   "source": {
    "site": "id.wikisource.org",
    "page": "Syair Perahu",
    "url": "https://id.wikisource.org/wiki/Syair_Perahu",
    "permalink": "https://id.wikisource.org/w/index.php?oldid=252081",
    "revid": 252081,
    "fetched": "2026-11-18"
   }
  },
  {
   "id": "id-07",
   "poet": "Hamzah al-Fansuri",
   "poem": "Syair Perahu",
   "died": 1590,
   "text": "Muaranya dalam, ikanpun banyak,\ndi sanalah perahu karam dan rusak,\nkarangnya tajam seperti tombak\nke atas pasir kamu tersesak.",
   "firstLineOnPage": "Muaranya dalam, ikanpun banyak,",
   "source": {
    "site": "id.wikisource.org",
    "page": "Syair Perahu",
    "url": "https://id.wikisource.org/wiki/Syair_Perahu",
    "permalink": "https://id.wikisource.org/w/index.php?oldid=252081",
    "revid": 252081,
    "fetched": "2026-11-18"
   }
  },
  {
   "id": "id-08",
   "poet": "Hamzah al-Fansuri",
   "poem": "Syair Perahu",
   "died": 1590,
   "text": "Laut Silan terlalu dalam,\ndi sanalah perahu rusak dan karam,\nsungguhpun banyak di sana menyelam,\nlarang mendapat permata nilam.",
   "firstLineOnPage": "Laut Silan terlalu dalam,",
   "source": {
    "site": "id.wikisource.org",
    "page": "Syair Perahu",
    "url": "https://id.wikisource.org/wiki/Syair_Perahu",
    "permalink": "https://id.wikisource.org/w/index.php?oldid=252081",
    "revid": 252081,
    "fetched": "2026-11-18"
   }
  },
  {
   "id": "id-09",
   "poet": "Hamzah al-Fansuri",
   "poem": "Syair Burung Unggas",
   "died": 1590,
   "text": "Unggas itu bukannya nuri,\nBerbunyi ia syahdu kala hari,\nBermain tamasya pada segala negeri,\nDemikianlah murad insan sirri.",
   "firstLineOnPage": "Unggas itu bukannya nuri,",
   "source": {
    "site": "id.wikisource.org",
    "page": "Syair Burung Unggas",
    "url": "https://id.wikisource.org/wiki/Syair_Burung_Unggas",
    "permalink": "https://id.wikisource.org/w/index.php?oldid=252073",
    "revid": 252073,
    "fetched": "2026-11-18"
   }
  },
  {
   "id": "id-10",
   "poet": "Hamzah al-Fansuri",
   "poem": "Syair Burung Unggas",
   "died": 1590,
   "text": "Unggas itu bukannya balam,\nNantiasa berbunyi siang dan malam,\nTempatnya bermain pada segala alam,\nDisanalah tamasya melihat ragam.",
   "firstLineOnPage": "Unggas itu bukannya balam,",
   "source": {
    "site": "id.wikisource.org",
    "page": "Syair Burung Unggas",
    "url": "https://id.wikisource.org/wiki/Syair_Burung_Unggas",
    "permalink": "https://id.wikisource.org/w/index.php?oldid=252073",
    "revid": 252073,
    "fetched": "2026-11-18"
   }
  },
  {
   "id": "id-11",
   "poet": "Raja Ali Haji",
   "poem": "Gurindam Dua Belas",
   "died": 1873,
   "text": "Apabila terpelihara mata,\nsedikitlah cita-cita.",
   "firstLineOnPage": "Apabila terpelihara mata,",
   "source": {
    "site": "id.wikisource.org",
    "page": "Gurindam Dua Belas",
    "url": "https://id.wikisource.org/wiki/Gurindam_Dua_Belas",
    "permalink": "https://id.wikisource.org/w/index.php?oldid=268498",
    "revid": 268498,
    "fetched": "2026-11-18"
   }
  },
  {
   "id": "id-12",
   "poet": "Raja Ali Haji",
   "poem": "Gurindam Dua Belas",
   "died": 1873,
   "text": "Jika hendak mengenal orang berbangsa,\nlihat kepada budi dan bahasa.",
   "firstLineOnPage": "Jika hendak mengenal orang berbangsa,",
   "source": {
    "site": "id.wikisource.org",
    "page": "Gurindam Dua Belas",
