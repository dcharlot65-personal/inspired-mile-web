   }
  },
  {
   "id": "ar-02",
   "poet": "امرؤ القيس",
   "poem": "معلقة امرئ القيس",
   "died": 544,
   "text": "تَرَى بَعَرَ الأرْآمِ فِي عَرَصَاتِهَا\nوَقِيْعَانِهَا كَأنَّهُ حَبُّ فُلْفُلِ",
   "firstLineOnPage": "تَرَى بَعَرَ الأرْآمِ فِي عَرَصَاتِهَا",
   "source": {
    "site": "ar.wikisource.org",
