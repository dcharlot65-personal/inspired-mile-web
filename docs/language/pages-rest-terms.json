{
 "about": "The terms of the page areas (src/i18n/pages: classroom, marketplace, tournaments, season, viewer, shared, pwa), one word per thing per language, and where each word comes from. Checked by scripts/pages-rest/terms.mjs and src/i18n/pages-rest-terms.test.ts: each relation against the saved source answers in docs/language/sources, each area string whose English uses the term against the word, and each verdict of docs/language/pages-rest-meaning.json that names a source against this record. The tables of docs/language/pages-rest.md are drawn from this file (node scripts/pages-rest/terms.mjs --write).",
 "relations": {
  "same": "the source's word, apart from letter case, Arabic vowel marks, quotation marks and hyphens (where sourceForm is given, the source writes the word that way and the strings inflect it: the note says how)",
  "part": "a part of the source's word (the source's longer name, shortened)",
  "contains": "the source's word with more written beside it",
  "script": "the source's Traditional Chinese word written in Simplified characters, by the character map given",
  "other": "the source has a word, and the strings use another: the note says why. Not from the source.",
  "none": "the source has nothing in this language: the word is the model's, with no source"
 },
 "fields": {
  "word": "the word as the strings write it",
  "spellings": "other forms the strings write it in (inflections, or the stem they share); a string whose English uses the term must contain the word or one of these",
  "notIn": "strings that rightly word it otherwise, with the reason",
  "from": "for Wikidata: which of its words is meant, its label (the default) or the title of its Wikipedia article",
  "item": "for a term with two Wikidata items: the one this language's word comes from",
  "source": "for this language only, a source other than the term's"
 },
